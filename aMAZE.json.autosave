 column _PARAM3_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"VarObjet"},"parameters":["Object","__MazeGenerator_Row","=","GetArgumentAsNumber(\"RowNumber\")"]},{"type":{"value":"VarObjet"},"parameters":["Object","__MazeGenerator_Column","=","GetArgumentAsNumber(\"ColumnNumber\")"]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MazeGenerator::MazeObject","type":"behavior"},{"description":"Row Number","name":"RowNumber","type":"expression"},{"description":"Column Number","name":"ColumnNumber","type":"expression"}],"objectGroups":[]},{"description":"Check if maze object is a wall in a particular direction","fullName":"Check Wall Direction of Maze Object","functionType":"Condition","name":"CheckMazeObjectWallDirection","sentence":"Maze Object _PARAM0_ has is Wall in Direction _PARAM2_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"VarObjetTxt"},"parameters":["Object","__MazeGenerator_WallDirection","=","GetArgumentAsString(\"WallDirection\")"]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"MazeGenerator::MazeObject","type":"behavior"},{"description":"Wall Direction of Maze Object","name":"WallDirection","supplementaryInformation":"[\"LeftWall\",\"RightWall\",\"UpWall\",\"DownWall\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"Return the maze ID of the maze object as a string","fullName":"Maze ID of Maze Object","functionType":"StringExpression","name":"MazeObjectMazeID","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnString"},"parameters":["Object.Var