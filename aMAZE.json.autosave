ents":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["PendingLevelUps",">","0"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["PendingLevelUps","-","1"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]},{"description":"Store the meta level and apply its small bonuses (only if enabled). Call once when the player is created.","fullName":"Apply meta level","functionType":"Action","name":"ApplyMetaLevel","sentence":"Apply meta level _PARAM2_ to _PARAM0_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["MetaLevel","=","NewMetaLevel"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["MetaBonusesEnabled","True",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["MetaDamageBonus","=","MetaDamagePerLevel * min(NewMetaLevel, MetaBonusCap)"]},{"type":{"value":"Health::Health::SetMaxHealth"},"parameters":["Object","Health","Object.Health::MaxHealth() * (1 + MetaHPPerLevel * min(NewMetaLevel, MetaBonusCap))",""]},{"type":{"value":"Health::Health::SetCurrentHealth"},"parameters":["Object","Health","Object.Health::MaxHealth()",""]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"},{"description":"Meta level","name":"NewMetaLevel","type":"expression"}],"objectGroups":[]},{"description":"Reset run XP and level (meta level stays).","fullName":"Reset run","functionType":"Action","name":"ResetRun","sentence":"Reset run of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["RunXP","=","0"]},{"type":{"value":"SetNumberVariable"},"parameters":["RunLevel","=","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["PendingLevelUps","=","0"]},{"type":{"value":"SetBooleanVariable"},"parameters":["JustLeveledUp","False",""]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]},{"description":"True while there is a level up waiting for a perk choice.","fullName":"Has pending level up","functionType":"Condition","name":"HasPendingLevelUp","sentence":"_PARAM0_ has a pending level up","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["False"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["PendingLevelUps",">","0"]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]},{"description":"True for one frame when the run level increased.","fullName":"Just leveled up","functionType":"Condition","name":"JustLeveledUp","sentence":"_PARAM0_ just leveled up","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["False"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["JustLeveledUp","True",""]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]},{"description":"XP needed to reach the next run level.","fullName":"XP to next level","functionType":"Expression","name":"XPToNextLevel","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnNumber"},"parameters":["XPBase + XPGrowth * (RunLevel - 1)"]}]}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]},{"description":"Damage multiplier including the meta bonus. Multiply the player's damage by this.","fullName":"Total damage multiplier","functionType":"Expression","name":"TotalDamageMultiplier","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetReturnNumber"},"parameters":["DamageMultiplier * (1 + MetaDamageBonus)"]}]}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"Amaze::Player","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"doStepPostEvents"},{"functionName":"AddXP"},{"functionName":"ConsumeLevelUp"},{"functionName":"ApplyMetaLevel"},{"functionName":"ResetRun"},{"functionName":"HasPendingLevelUp"},{"functionName":"JustLeveledUp"},{"functionName":"XPToNextLevel"},{"functionName":"TotalDamageMultiplier"}]},"propertyDescriptors":[{"value":"300","type":"Number","label":"Move speed","group":"Stats","name":"MoveSpeed"},{"value":"1","type":"Number","label":"Damage multiplier (perks change this)","group":"Stats","name":"DamageMultiplier"},{"value":"150","type":"Number","label":"Pickup range (XP, drops)","group":"Stats","name":"PickupRange"},{"value":"0.5","type":"Number","label":"Invulnerability after a hit (seconds)","group":"Stats","name":"InvulnerabilityTime"},{"value":"5","type":"Number","label":"XP for level 2","group":"Run","name":"XPBase"},{"value":"5","type":"Number","label":"Additional XP per level","group":"Run","name":"XPGrowth"},{"value":"true","type":"Boolean","label":"Meta bonuses enabled (off in daily)","group":"Meta","name":"MetaBonusesEnabled"},{"value":"0.02","type":"Number","label":"Damage bonus per meta level","group":"Meta","name":"MetaDamagePerLevel"},{"value":"0.03","type":"Number","label":"Max health bonus per meta level","group":"Meta","name":"MetaHPPerLevel"},{"value":"10","type":"Number","label":"Highest meta level that still gives power","group":"Meta","name":"MetaBonusCap"},{"value":"","type":"Behavior","label":"Health","extraInformation":["Health::Health"],"choices":[],"name":"Health"},{"value":"0","type":"Number","label":"Run XP","hidden":true,"name":"RunXP"},{"value":"1","type":"Number","label":"Run level","hidden":true,"name":"RunLevel"},{"value":"0","type":"Number","label":"Pending level ups","hidden":true,"name":"PendingLevelUps"},{"value":"false","type":"Boolean","label":"Just leveled up (one frame)","hidden":true,"name":"JustLeveledUp"},{"value":"0","type":"Number","label":"Meta level","hidden":true,"name":"MetaLevel"},{"value":"0","type":"Number","label":"Meta damage bonus","hidden":true,"name":"MetaDamageBonus"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Stats","children":[{"propertyName":"MoveSpeed"},{"propertyName":"DamageMultiplier"},{"propertyName":"PickupRange"},{"propertyName":"InvulnerabilityTime"}]},{"folderName":"Run","children":[{"propertyName":"XPBase"},{"propertyName":"XPGrowth"}]},{"folderName":"Meta","children":[{"propertyName":"MetaBonusesEnabled"},{"propertyName":"MetaDamagePerLevel"},{"propertyName":"MetaHPPerLevel"},{"propertyName":"MetaBonusCap"}]},{"propertyName":"Health"},{"propertyName":"RunXP"},{"propertyName":"RunLevel"},{"propertyName":"PendingLevelUps"},{"propertyName":"JustLeveledUp"},{"propertyName":"MetaLevel"},{"propertyName":"MetaDamageBonus"}]}}],"eventsBasedObjects":[]},{"author":"avramovic","category":"Game mechanic","dimension":"3D","extensionNamespace":"","fullName":"WebXR VR","gdevelopVersion":"5.6.0","helpPath":"https://avram.itch.io/webxr-gdevelop-extension","iconUrl":"data:image/svg+xml;base64,","name":"WebXR","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/Glyphster Pack/Master/SVG/Virtual Reality/6d3ce9eab85cd4384648aaff5584305e3b5d6090bc840ddde8207c9be54c0621_Virtual Reality_vr_glasses_goggles_headset.svg","shortDescription":"WebXR VR core: session management, controllers, grab/climb/interact/holster/selectable/targetable. Archery, doors, and teleport are in separate extensions.","version":"0.29.1","description":["Complete WebXR VR framework for building immersive VR games.","- Track VR headset position and controller input in real-time","- Build interactive grabbable, climbable, selectable, and holster objects","- Detect laser-pointer aim on any 3D object with VrTargetable (no grabbable required)","- Customize world scale and spatial anchoring","- Archery, doors, and teleport are available as separate extensions (webxr_archery, webxr_doors, webxr_teleport)"],"tags":["webxr","vr","3d"],"authorIds":["1mr0GDQIt2dmrfi5P2OIqu6lIyA2"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Run once when the first scene loads. Installs the XR game-loop hook and probes immersive-vr support.","fullName":"WebXR VR — on first scene loaded","functionType":"Action","name":"onFirstSceneLoaded","sentence":"Initialize WebXR VR (detect headset support and setup game loop)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["if (typeof gdjs !== 'undefined' && gdjs._WebXRVR_InitDone) {","    return;","}","gdjs._WebXRVR_InitDone = true;","gdjs._WebXRVRSupported = false;","gdjs._WebXRVR_WasPresenting = false;","gdjs._webxrVrXrBaseSpace = null;","gdjs._webxrVrWorldScale = 100;","gdjs._webxrVrFrame = null;","// Monotonic per-loop frame counter. XRFrame objects may be reused by some browsers (e.g. Quest Browser),","// so per-frame caches must key on this counter, never on XRFrame identity.","gdjs._webxrVrFrameSeq = 0;","gdjs._webxrVrAnchor = null;","gdjs._webxrVrFrustumCullEnabled  = true;","gdjs._webxrVrCullRadiusScale     = 2.0;","gdjs._webxrVrCullMarginMeters    = 1.0;","gdjs._webxrVrCullNearKeepMeters  = 5.0;","gdjs._webxrVrCullSphere          = null;","gdjs._webxrVrHeadWorld           = null;","gdjs._webxrVrMirrorEnabled = true;","gdjs._webxrVrMirrorFovDeg = 75;","gdjs._webxrVrMirrorCam = null;","gdjs._webxrVrMirrorPos = null;","gdjs._webxrVrMirrorQuat = null;","gdjs._webxrVrMirrorAspect = 0;","","gdjs._webxrVrDbg = function () {","    if (typeof window !== 'undefined' && window.__WEBXR_VR_DEBUG__ === false) {","        return;","    }","    var a = ['[WebXR_VR]'].concat(Array.prototype.slice.call(arguments));","    console.log.apply(console, a);","};","","// Renders a mono 'desktop mirror' view of the base layer into the page canvas","// while a VR session is presenting. WebXR provides no automatic mirror: the","// stereo render goes straight to the XR compositor, so without this the","// desktop canvas simply keeps whatever was on it before the session started","// (this is invisible on-headset and in emulators that composite the XR","// framebuffer back into the page, but shows as a black canvas on a PC monitor","// driving a real tethered headset).","gdjs._webxrVrRenderDesktopMirror = function (runtimeScene) {","    if (!gdjs._webxrVrMirrorEnabled) {","        return;","    }","    var renderer = runtimeScene.getGame().getRenderer().getThreeRenderer();","    if (!renderer || !renderer.xr || !renderer.xr.isPresenting) {","        return;","    }","    var vrRig = gdjs._webxrVrRig;","    if (!vrRig) {","        return;","    }","    var lr3d = runtimeScene.getLayer('').getRenderer();","    var threeScene = lr3d._threeScene || lr3d.threeScene || (lr3d.getThreeScene ? lr3d.getThreeScene() : null);","    if (!threeScene) {","        return;","    }","    // Force a full rig matrix update unconditionally, exactly like the","    // validated reference implementation, rather than relying on the","    // VrHeadAnchor frame-token cache (gdjs._webxrVrEnsureRigCurrent) being","    // already warm by the time this runs.","    vrRig.updateWorldMatrix(true, true);","    var xrCam = renderer.xr.getCamera();","    if (!xrCam) {","        return;","    }","    xrCam.updateWorldMatrix(true, false);","","    // Fixed 16:9 / 0.1-1000000 projection, matching the validated reference","    // implementation exactly: recomputing aspect/near/far from live layer state","    // here caused an intermittent black-sky flicker (see changelog). Only FOV","    // is adjustable, and only its own single field is ever touched.","    if (!gdjs._webxrVrMirrorCam) {","        var _initFov = gdjs._webxrVrMirrorFovDeg > 0 ? gdjs._webxrVrMirrorFovDeg : 75;","        gdjs._webxrVrMirrorCam = new THREE.PerspectiveCamera(_initFov, 1280 / 720, 0.1, 1000000);","        gdjs._webxrVrMirrorPos = new THREE.Vector3();","        gdjs._webxrVrMirrorQuat = new THREE.Quaternion();","    }","    var mirrorCam = gdjs._webxrVrMirrorCam;","    var fovDeg = gdjs._webxrVrMirrorFovDeg > 0 ? gdjs._webxrVrMirrorFovDeg : 75;","    if (mirrorCam.fov !== fovDeg) {","        mirrorCam.fov = fovDeg;","        mirrorCam.updateProjectionMatrix();","    }","","    xrCam.getWorldPosition(gdjs._webxrVrMirrorPos);","    xrCam.getWorldQuaternion(gdjs._webxrVrMirrorQuat);","    mirrorCam.position.copy(gdjs._webxrVrMirrorPos);","    mirrorCam.quaternion.copy(gdjs._webxrVrMirrorQuat);","    mirrorCam.up.set(0, -1, 0);","    mirrorCam.updateMatrixWorld(true);","","    var prevTarget = renderer.getRenderTarget();","    var prevAutoClear = renderer.autoClear;","    try {","        renderer.xr.enabled = false;","        renderer.setRenderTarget(null);","        renderer.autoClear = false;","        // Depth only, matching the reference implementation; the scene always","        // covers the full viewport so the colour buffer never needs clearing.","        renderer.clearDepth();","        renderer.render(threeScene, mirrorCam);","    } catch (e) {","        if (typeof gdjs._webxrVrDbg === 'function') {","            gdjs._webxrVrDbg('desktop mirror render failed, disabling', e);","        }","        gdjs._webxrVrMirrorEnabled = false;","    } finally {","        renderer.autoClear = prevAutoClear;","        renderer.setRenderTarget(prevTarget);","        renderer.xr.enabled = true;","    }","};","","if (navigator.xr && navigator.xr.isSessionSupported) {","    navigator.xr.isSessionSupported('immersive-vr').then(function (ok) {","        gdjs._WebXRVRSupported = !!ok;","        if (typeof gdjs._webxrVrDbg === 'function') {","            gdjs._webxrVrDbg('isSessionSupported(immersive-vr) ->', ok);","        }","    }).catch(function (err) {","        gdjs._WebXRVRSupported = false;","        if (typeof gdjs._webxrVrDbg === 'function') {","            gdjs._webxrVrDbg('isSessionSupported rejected', err);","        }","    });","} else {","    gdjs._WebXRVRSupported = false;","    if (typeof gdjs._webxrVrDbg === 'function') {","        gdjs._webxrVrDbg('navigator.xr missing');","    }","}","","var renderer = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (renderer) {","    renderer.xr.enabled = true;","}","","gdjs._webxrVrControllers = { left: { grip: null, ray: null, connected: false }, right: { grip: null, ray: null, connected: false } };","","// === Shared per-hand controller ray (0.29.0 performance fix) ===","// Replaces the old per-consumer whole-scene Three.js raycasts (previously one","// in VrController's laser, one per VrGrabbable object for magnetic grab, and","// one per VrSelectable object for ray selection - all re-testing the same","// geometry against real render triangles every frame, with no acceleration","// structure) with a single ray computed once per hand per frame. Physics3D","// bodies are tested first through Jolt's broadphase (cost independent of","// visual triangle count); anything without a body falls back to a Three.js","// triangle test, matching pre-0.29 behavior. A VrRayHitMode behavior on an","// object always overrides this default (Triangle/Box/Ignore win over the","// physics shape too, or use \"Physics\" to opt back into the default).","gdjs._webxrHandRayCache = { left: [], right: [] };","gdjs._webxrHandRayCacheToken = { left: null, right: null };","gdjs._webxrRayHitModeRegistry = gdjs._webxrRayHitModeRegistry || new Map();","","gdjs._webxrGetThreeSceneForRay = function (runtimeScene) {","    try {","        var lr = runtimeScene.getLayer('');","        var lr3d = lr.getRenderer ? lr.getRenderer() : null;","        if (lr3d) return lr3d._threeScene || lr3d.threeScene || (lr3d.getThreeScene ? lr3d.getThreeScene() : null);","    } catch (e) {}","    return null;","};","","// Walks up from a raycast-hit Three.js node to the nearest ancestor tagged by","// GDevelop's own 3D renderer with a back-reference to its owning object, so a","// hit deep inside a GLB's node hierarchy resolves to the owning object without","// a per-frame subtree traversal.","gdjs._webxrOwnerFromThreeNode = function (node) {","    var cur = node;","    while (cur) {","        if (cur.gdjsRuntimeObject) return cur.gdjsRuntimeObject;","        cur = cur.parent;","    }","    return null;","};","","gdjs._webxrIsHeldBySameHand = function (owner, hand) {","    var reg = gdjs._webxrVrGrabbableRegistry;","    if (!reg || !owner) return false;","    for (var i = 0; i < reg.length; i++) {","        if (reg[i].obj === owner) {","            var hb = reg[i].beh;","            return !!(hb && hb._grabbingHand === hand && (hb._state === 'grabbed' || hb._state === 'flyingToCtrl'));","        }","    }","    return false;","};","","gdjs._webxrShouldSkipOwner = function (owner, hand) {","    if (!owner) return true;","    var ctl = gdjs._webxrVrControllers;","    if (ctl && ((ctl.left && ctl.left.gdObject === owner) || (ctl.right && ctl.right.gdObject === owner))) return true;","    if (owner === gdjs._webxrVrAnchorObject) return true;","    if (gdjs._webxrIsHeldBySameHand(owner, hand)) return true;","    return false;","};","","// Returns the VrRayHitMode override for owner's controller-ray hits, or null","// when there is none (no behavior, the behavior is deactivated, or it is set","// to \"Physics\": the default handling, i.e. the physics shape if a Physics3D","// body exists, otherwise exact render triangles). When not null, this always","// wins over the physics shape, so it can force exact/box/pass-through hits on","// an object that has a body, not just on objects without one.","gdjs._webxrGetRayHitMode = function (owner) {","    if (!owner) return null;","    var beh = gdjs._webxrRayHitModeRegistry.get(owner);","    if (!beh || !beh.activated()) return null;","    var mode = beh._getHitMode ? String(beh._getHitMode()) : 'Box';","    if (mode === 'Physics') return null;","    if (mode !== 'Triangle' && mode !== 'Ignore') return 'Box';","    return mode;","};","","// Local-space box test used for VrRayHitMode \"Box\": the same shape check","// Three's own Mesh.raycast performs before it walks triangles, without the","// triangle loop itself.","gdjs._webxrBoxRaycastScratch = { inv: new THREE.Matrix4(), ray: new THREE.Ray(), local: new THREE.Vector3(), world: new THREE.Vector3() };","gdjs._webxrBoxRaycast = function (mesh, raycaster) {","    var geom = mesh.geometry;","    if (!geom) return null;","    if (!geom.boundingBox) geom.computeBoundingBox();","    var s = gdjs._webxrBoxRaycastScratch;","    s.inv.copy(mesh.matrixWorld).invert();","    s.ray.copy(raycaster.ray).applyMatrix4(s.inv);","    if (!s.ray.intersectBox(geom.boundingBox, s.local)) return null;","    s.world.copy(s.local).applyMatrix4(mesh.matrixWorld);","    var distance = raycaster.ray.origin.distanceTo(s.world);","    if (distance < raycaster.near || distance > raycaster.far) return null;","    return { distance: distance, point: s.world.clone() };","};","","// Installs a self-adjusting raycast on every mesh of owner's render root, the","// first time a controller ray ever hits it. From then on the mesh skips its","// own triangle test whenever VrRayHitMode overrides it (Box/Ignore/Triangle,","// see _webxrGetRayHitMode), or whenever Physics3D is active on the object with","// no override (the physics ray pass already covers it, cheaply, regardless of","// polycount), instead of paying that cost every frame the beam happens to be","// aimed at it. Re-checks the live VrRayHitMode/Physics3D state on every call,","// so it stays correct if either changes at runtime.","gdjs._webxrInstallSmartRaycast = function (owner) {","    var root = owner.get3DRendererObject ? owner.get3DRendererObject() : null;","    if (!root || root.userData._webxrSmartRaycastDone) return;","    root.userData._webxrSmartRaycastDone = true;","    root.traverse(function (child) {","        if (!child.isMesh || child.userData.vrController || !child.raycast) return;","        var originalRaycast = child.raycast;","        child.raycast = function (raycaster, intersects) {","            var mode = gdjs._webxrGetRayHitMode(owner);","            if (mode === 'Ignore') return;","            if (mode === 'Box') {","                var boxHit = gdjs._webxrBoxRaycast(child, raycaster);","                if (boxHit) intersects.push({ distance: boxHit.distance, point: boxHit.point, object: child });","                return;","            }","            if (mode === 'Triangle') { originalRaycast.call(child, raycaster, intersects); return; }","            var phys = null;","            try { phys = owner.getBehavior('Physics3D'); } catch (e) {}","            if (gdjs._webxrPhysicsRayOk && phys && phys._body) return;","            originalRaycast.call(child, raycaster, intersects);","        };","    });","};","","// Reusable Jolt ray-cast scratch objects: rebuilt only when the scene's","// physics3DSharedData instance changes (e.g. after a scene reload).","gdjs._webxrJoltRay = null;","gdjs._webxrEnsureJoltRay = function (sharedData) {","    var jr = gdjs._webxrJoltRay;","    if (jr && jr.sharedData === sharedData) return jr;","    var settings = new Jolt.RayCastSettings();","    settings.mTreatConvexAsSolid = false;","    var origin = new Jolt.RVec3(0, 0, 0);","    var direction = new Jolt.Vec3(0, 0, 0);","    jr = {","        sharedData: sharedData,","        origin: origin,","        direction: direction,","        ray: new Jolt.RRayCast(origin, direction),","        settings: settings,","        collector: new Jolt.CastRayAllHitCollisionCollector(),","        bpFilter: new Jolt.BroadPhaseLayerFilter(),","        olFilter: new Jolt.ObjectLayerFilter(),","        bodyFilter: new Jolt.BodyFilter(),","        shapeFilter: new Jolt.ShapeFilter()","    };","    gdjs._webxrJoltRay = jr;","    return jr;","};","","// Casts the physics half of the shared ray. Returns hits sorted by distance:","// {distance, point (THREE.Vector3, world space), gdObject, threeObject, source}.","gdjs._webxrCastPhysicsRay = function (runtimeScene, hand, originThree, dirThree, length) {","    gdjs._webxrPhysicsRayOk = false;","    var sharedData = runtimeScene.physics3DSharedData;","    if (!sharedData || !(length > 0)) return [];","    var inv = sharedData.worldInvScale;","    var jr = gdjs._webxrEnsureJoltRay(sharedData);","    jr.origin.Set(originThree.x * inv, -originThree.y * inv, originThree.z * inv);","    jr.direction.Set(dirThree.x * length * inv, -dirThree.y * length * inv, dirThree.z * length * inv);","    jr.ray.mOrigin = jr.origin;","    jr.ray.mDirection = jr.direction;","    jr.collector.Reset();","    sharedData.physicsSystem.GetNarrowPhaseQuery().CastRay(jr.ray, jr.settings, jr.collector, jr.bpFilter, jr.olFilter, jr.bodyFilter, jr.shapeFilter);","    gdjs._webxrPhysicsRayOk = true;","    if (!jr.collector.HadHit()) return [];","    jr.collector.Sort();","    var hits = jr.collector.mHits;","    var count = hits.size();","    var out = [];","    var lockIface = sharedData.physicsSystem.GetBodyLockInterfaceNoLock();","    var scale = sharedData.worldScale;","    for (var i = 0; i < count; i++) {","        var r = hits.at(i);","        var body = lockIface.TryGetBody(r.mBodyID);","        if (!body || body.IsSensor()) { if (r.destroy) r.destroy(); continue; }","        var behAssoc = body.gdjsAssociatedBehavior;","        var owner = behAssoc ? behAssoc.owner : null;","        if (gdjs._webxrShouldSkipOwner(owner, hand)) { if (r.destroy) r.destroy(); continue; }","        if (gdjs._webxrGetRayHitMode(owner) !== null) { if (r.destroy) r.destroy(); continue; }","        var fraction = r.mFraction;","        var p = jr.ray.GetPointOnRay(fraction);","        var worldPoint = new THREE.Vector3(p.GetX() * scale, -p.GetY() * scale, p.GetZ() * scale);","        if (p.destroy) p.destroy();","        if (r.destroy) r.destroy();","        out.push({ distance: fraction * length, point: worldPoint, gdObject: owner, threeObject: null, source: 'physics' });","    }","    return out;","};","","// Casts the non-physics half of the shared ray: a single reused Raycaster","// against the render scene. Any mesh whose owner has a VrRayHitMode override,","// or has an active Physics3D body with no override, gets its own .raycast","// replaced by _webxrInstallSmartRaycast the first time it is hit, so every","// frame after that first exposure this pass costs nothing extra for that","// object.","gdjs._webxrSharedRaycaster = new THREE.Raycaster();","gdjs._webxrSharedHitsBuffer = [];","gdjs._webxrCastTriangleRay = function (runtimeScene, hand, sceneRef, originThree, dirThree, length, clipDistance) {","    if (!sceneRef) return [];","    var rc = gdjs._webxrSharedRaycaster;","    rc.set(originThree, dirThree);","    rc.near = 0;","    rc.far = (clipDistance > 0 && clipDistance < length) ? clipDistance : length;","    gdjs._webxrSharedHitsBuffer.length = 0;","    var hits = rc.intersectObject(sceneRef, true, gdjs._webxrSharedHitsBuffer);","    var out = [];","    for (var i = 0; i < hits.length; i++) {","        var h = hits[i];","        var node = h.object;","        if (node.userData && node.userData.vrController) continue;","        var owner = gdjs._webxrOwnerFromThreeNode(node);","        if (gdjs._webxrShouldSkipOwner(owner, hand)) continue;","        var mode = gdjs._webxrGetRayHitMode(owner);","        if (mode !== null) {","            gdjs._webxrInstallSmartRaycast(owner);","            if (mode === 'Ignore') continue;","            if (mode === 'Box') {","                var boxHit = gdjs._webxrBoxRaycast(node, rc);","                if (!boxHit) continue;","                out.push({ distance: boxHit.distance, point: boxHit.point, gdObject: owner, threeObject: node, source: 'box' });","                continue;","            }","            out.push({ distance: h.distance, point: h.point.clone(), gdObject: owner, threeObject: node, source: 'triangle' });","            continue;","        }","        var phys = null;","        try { phys = owner ? owner.getBehavior('Physics3D') : null; } catch (e) {}","        if (gdjs._webxrPhysicsRayOk && phys && phys._body) {","            gdjs._webxrInstallSmartRaycast(owner);","            continue;","        }","        out.push({ distance: h.distance, point: h.point.clone(), gdObject: owner, threeObject: node, source: 'triangle' });","    }","    return out;","};","","// Main entry point: one shared ray per hand, cached per XR frame so","// VrController's laser and VrGrabbable/VrSelectable/VrTargetable's checks all","// read the same result instead of each casting their own.","gdjs._webxrHandRayOrigin = new THREE.Vector3();","gdjs._webxrHandRayQuat = new THREE.Quaternion();","gdjs._webxrHandRayDir = new THREE.Vector3();","gdjs._webxrHandRayHits = function (runtimeScene, hand) {","    var token = gdjs._webxrVrFrameSeq || runtimeScene.getTimeManager().getTimeFromStart();","    if (gdjs._webxrHandRayCacheToken[hand] === token) {","        return gdjs._webxrHandRayCache[hand];","    }","    gdjs._webxrHandRayCacheToken[hand] = token;","    var result = [];","    var controllers = gdjs._webxrVrControllers;","    var entry = controllers ? controllers[hand] : null;","    if (!entry || !entry.connected || !entry.grip) {","        gdjs._webxrHandRayCache[hand] = result;","        return result;","    }","    if (gdjs._webxrVrEnsureRigCurrent) gdjs._webxrVrEnsureRigCurrent();","    var raySrc = entry.ray || entry.grip;","    raySrc.getWorldPosition(gdjs._webxrHandRayOrigin);","    raySrc.getWorldQuaternion(gdjs._webxrHandRayQuat);","    var pitchDeg = Number(entry._laserPitchOffset) || 0;","    if (pitchDeg !== 0) {","        gdjs._webxrHandRayQuat.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), pitchDeg * Math.PI / 180));","    }","    gdjs._webxrHandRayDir.set(0, 0, -1).applyQuaternion(gdjs._webxrHandRayQuat).normalize();","","    var targetingLen = (entry._targetingRayLength > 0) ? entry._targetingRayLength : 5000;","    var magneticLen = (entry._magneticGrabActive && entry._magneticGrabLength > 0) ? entry._magneticGrabLength : 0;","    var length = Math.max(targetingLen, magneticLen, 1);","","    var physicsHits = [];","    try {","        physicsHits = gdjs._webxrCastPhysicsRay(runtimeScene, hand, gdjs._webxrHandRayOrigin, gdjs._webxrHandRayDir, length);","    } catch (e) {","        gdjs._webxrPhysicsRayOk = false;","        if (!gdjs._webxrPhysicsRayWarned) { gdjs._webxrPhysicsRayWarned = true; console.warn('[WebXR] Physics ray failed, falling back to render triangles:', e); }","    }","    var nearestPhysicsDistance = physicsHits.length > 0 ? physicsHits[0].distance : -1;","    var sceneRef = gdjs._webxrGetThreeSceneForRay(runtimeScene);","    var triHits = [];","    try {","        triHits = gdjs._webxrCastTriangleRay(runtimeScene, hand, sceneRef, gdjs._webxrHandRayOrigin, gdjs._webxrHandRayDir, length, nearestPhysicsDistance);","    } catch (e) {","        if (!gdjs._webxrTriRayWarned) { gdjs._webxrTriRayWarned = true; console.warn('[WebXR] Triangle ray failed:', e); }","    }","","    result = physicsHits.concat(triHits);","    result.sort(function (a, b) { return a.distance - b.distance; });","    if (gdjs._webxrDebugHandRay) {","        var _dbgNow = performance.now();","        gdjs._webxrDebugHandRayLast = gdjs._webxrDebugHandRayLast || { left: 0, right: 0 };","        if (_dbgNow - gdjs._webxrDebugHandRayLast[hand] > 1000) {","            gdjs._webxrDebugHandRayLast[hand] = _dbgNow;","            console.log('[WebXR hand ray]', { hand: hand, frameSeq: token, physicsRayOk: gdjs._webxrPhysicsRayOk, physicsHits: physicsHits.length, triangleHits: triHits.length, first: result.length > 0 && result[0].gdObject && result[0].gdObject.getName ? result[0].gdObject.getName() : null });","        }","    }","    gdjs._webxrHandRayCache[hand] = result;","    return result;","};","","// Fixed model-space correction applied to every tracked controller frame: the","// design-time mesh orientation (captured once per controller from the loaded GLB,","// independent of any runtime pose) composed with the optional user RotationOffset","// property. This never depends on where/how the controller was posed when it","// connected, so orientation is correct whether the session starts with controllers","// already in hand or with hand tracking followed by a later pickup from the table.","gdjs._webxrControllerCorrection = function (beh) {","    var rx = beh._getRotationOffsetX ? Number(beh._getRotationOffsetX()) || 0 : 0;","    var ry = beh._getRotationOffsetY ? Number(beh._getRotationOffsetY()) || 0 : 0;","    var rz = beh._getRotationOffsetZ ? Number(beh._getRotationOffsetZ()) || 0 : 0;","    var qBase = beh._qMeshInit ? beh._qMeshInit.clone() : new THREE.Quaternion();","    if (!rx && !ry && !rz) return qBase;","    var qUser = new THREE.Quaternion().setFromEuler(new THREE.Euler(rx * Math.PI / 180, ry * Math.PI / 180, rz * Math.PI / 180, 'ZYX'));","    return qBase.multiply(qUser);","};","","// Shared by the CalibrateRotation action and the CalibrationPreview expression: solves","// for the RotationOffset that would make the model reproduce its design-time orientation","// exactly at the controller's current physical pose - i.e. treats the pose the controller","// is held in right now as the correct/aligned reference. Returns null if the controller","// isn't currently tracked (no grip yet, or the mesh orientation hasn't been captured).","gdjs._webxrSolveRotationOffsetDegrees = function (beh) {","    if (!beh || !beh._vrGrip || !beh._qMeshInit) return null;","    var wq = new THREE.Quaternion();","    beh._vrGrip.getWorldQuaternion(wq);","    var wqLocal = new THREE.Quaternion(-wq.x, wq.y, -wq.z, wq.w);","    var qUser = beh._qMeshInit.clone().invert().multiply(wqLocal.clone().invert()).multiply(beh._qMeshInit);","    var eu = new THREE.Euler().setFromQuaternion(qUser, 'ZYX');","    return { x: eu.x * 180 / Math.PI, y: eu.y * 180 / Math.PI, z: eu.z * 180 / Math.PI };","};","","var vrRig = new THREE.Group();","gdjs._webxrVrRig = vrRig;","if (renderer) {","    for (var _ci = 0; _ci < 2; _ci++) {","        (function(grip) {","            grip.addEventListener('connected', function(event) {","                var h = event.data.handedness;","                if (h === 'left' || h === 'right') {","                    var handAnchor = new THREE.Group();","                    handAnchor.name = 'webxrHandAnchor_' + h;","                    grip.add(handAnchor);","                    gdjs._webxrVrControllers[h].grip = grip;","                    gdjs._webxrVrControllers[h].handAnchor = handAnchor;","                    gdjs._webxrVrControllers[h].connected = true;","                    vrRig.add(grip);","                    if (typeof gdjs._webxrVrDbg === 'function') {","                        gdjs._webxrVrDbg('controller connected:', h, 'grip added to vrRig');","                    }","                }","            });","            grip.addEventListener('disconnected', function() {","                var keys = ['left', 'right'];","                for (var k = 0; k < keys.length; k++) {","                    if (gdjs._webxrVrControllers[keys[k]].grip === grip) {","                        gdjs._webxrVrControllers[keys[k]].grip = null;","                        gdjs._webxrVrControllers[keys[k]].handAnchor = null;","                        gdjs._webxrVrControllers[keys[k]].connected = false;","                        grip.removeFromParent();","                        if (typeof gdjs._webxrVrDbg === 'function') {","                            gdjs._webxrVrDbg('controller disconnected:', keys[k]);","                        }","                    }","                }","            });","        })(renderer.xr.getControllerGrip(_ci));","        (function(ray) {","            ray.addEventListener('connected', function(event) {","                var h = event.data.handedness;","                if (h === 'left' || h === 'right') {","                    gdjs._webxrVrControllers[h].ray = ray;","                    vrRig.add(ray);","                }","            });","            ray.addEventListener('disconnected', function() {","                var keys = ['left', 'right'];","                for (var k = 0; k < keys.length; k++) {","                    if (gdjs._webxrVrControllers[keys[k]].ray === ray) {","                        gdjs._webxrVrControllers[keys[k]].ray = null;","                        ray.removeFromParent();","                    }","                }","            });","        })(renderer.xr.getController(_ci));","    }","}","","var originalLoop = gdjs.RuntimeGamePixiRenderer.prototype.startGameLoop;","if (gdjs.RuntimeGamePixiRenderer.prototype._webxrVrLoopInstalled) {","    if (typeof gdjs._webxrVrDbg === 'function') {","        gdjs._webxrVrDbg('startGameLoop already patched by WebXR_VR; skip duplicate');","    }","} else {","    gdjs.RuntimeGamePixiRenderer.prototype._webxrVrLoopInstalled = true;","    gdjs.RuntimeGamePixiRenderer.prototype.startGameLoop = function startGameLoop(fn) {","        var oldTime = 0;","        var threeRenderer = this.getThreeRenderer();","        if (!threeRenderer) {","            gdjs.RuntimeGamePixiRenderer.prototype.startGameLoop = originalLoop;","            this.startGameLoop(fn);","            throw new Error('WebXR VR requires a 3D scene (place at least one 3D object).');","        }","        var start = Date.now();","        var game = this.getGame();","        var doStep = function () {","            var time = Date.now() - start;","            var dt = oldTime ? time - oldTime : 0;","            oldTime = time;","            if (!fn(dt)) {","                threeRenderer.setAnimationLoop(null);","            }","        };","        var gameLoop = function (timestamp, frame) {","            gdjs._webxrVrFrame = frame || null;","            gdjs._webxrVrFrameSeq = (gdjs._webxrVrFrameSeq || 0) + 1;","            if (threeRenderer.xr.isPresenting) {","                game.getSceneStack().getCurrentScene().getRenderer().renderForVR();","                queueMicrotask(doStep);","            } else {","                doStep();","            }","        };","        threeRenderer.setAnimationLoop(gameLoop);","    };","}","","if (typeof gdjs._webxrVrDbg === 'function') {","    gdjs._webxrVrDbg('onFirstSceneLoaded: xr.enabled + startGameLoop hook installed, threeRenderer=', !!renderer);","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"After events each frame: if VR just ended, notify the scene so resolution/layout updates.","fullName":"WebXR VR — on scene post events","functionType":"Action","name":"onScenePostEvents","sentence":"Handle WebXR VR session end (fix resolution when exiting VR)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr) {","    return;","}","var presenting = tr.xr.isPresenting;","if (presenting && typeof gdjs._webxrVrRenderDesktopMirror === 'function') {","    gdjs._webxrVrRenderDesktopMirror(runtimeScene);","}","if (gdjs._WebXRVR_WasPresenting && !presenting) {","    var rig = gdjs._webxrVrRig;","    if (rig && rig._vrCamAdded) {","        try {","            var cam = runtimeScene.getLayer('').getRenderer().getThreeCamera();","            if (cam) cam.removeFromParent();","        } catch(e) {}","        rig._vrCamAdded = false;","        if (typeof gdjs._webxrVrDbg === 'function') {","            gdjs._webxrVrDbg('VR ended, camera un-parented from vrRig');","        }","    }","    try {","        runtimeScene.onGameResolutionResized();","    } catch (e) {}","}","gdjs._WebXRVR_WasPresenting = presenting;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Re-runs the asynchronous immersive-vr support check and updates the cached flag.","fullName":"Refresh WebXR support cache","functionType":"Action","name":"updateWebXRSupportCache","sentence":"Refresh WebXR immersive VR support cache","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["gdjs._WebXRVRSupported = false;","if (navigator.xr && navigator.xr.isSessionSupported) {","    navigator.xr.isSessionSupported('immersive-vr').then(function (ok) {","        gdjs._WebXRVRSupported = !!ok;","    }).catch(function () {","        gdjs._WebXRVRSupported = false;","    });","} else {","    gdjs._WebXRVRSupported = false;","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Uses sessionInit optionalFeatures only, then threeRenderer.xr.setSession. Saves XRReferenceSpace to gdjs._webxrVrXrBaseSpace for VrHeadAnchor.","fullName":"Start immersive VR session","functionType":"Action","name":"startImmersiveSession","sentence":"Start WebXR immersive VR session","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var gameRenderer = runtimeScene.getGame().getRenderer();","var threeRenderer = gameRenderer && gameRenderer.getThreeRenderer ? gameRenderer.getThreeRenderer() : null;","if (typeof gdjs._webxrVrDbg === 'function') {","    gdjs._webxrVrDbg('startImmersiveSession: three', !!threeRenderer, 'xr', !!(navigator && navigator.xr));","}","if (!threeRenderer || !navigator.xr) {","    return;","}","threeRenderer.xr.enabled = true;","var sessionInit = { optionalFeatures: ['local-floor', 'bounded-floor', 'hand-tracking', 'layers'] };","var ws = gdjs._webxrVrWorldScale || 100;","var cam = runtimeScene.getLayer('').getRenderer().getThreeCamera();","// Fix near/far on ALL 3D layer cameras, not just the main one.","// Background/UI layers with near=3 scene units would make Quest pass","// depthNear=3 to session.updateRenderState, which WebXR interprets as","// 3 metres — clipping everything within 3 m (controllers, held objects, walls).","var _vrLayerNames = [''];","try {","    var _lh = runtimeScene._layers;","    if (_lh && _lh.items) {","        Object.keys(_lh.items).forEach(function(n) {","            if (_vrLayerNames.indexOf(n) < 0) _vrLayerNames.push(n);","        });","    }","} catch(e) {}","var _vrFixedLayerCams = [];","_vrLayerNames.forEach(function(n) {","    try {","        var _lc = runtimeScene.getLayer(n).getRenderer().getThreeCamera();","        if (_lc && typeof _lc.near === 'number' && _lc.updateProjectionMatrix) {","            _lc._vrOrigNear = _lc.near;","            _lc._vrOrigFar  = _lc.far;","            _lc.near = _lc.near / ws;","            _lc.far  = _lc.far  / ws;","            _lc.updateProjectionMatrix();","            _vrFixedLayerCams.push(n);","        }","    } catch(e) {}","});","gdjs._webxrVrFixedLayerCams = _vrFixedLayerCams;","// VR-safe frustum culling for the duration of the VR session.","// Three.js uses the binocular union frustum (ArrayCamera from xr.getCamera())","// during XR rendering, so the frustum already covers both eyes correctly.","// We patch intersectsObject/intersectsSprite to test the bounding sphere against","// that union frustum with a configurable safety margin, culling objects that are","// fully outside/behind the combined view while preventing the original edge/near","// disappearing bug (which happened with the mono scene-camera frustum).","// Set gdjs._webxrVrFrustumCullEnabled=false at runtime to revert to render-all.","if (typeof THREE !== 'undefined' && THREE.Frustum && !gdjs._webxrVrFrustumIntercepted) {","    gdjs._webxrVrOrigIntersectsObject = THREE.Frustum.prototype.intersectsObject;","    gdjs._webxrVrOrigIntersectsSprite  = THREE.Frustum.prototype.intersectsSprite;","    THREE.Frustum.prototype.intersectsObject = function(object) {","        if (gdjs._webxrVrFrustumCullEnabled === false) return true;","        var geometry = object.geometry;","        if (geometry === undefined) return true;","        if (geometry.boundingSphere === null) geometry.computeBoundingSphere();","        var s = gdjs._webxrVrCullSphere || (gdjs._webxrVrCullSphere = new THREE.Sphere());","        s.copy(geometry.boundingSphere).applyMatrix4(object.matrixWorld);","        var ws = gdjs._webxrVrWorldScale || 100;","        var hp = gdjs._webxrVrHeadWorld;","        if (hp) {","            var nk = (gdjs._webxrVrCullNearKeepMeters != null ? gdjs._webxrVrCullNearKeepMeters : 5) * ws;","            if (s.center.distanceTo(hp) <= nk + s.radius) return true;","        }","        s.radius = s.radius * (gdjs._webxrVrCullRadiusScale || 1)","                 + (gdjs._webxrVrCullMarginMeters || 0) * ws;","        return this.intersectsSphere(s);","    };","    THREE.Frustum.prototype.intersectsSprite = function(sprite) {","        if (gdjs._webxrVrFrustumCullEnabled === false) return true;","        var s = gdjs._webxrVrCullSphere || (gdjs._webxrVrCullSphere = new THREE.Sphere());","        s.center.set(0, 0, 0);","        s.radius = 0.7071067811865476;","        s.applyMatrix4(sprite.matrixWorld);","        var ws = gdjs._webxrVrWorldScale || 100;","        var hp = gdjs._webxrVrHeadWorld;","        if (hp) {","            var nk = (gdjs._webxrVrCullNearKeepMeters != null ? gdjs._webxrVrCullNearKeepMeters : 5) * ws;","            if (s.center.distanceTo(hp) <= nk + s.radius) return true;","        }","        s.radius = s.radius * (gdjs._webxrVrCullRadiusScale || 1)","                 + (gdjs._webxrVrCullMarginMeters || 0) * ws;","        return this.intersectsSphere(s);","    };","    gdjs._webxrVrFrustumIntercepted = true;","}","navigator.xr.requestSession('immersive-vr', sessionInit).then(function (session) {","    if (typeof gdjs._webxrVrDbg === 'function') {","        gdjs._webxrVrDbg('requestSession OK');","    }","    session.addEventListener('end', function () {","        gdjs._webxrVrXrBaseSpace = null;","        (gdjs._webxrVrFixedLayerCams || []).forEach(function(n) {","            try {","                var _lc = runtimeScene.getLayer(n).getRenderer().getThreeCamera();","                if (_lc && _lc._vrOrigNear !== undefined) {","                    _lc.near = _lc._vrOrigNear;","                    _lc.far  = _lc._vrOrigFar;","                    _lc.updateProjectionMatrix();","                }","            } catch(e) {}","        });","        gdjs._webxrVrFixedLayerCams = null;","        gdjs._webxrVrXrNear = undefined;","        gdjs._webxrVrXrFar  = undefined;","        if (gdjs._webxrVrOrigIntersectsObject) {","            THREE.Frustum.prototype.intersectsObject = gdjs._webxrVrOrigIntersectsObject;","            gdjs._webxrVrOrigIntersectsObject = null;","        }","        if (gdjs._webxrVrOrigIntersectsSprite) {","            THREE.Frustum.prototype.intersectsSprite = gdjs._webxrVrOrigIntersectsSprite;","            gdjs._webxrVrOrigIntersectsSprite = null;","        }","        gdjs._webxrVrFrustumIntercepted = false;","        try {","            runtimeScene.onGameResolutionResized();","        } catch (e2) {}","    });","    // Intercept updateRenderState to lock in the correct depth range.","    // Three.js syncs depthNear/depthFar from each layer camera every frame;","    // other layers (Background, UI) with near=3 scene units would pass","    // depthNear=3 to WebXR, which Quest 3S interprets as 3 metres and clips","    // everything closer than that. The intercept enforces the corrected value.","    var _ws2 = gdjs._webxrVrWorldScale || 100;","    var _xrNear = (cam && typeof cam.near === 'number') ? cam.near : (0.3 / _ws2);","    var _xrFar  = (cam && typeof cam.far  === 'number') ? cam.far  : (10000 / _ws2);","    gdjs._webxrVrXrNear = _xrNear;","    gdjs._webxrVrXrFar  = _xrFar;","    var _origURS = session.updateRenderState.bind(session);","    session.updateRenderState = function(init) {","        var p = (init && typeof init === 'object') ? Object.assign({}, init) : {};","        p.depthNear = _xrNear;","        p.depthFar  = _xrFar;","        return _origURS(p);","    };","    return threeRenderer.xr.setSession(session);","}).then(function () {","    // Explicitly seed the XR ArrayCamera near/far before the first render call.","    // Three.js may initialise it with stale defaults (0.1 / 1000) before the","    // per-frame updateCamera() sync runs.","    try {","        var xrC = threeRenderer.xr.getCamera();","        if (xrC && cam) {","            xrC.near = cam.near;","            xrC.far  = cam.far;","            if (xrC.cameras) {","                xrC.cameras.forEach(function(c) { c.near = cam.near; c.far = cam.far; });","            }","        }","        var xrSess = threeRenderer.xr.getSession ? threeRenderer.xr.getSession() : null;","        if (xrSess && cam) {","            xrSess.updateRenderState({ depthNear: cam.near, depthFar: cam.far });","        }","    } catch(e4) {}","    try {","        gdjs._webxrVrXrBaseSpace = threeRenderer.xr.getReferenceSpace();","    } catch (e3) {","        gdjs._webxrVrXrBaseSpace = null;","    }","    if (typeof gdjs._webxrVrDbg === 'function') {","        gdjs._webxrVrDbg('setSession done; isPresenting=', threeRenderer.xr.isPresenting);","    }","}).catch(function (err) {","    console.error('[WebXR_VR] startImmersiveSession failed', err);","});"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"description":"Ends the current WebXR session if one is active.","fullName":"End immersive VR session","functionType":"Action","name":"endImmersiveSession","sentence":"End WebXR immersive VR session","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var threeRenderer = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!threeRenderer || !threeRenderer.xr || !threeRenderer.xr.getSession) {","    return;","}","var sess = threeRenderer.xr.getSession();","if (sess) {","    sess.end();","}","gdjs._webxrVrXrBaseSpace = null;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Enable or disable the VR desktop mirror. When enabled (default), a mono view of what the headset wearer sees is also rendered to the flat screen (browser window / monitor) each frame while a VR session is active. This only affects what is shown on the flat screen; the headset view is never changed. It costs one extra render pass per frame, so a build that only ever runs standalone inside a headset browser can turn it off for a small performance gain.","fullName":"Enable VR desktop mirror","functionType":"Action","group":"Desktop Mirror","name":"SetDesktopMirror","sentence":"Enable WebXR VR desktop mirror: _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"gdjs._webxrVrMirrorEnabled = !!eventsFunctionContext.getArgument(\"Enabled\");","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Enable the desktop mirror (Yes = show it on the flat screen, No = leave the screen on the last mirrored frame)","name":"Enabled","type":"yesorno"}],"objectGroups":[]},{"description":"True when the VR desktop mirror is enabled. True by default.","fullName":"VR desktop mirror enabled","functionType":"Condition","group":"Desktop Mirror","name":"IsDesktopMirrorEnabled","sentence":"WebXR VR desktop mirror is enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (gdjs._webxrVrMirrorEnabled !== false);","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Set the field of view (in degrees) used by the VR desktop mirror. Default is 75. Values are clamped to 1-179; 0 or an invalid/negative value resets to the default (75).","fullName":"Set VR desktop mirror field of view","functionType":"Action","group":"Desktop Mirror","name":"SetDesktopMirrorFov","sentence":"Set WebXR VR desktop mirror field of view to _PARAM1_ degrees","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var v = eventsFunctionContext.getArgument(\"Degrees\");","gdjs._webxrVrMirrorFovDeg = (typeof v === 'number' && isFinite(v) && v > 0) ? Math.max(1, Math.min(179, v)) : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Field of view in degrees (e.g. 75), or 0 to reset to the default","name":"Degrees","type":"expression"}],"objectGroups":[]},{"description":"Current VR desktop mirror field of view in degrees. Default is 75.","fullName":"VR desktop mirror field of view","functionType":"ExpressionAndCondition","group":"Desktop Mirror","name":"DesktopMirrorFov","sentence":"VR desktop mirror field of view in degrees","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (typeof gdjs._webxrVrMirrorFovDeg === 'number') ? gdjs._webxrVrMirrorFovDeg : 75;","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"True when the cached support probe succeeded. False until the probe completes or if unsupported.","fullName":"WebXR immersive VR supported (cached)","functionType":"Condition","name":"isWebXRSupported","sentence":"WebXR immersive VR is supported","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (typeof gdjs !== 'undefined' && gdjs._WebXRVRSupported === true);","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"True while the Three.js XR session is presenting (headset active).","fullName":"WebXR immersive VR is presenting","functionType":"Condition","name":"isImmersiveVRActive","sentence":"WebXR immersive VR session is active","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","eventsFunctionContext.returnValue = !!(tr && tr.xr && tr.xr.isPresenting);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Sets the world scale used by all VR behaviors (scene units per meter). Defaults to 100 if never called.","fullName":"Set VR world scale","functionType":"Action","name":"setWorldScale","sentence":"Set WebXR VR world scale to _PARAM1_ scene units per meter","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var val = eventsFunctionContext.getArgument(\"WorldScale\");","gdjs._webxrVrWorldScale = (typeof val === 'number' && val > 0) ? val : 100;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Scene units per meter (e.g. 100)","name":"WorldScale","type":"expression"}],"objectGroups":[]},{"description":"Enable or disable VR frustum culling. When enabled (default), objects fully outside the headset's combined binocular view are skipped each frame, improving performance. When disabled, every object is rendered every frame regardless of visibility. If objects disappear at the edges of view, try raising the margin via Set VR frustum cull margin rather than disabling culling entirely.","fullName":"Enable VR frustum culling","functionType":"Action","group":"Performance","name":"setVrFrustumCulling","sentence":"Enable WebXR VR frustum culling: _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"gdjs._webxrVrFrustumCullEnabled = !!eventsFunctionContext.getArgument(\"Enabled\");","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Enable culling (Yes = cull objects outside view, No = render everything)","name":"Enabled","type":"yesorno"}],"objectGroups":[]},{"description":"True when VR frustum culling is enabled (objects outside the headset view are skipped). True by default.","fullName":"VR frustum culling enabled","functionType":"Condition","group":"Performance","name":"isVrFrustumCullingEnabled","sentence":"WebXR VR frustum culling is enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (gdjs._webxrVrFrustumCullEnabled !== false);","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]},{"description":"Fine-tune the safety margin used by VR frustum culling so that objects near the edges of view or close to the camera are not wrongly culled. RadiusScale multiplies each object's bounding sphere (e.g. 1.2 = 20% larger). MarginMeters adds an absolute buffer in meters (e.g. 0.5 = half a metre). Defaults are 1.2 and 0.5. Raise these if objects still disappear; lower them only if you need to maximise culling aggressiveness.","fullName":"Set VR frustum cull margin","functionType":"Action","group":"Performance","name":"setVrFrustumCullMargin","sentence":"Set WebXR VR frustum cull margin to radius scale _PARAM1_ and _PARAM2_ m absolute","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var sc = eventsFunctionContext.getArgument(\"RadiusScale\");","var mm = eventsFunctionContext.getArgument(\"MarginMeters\");","gdjs._webxrVrCullRadiusScale  = (typeof sc === 'number' && sc > 0) ? sc : 1.2;","gdjs._webxrVrCullMarginMeters = (typeof mm === 'number' && mm >= 0) ? mm : 0.5;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Bounding sphere radius multiplier (e.g. 1.2 for 20% inflation). Must be > 0.","name":"RadiusScale","type":"expression"},{"description":"Absolute margin added to each object's bounding sphere radius, in meters (e.g. 0.5). Must be >= 0.","name":"MarginMeters","type":"expression"}],"objectGroups":[]},{"description":"Current VR frustum culling absolute margin in meters (the extra buffer added to each object's bounding sphere). Default is 0.5.","fullName":"VR frustum cull margin (meters)","functionType":"ExpressionAndCondition","group":"Performance","name":"VrFrustumCullMarginMeters","sentence":"VR frustum cull margin in meters","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (typeof gdjs._webxrVrCullMarginMeters === 'number') ? gdjs._webxrVrCullMarginMeters : 0.5;","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"Current VR frustum culling bounding sphere radius multiplier. Default is 2.0.","fullName":"VR frustum cull radius scale","functionType":"ExpressionAndCondition","group":"Performance","name":"VrFrustumCullRadiusScale","sentence":"VR frustum cull radius scale","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (typeof gdjs._webxrVrCullRadiusScale === 'number') ? gdjs._webxrVrCullRadiusScale : 2.0;","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"Set the near-keep distance for VR frustum culling. Any object whose bounding sphere centre is within this distance of the headset is always rendered, regardless of the frustum test. This prevents objects from being culled as the player approaches or holds them close. Default is 5 m. Set to 0 to disable near-keep (rely on margin only).","fullName":"Set VR frustum cull near-keep distance","functionType":"Action","group":"Performance","name":"SetVrFrustumCullNearKeep","sentence":"Set WebXR VR frustum cull near-keep distance to _PARAM1_ m","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var m = eventsFunctionContext.getArgument(\"Meters\");","gdjs._webxrVrCullNearKeepMeters = (typeof m === 'number' && m >= 0) ? m : 5.0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Distance in meters within which objects are never culled (e.g. 5). Must be >= 0.","name":"Meters","type":"expression"}],"objectGroups":[]},{"description":"Current near-keep distance for VR frustum culling in meters. Objects whose bounding sphere centre is within this distance of the headset are always rendered. Default is 5.","fullName":"VR frustum cull near-keep distance (meters)","functionType":"ExpressionAndCondition","group":"Performance","name":"VrFrustumCullNearKeepMeters","sentence":"VR frustum cull near-keep distance in meters","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (typeof gdjs._webxrVrCullNearKeepMeters === 'number') ? gdjs._webxrVrCullNearKeepMeters : 5.0;","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"True when the the web app is running as PWA on a Meta Quest.","fullName":"Is running as PWA","functionType":"Condition","name":"isRunningAsPWA","sentence":"Is running as PWA","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"eventsFunctionContext.returnValue = (window.getDigitalGoodsService !== undefined);","parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onFirstSceneLoaded"},{"functionName":"onScenePostEvents"},{"functionName":"updateWebXRSupportCache"},{"functionName":"startImmersiveSession"},{"functionName":"endImmersiveSession"},{"functionName":"isWebXRSupported"},{"functionName":"isRunningAsPWA"},{"functionName":"isImmersiveVRActive"},{"functionName":"setWorldScale"},{"folderName":"Performance","children":[{"functionName":"setVrFrustumCulling"},{"functionName":"isVrFrustumCullingEnabled"},{"functionName":"setVrFrustumCullMargin"},{"functionName":"VrFrustumCullMarginMeters"},{"functionName":"VrFrustumCullRadiusScale"},{"functionName":"SetVrFrustumCullNearKeep"},{"functionName":"VrFrustumCullNearKeepMeters"}]},{"folderName":"Desktop Mirror","children":[{"functionName":"SetDesktopMirror"},{"functionName":"IsDesktopMirrorEnabled"},{"functionName":"SetDesktopMirrorFov"},{"functionName":"DesktopMirrorFov"}]},{"folderName":"Zones"},{"folderName":"Holster"}]},"eventsBasedBehaviors":[{"description":"Anchor the VR camera and controllers to a game object. Position this behavior on one object per scene to establish the VR rig's origin point. The headset will move with this object, enabling teleportation and spatial transformations.","fullName":"VR head anchor (WebXR)","helpPath":"","iconUrl":"","name":"VrHeadAnchor","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"doStepPostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var objs = eventsFunctionContext.getObjects(\"Object\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) {","    return;","}","var rig = gdjs._webxrVrRig;","if (!rig) return;","","// Define (once) a lightweight rig-current helper so VrGrabbable/VrHolster/VrBodyZones","// postEvents can sync the rig before reading grip world positions, even if VrHeadAnchor","// hasn't run yet for this frame. Guarded by a per-XRFrame token.","if (!gdjs._webxrVrEnsureRigCurrent) {","    gdjs._webxrVrEnsureRigCurrent = function() {","        if (gdjs._webxrVrRigFrame === gdjs._webxrVrFrameSeq) return;","        var _erRig = gdjs._webxrVrRig;","        var _erObj = gdjs._webxrVrAnchorObject;","        if (!_erRig || !_erObj) return;","        var _erWs = gdjs._webxrVrWorldScale || 100;","        var _erAng = -_erObj.getAngle();","        var _erHA = _erAng * Math.PI / 360;","        var _erSz = Math.sin(_erHA), _erCz = Math.cos(_erHA);","        _erRig.position.set(_erObj.getX(), -_erObj.getY(), _erObj.getZ());","        _erRig.quaternion.set(0.5*(_erCz+_erSz), 0.5*(_erSz-_erCz), 0.5*(_erSz-_erCz), 0.5*(_erCz+_erSz));","        _erRig.scale.set(_erWs, _erWs, _erWs);","        var _erVO = gdjs._webxrVrAnchor ? (gdjs._webxrVrAnchor._verticalOffset || 0) : 0;","        if (_erVO) _erRig.position.z = _erObj.getZ() + _erVO;","        _erRig.updateMatrixWorld(true);","        gdjs._webxrVrRigFrame = gdjs._webxrVrFrameSeq;","    };","}","","// Enforce correct XR near/far every frame before render().","// GDevelop may reset camera.near to scene-unit values each frame;","// this counteracts that so Three.js and the XR session see the right depth range.","if (gdjs._webxrVrXrNear !== undefined) {","    var _nf = gdjs._webxrVrXrNear;","    var _ff = gdjs._webxrVrXrFar;","    try {","        var _lhNF = runtimeScene._layers;","        if (_lhNF && _lhNF.items) {","            Object.keys(_lhNF.items).forEach(function(n) {","                try {","                    var _lcNF = runtimeScene.getLayer(n).getRenderer().getThreeCamera();","                    if (_lcNF && typeof _lcNF.near === 'number' && _lcNF.near !== _nf) {","                        _lcNF.near = _nf;","                        _lcNF.far  = _ff;","                        _lcNF.updateProjectionMatrix();","                    }","                } catch(e) {}","            });","        }","    } catch(e) {}","    try {","        var _xrSNF = tr.xr.getSession ? tr.xr.getSession() : null;","        if (_xrSNF) _xrSNF.updateRenderState({ depthNear: _nf, depthFar: _ff });","    } catch(e) {}","}","","// GDevelop's own VR render path unconditionally overwrites every 3D layer's","// threeScene.background each frame (a flat color on the first layer processed,","// null on the rest), destroying any Scene3D::Skybox effect's cube texture as","// soon as a VR session starts - RuntimeScenePixiRenderer.renderForVR() lacks","// the 'if (!threeScene.background)' guard that its flat-preview render() path","// has. Rather than invent an independent skybox mechanism (mirroring/handedness/","// up-axis assumptions each fixed one thing and revealed another across several","// rounds), this rebuilds GDevelop's OWN Scene3D::Skybox cube-texture algorithm","// exactly (Extensions/3D/Skybox.ts + pixi-image-manager.ts's getThreeCubeTexture),","// reusing the same SkyboxRight/Left/Top/Bottom/Front/Back.png images already","// proven correct for flat-preview rendering - no code-side mirroring needed,","// they are already pre-mirrored for exactly this algorithm - then protects the","// result from being clobbered every frame via a get/set trap on","// threeScene.background/environment.","// This project's VR rig already runs in a genuine three.js Z-up space (Three.js","// Z = GDevelop Z, see the rig position-mapping comment a few dozen lines below).","// Property convention: Front/Back = GDevelop +X/-X (the direction faced at","// Angle=0), Right/Left = GDevelop +Y/-Y, Top/Bottom = GDevelop +Z/-Z (zenith/","// nadir). A raw CubeTexture's six array slots are not rotation-agnostic (found","// the hard way over several rounds): the Y-slot pair (now Right/Left) samples","// with its vertical texture axis mapped to world Z, with opposite sign between","// the two faces (one reads upside-down relative to the other), while the X-slot","// and Z-slot pairs (now Front/Back and Top/Bottom) share a different convention","// where the vertical texture axis maps to world Y instead - so a horizon image's","// 'up' gets reinterpreted as a rotation. Confirmed empirically with a labeled","// debug skybox (word label + up-arrow + 4 colored corners per face, tested in VR","// across several passes) and confirmed correct on-device: every one of the three","// slot pairs has its own opposite-sign (180-degree) relationship between its two","// member faces - Front(+90)/Back(+270), Right(0)/Left(+180), Top(0)/Bottom(+180).","// Bottom isn't directly visible from the floor in this demo scene so it wasn't","// independently confirmed, but its real (radially-symmetric) image makes any","// residual error invisible either way.","// Applied below via gdjs._webxrSkyFaceCanvas(img, rotateDeg, flipV), isolated to","// this VR cube texture only - flat preview is untouched.","if (!gdjs._webxrSkyFaceCanvas) {","    gdjs._webxrSkyFaceCanvas = function (img, rotateDeg, flipV) {","        if (!img || (!rotateDeg && !flipV)) return img;","        var _w = img.width || img.naturalWidth || 512;","        var _h = img.height || img.naturalHeight || 512;","        var _rot90 = Math.abs(rotateDeg % 180) === 90;","        var _cv = document.createElement('canvas');","        _cv.width = _rot90 ? _h : _w;","        _cv.height = _rot90 ? _w : _h;","        var _ctx = _cv.getContext('2d');","        _ctx.save();","        _ctx.translate(_cv.width / 2, _cv.height / 2);","        _ctx.rotate(rotateDeg * Math.PI / 180);","        if (flipV) _ctx.scale(1, -1);","        _ctx.drawImage(img, -_w / 2, -_h / 2);","        _ctx.restore();","        return _cv;","    };","}","if (!gdjs._webxrVrSkyCubeTexture) {","    try {","        var _skyBeh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","        var _imgMgr = runtimeScene.getGame().getImageManager();","        if (_skyBeh && _imgMgr) {","            var _skyRight  = _skyBeh._getSkyboxRight  ? _skyBeh._getSkyboxRight()  : '';","            var _skyLeft   = _skyBeh._getSkyboxLeft   ? _skyBeh._getSkyboxLeft()   : '';","            var _skyTop    = _skyBeh._getSkyboxTop    ? _skyBeh._getSkyboxTop()    : '';","            var _skyBottom = _skyBeh._getSkyboxBottom ? _skyBeh._getSkyboxBottom() : '';","            var _skyFront  = _skyBeh._getSkyboxFront  ? _skyBeh._getSkyboxFront()  : '';","            var _skyBack   = _skyBeh._getSkyboxBack   ? _skyBeh._getSkyboxBack()   : '';","            var _getImg = function (name) {","                var _t = name ? _imgMgr.getThreeTexture(name) : null;","                return _t ? _t.image : null;","            };","            // Front/Back -> xPos/xNeg (GDevelop Angle=0 faces +X = Front, Three.js X","            // = GDevelop X, no inversion). Right/Left -> yNeg/yPos (GDevelop +Y =","            // Right, but Three.js Y = -GDevelop Y, so these invert). Top/Bottom ->","            // zPos/zNeg (Three.js Z = GDevelop Z = up, no inversion). Per-face","            // rotation corrections confirmed empirically (see comment above).","            var _imgXPos = gdjs._webxrSkyFaceCanvas(_getImg(_skyFront), 90, false);","            var _imgXNeg = gdjs._webxrSkyFaceCanvas(_getImg(_skyBack), 270, false);","            var _imgYPos = gdjs._webxrSkyFaceCanvas(_getImg(_skyLeft), 180, false);","            var _imgYNeg = gdjs._webxrSkyFaceCanvas(_getImg(_skyRight), 0, false);","            var _imgZPos = gdjs._webxrSkyFaceCanvas(_getImg(_skyTop), 0, false);","            var _imgZNeg = gdjs._webxrSkyFaceCanvas(_getImg(_skyBottom), 180, false);","            if (_imgXPos && _imgXNeg && _imgYPos && _imgYNeg && _imgZPos && _imgZNeg) {","                var _cubeTex = new THREE.CubeTexture();","                // Faces on X axis need to be swapped - matches GDevelop's own algorithm exactly.","                _cubeTex.images[0] = _imgXNeg;","                _cubeTex.images[1] = _imgXPos;","                _cubeTex.images[2] = _imgYPos;","                _cubeTex.images[3] = _imgYNeg;","                _cubeTex.images[4] = _imgZPos;","                _cubeTex.images[5] = _imgZNeg;","                _cubeTex.magFilter = THREE.LinearFilter;","                _cubeTex.minFilter = THREE.LinearFilter;","                _cubeTex.colorSpace = THREE.SRGBColorSpace;","                _cubeTex.needsUpdate = true;","                gdjs._webxrVrSkyCubeTexture = _cubeTex;","                if (typeof gdjs._webxrVrDbg === 'function') gdjs._webxrVrDbg('VR skybox cube texture built');","            }","        }","    } catch (e7) {","        if (typeof gdjs._webxrVrDbg === 'function') gdjs._webxrVrDbg('VR skybox build failed', e7 && e7.message);","    }","}","if (gdjs._webxrVrSkyCubeTexture) {","    try {","        if (!gdjs._webxrVrSkyTrappedScenes) gdjs._webxrVrSkyTrappedScenes = new WeakSet();","        var _skyThreeScene = runtimeScene.getLayer('').getRenderer().getThreeScene();","        if (_skyThreeScene && !gdjs._webxrVrSkyTrappedScenes.has(_skyThreeScene)) {","            Object.defineProperty(_skyThreeScene, 'background', {","                configurable: true,","                get: function () { return gdjs._webxrVrSkyCubeTexture; },","                set: function () {}","            });","            Object.defineProperty(_skyThreeScene, 'environment', {","                configurable: true,","                get: function () { return gdjs._webxrVrSkyCubeTexture; },","                set: function () {}","            });","            gdjs._webxrVrSkyTrappedScenes.add(_skyThreeScene);","            if (typeof gdjs._webxrVrDbg === 'function') gdjs._webxrVrDbg('VR skybox scene trapped');","        }","    } catch (e8) {","        if (typeof gdjs._webxrVrDbg === 'function') gdjs._webxrVrDbg('VR skybox trap failed', e8 && e8.message);","    }","}","","gdjs._webxrDebugThrow = false;","","var cam = runtimeScene.getLayer('').getRenderer().getThreeCamera();","var _camJustAdded = false;","if (cam && cam.parent !== rig) {","    try {","        rig.add(cam);","        rig._vrCamAdded = true;","        _camJustAdded = true;","        if (typeof gdjs._webxrVrDbg === 'function') {","            gdjs._webxrVrDbg('camera parented to vrRig');","        }","    } catch(e) {}","}","","var ws = gdjs._webxrVrWorldScale || 100;","","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","    if (!obj.get3DRendererObject) continue;","","    var angle = -obj.getAngle();","    var halfA = angle * Math.PI / 360;","    var sz = Math.sin(halfA);","    var cz = Math.cos(halfA);","    var qx = 0.5 * (cz + sz);","    var qy = 0.5 * (sz - cz);","    var qz = 0.5 * (sz - cz);","    var qw = 0.5 * (cz + sz);","","    // Compute rig position directly from GDevelop object coordinates.","    // Axis mapping: Three.js X = GDevelop X, Three.js Y = -GDevelop Y, Three.js Z = GDevelop Z.","    // For Model3D with originLocation='ModelOrigin', obj.getX/Y() already returns","    // the model's origin which is its geometric centre — no half-extent offset needed.","    var threeRigX = obj.getX();","    var threeRigY = -obj.getY();","    var threeRigZ = obj.getZ();","","    // Pass 1: set rig at floor level to sample real headset height.","    rig.position.set(threeRigX, threeRigY, threeRigZ);","    rig.quaternion.set(qx, qy, qz, qw);","    rig.scale.set(ws, ws, ws);","    rig.updateMatrixWorld(true);","","    // Headset height: camera world Z minus rig Z gives head height in game units.","    // The rig rotation always maps XR Y (up) to scene Z (GDevelop up), regardless of yaw.","    try {","        var _hCam = runtimeScene.getLayer('').getRenderer().getThreeCamera();","        if (_hCam) {","            var _hWP = new THREE.Vector3();","            _hCam.getWorldPosition(_hWP);","            beh._headsetHeight = _hWP.z - threeRigZ;","            gdjs._webxrVrHeadWorld = (gdjs._webxrVrHeadWorld || new THREE.Vector3()).copy(_hWP);","        }","    } catch(e) {}","    // Cache HMD orientation in GDevelop-space Euler angles (degrees).","    try {","        var _rCam = runtimeScene.getLayer('').getRenderer().getThreeCamera();","        if (_rCam) {","            var _qfc = new THREE.Quaternion(0.5, -0.5, -0.5, 0.5);","            var _camGd = _qfc.clone().multiply(_rCam.quaternion).multiply(_qfc.clone().conjugate());","            var _hmdYawRad = angle * Math.PI / 180;","            var _headQ = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), _hmdYawRad).multiply(_camGd);","            var _headEu = new THREE.Euler().setFromQuaternion(_headQ, 'ZYX');","            beh._headYaw   = _headEu.z * 180 / Math.PI;","            beh._headPitch = _headEu.x * 180 / Math.PI;","            beh._headRoll  = _headEu.y * 180 / Math.PI;","        }","    } catch(e) {}","    // Virtual-torso yaw: head-driven, deadzone-leashed body heading that drives","    // holsters (VrBodyZones body zones), body-relative followers (VrFollower AnchorYaw),","    // and head-relative movement (MovementDirectionMode Head).","    // Always computed regardless of MovementDirectionMode so holsters follow physical","    // turning even during teleport or Off locomotion.","    try {","        if (!beh._torsoYawInit) {","            beh._torsoYaw = obj.getAngle();","            beh._torsoYawInit = true;","        }","        var _torsoTarget = -beh._headYaw;","        var _bodyDeadzone = beh._getBodyYawDeadzone ? Number(beh._getBodyYawDeadzone()) : 45;","        if (_bodyDeadzone <= 0) {","            beh._torsoYaw = _torsoTarget;","        } else {","            var _tDelta = ((_torsoTarget - beh._torsoYaw) % 360 + 540) % 360 - 180;","            var _tEdge;","            if (_tDelta > _bodyDeadzone) {","                _tEdge = _torsoTarget - _bodyDeadzone;","            } else if (_tDelta < -_bodyDeadzone) {","                _tEdge = _torsoTarget + _bodyDeadzone;","            } else {","                _tEdge = beh._torsoYaw;","            }","            var _bodySmoothing = beh._getBodyYawSmoothing ? Number(beh._getBodyYawSmoothing()) : 0;","            if (_bodySmoothing > 0) {","                var _tDt = runtimeScene.getGame().getElapsedTime() / 1000;","                var _tStepMax = _bodySmoothing * _tDt;","                var _tDiff = ((_tEdge - beh._torsoYaw) % 360 + 540) % 360 - 180;","                beh._torsoYaw = beh._torsoYaw + Math.sign(_tDiff) * Math.min(Math.abs(_tDiff), _tStepMax);","            } else {","                beh._torsoYaw = _tEdge;","            }","        }","        beh._torsoYaw = ((beh._torsoYaw % 360) + 360) % 360;","    } catch(e) {}","","","    // Pass 2: apply vertical offset (crouch + virtual height) to the rig.","    var _crouchF = Number(beh._getCrouchHeightFactor ? beh._getCrouchHeightFactor() : 0.5);","    var _crouchOff = beh._isCrouching ? -(beh._headsetHeight * (1 - _crouchF)) : 0;","    var _virtH = Number(beh._getVirtualHeight ? beh._getVirtualHeight() : 0);","    var _virtOff = (_virtH > 0 && beh._headsetHeight > 0) ? (_virtH - beh._headsetHeight) : 0;","    beh._verticalOffset = _crouchOff + _virtOff;","    if (beh._verticalOffset) {","        rig.position.z = threeRigZ + beh._verticalOffset;","        rig.updateMatrixWorld(true);","    }","","    gdjs._webxrVrAnchor = {","        x: obj.getX(), y: obj.getY(), z: obj.getZ(),","        threeX: threeRigX, threeY: threeRigY, threeZ: threeRigZ,","        angle: angle,","        bodyYaw: beh._torsoYaw != null ? -beh._torsoYaw : angle,","        runtimeScene: runtimeScene,","        _verticalOffset: beh._verticalOffset || 0","    };","    gdjs._webxrVrAnchorObject = obj;","","    // On scene-change frames (camera just re-parented): remove stale cameras from the rig","    // and re-sync controller position + rotation immediately, instead of waiting a frame","    // for VrController.doStepPostEvents. Rotation uses the same fixed model-space","    // correction as doStepPostEvents (design-time mesh orientation + RotationOffset);","    // it is skipped for one frame if the new scene's mesh hasn't finished loading yet,","    // since doStepPreEvents/doStepPostEvents will pick it up within a frame or two.","    if (_camJustAdded) {","        var _rigChildren = rig.children.slice();","        for (var _rci = 0; _rci < _rigChildren.length; _rci++) {","            if (_rigChildren[_rci] !== cam && _rigChildren[_rci].isCamera) { rig.remove(_rigChildren[_rci]); }","        }","        var _rssCtrls = gdjs._webxrVrControllers;","        if (_rssCtrls) {","            var _rssHands = ['left', 'right'];","            for (var _rssHi = 0; _rssHi < _rssHands.length; _rssHi++) {","                var _rssCe = _rssCtrls[_rssHands[_rssHi]];","                if (!_rssCe || !_rssCe.grip || !_rssCe.gdObject) continue;","                // Position re-sync.","                var _rssWp = new THREE.Vector3();","                _rssCe.grip.getWorldPosition(_rssWp);","                _rssCe.gdObject.setX(_rssWp.x);","                _rssCe.gdObject.setY(-_rssWp.y);","                _rssCe.gdObject.setZ(_rssWp.z);","                _rssCe.grip.updateMatrixWorld(true);","                // Rotation: skip until this scene's mesh orientation has been captured.","                if (!_rssCe.vrBeh || !_rssCe.vrBeh._qMeshInit) continue;","                var _rssWq = new THREE.Quaternion();","                _rssCe.grip.getWorldQuaternion(_rssWq);","                var _rssWqLocal = new THREE.Quaternion(-_rssWq.x, _rssWq.y, -_rssWq.z, _rssWq.w);","                var _rssQFinal = _rssWqLocal.clone().multiply(gdjs._webxrControllerCorrection(_rssCe.vrBeh));","                var _rssEu = new THREE.Euler().setFromQuaternion(_rssQFinal, 'ZYX');","                _rssCe.gdObject.setAngle(_rssEu.z * 180 / Math.PI);","                if (_rssCe.gdObject.setRotationX) _rssCe.gdObject.setRotationX(_rssEu.x * 180 / Math.PI);","                if (_rssCe.gdObject.setRotationY) _rssCe.gdObject.setRotationY(_rssEu.y * 180 / Math.PI);","                var _rssTObj = _rssCe.gdObject.get3DRendererObject ? _rssCe.gdObject.get3DRendererObject() : null;","                if (_rssTObj) { _rssTObj.quaternion.copy(_rssQFinal); _rssTObj.updateMatrix(); }","            }","        }","    }","","    // Mark rig as current for this frame so _webxrVrEnsureRigCurrent is a no-op","    // when called by other postEvents behaviors this same frame.","    gdjs._webxrVrRigFrame = gdjs._webxrVrFrameSeq;","    break;","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Headset height above floor in game units (e.g. 170 for a 1.7 m person at worldScale 100). Requires 'local-floor' or 'bounded-floor' XR reference space.","fullName":"Headset height","functionType":"ExpressionAndCondition","name":"HeadsetHeight","sentence":"headset height","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._headsetHeight || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"HMD yaw (horizontal facing direction) in degrees in GDevelop space - 0° faces positive X, increases counter-clockwise. Equivalent to the object angle that tracks the player's horizontal look direction.","fullName":"Head yaw","functionType":"ExpressionAndCondition","name":"HeadYaw","sentence":"head yaw","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._headYaw || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"HMD pitch (up/down tilt) in degrees in GDevelop space - positive tilts forward/down, negative tilts backward/up.","fullName":"Head pitch","functionType":"ExpressionAndCondition","name":"HeadPitch","sentence":"head pitch","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._headPitch || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"HMD roll (lateral tilt) in degrees in GDevelop space - positive tilts left ear down, negative tilts right ear down.","fullName":"Head roll","functionType":"ExpressionAndCondition","name":"HeadRoll","sentence":"head roll","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._headRoll || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Start crouching: scales the physics body uniformly by CrouchScale (all axes) and lowers the VR rig so the camera sits at CrouchHeightFactor × real headset height. Controllers, body zones, and followers all shift down together. No-op if already crouching.","fullName":"Start crouching","functionType":"Action","group":"Crouch","name":"StartCrouching","sentence":"Start crouching on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","    if (beh._isCrouching) continue;","    beh._isCrouching = true;","    var phys = null;","    try { phys = obj.getBehavior('Physics3D'); } catch(e) {}","    if (phys && typeof phys.setShapeScale === 'function') {","        var _s = Number(beh._getCrouchScale ? beh._getCrouchScale() : 0.5);","        beh._savedShapeScale = Number(phys.shapeScale) || 1;","        phys.setShapeScale(beh._savedShapeScale * _s);","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Stop crouching: restores the original physics body shape and returns the VR rig and camera to full headset height. No-op if not crouching.","fullName":"Stop crouching","functionType":"Action","group":"Crouch","name":"StopCrouching","sentence":"Stop crouching on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","if (!gdjs._webxrCanStopCrouching) {","    gdjs._webxrCanStopCrouching = function(beh, scene) {","        if (!beh._isCrouching) return {canStop: true, hit: null};","        try {","            var cam = scene.getLayer('').getRenderer().getThreeCamera();","            if (!cam) return {canStop: true, hit: null};","            var crouchF = Number(beh._getCrouchHeightFactor ? beh._getCrouchHeightFactor() : 0.5);","            var gap = beh._headsetHeight * (1 - crouchF);","            if (gap <= 0) return {canStop: true, hit: null};","            var origin = cam.getWorldPosition(new THREE.Vector3());","            var rcUp = new THREE.Raycaster(origin, new THREE.Vector3(0, 0, 1), 0.001, gap);","            var _crLr = scene.getLayer('');","            var _crLr3d = _crLr && _crLr.getRenderer ? _crLr.getRenderer() : null;","            var _crScene = _crLr3d ? (_crLr3d._threeScene || _crLr3d.threeScene || (_crLr3d.getThreeScene ? _crLr3d.getThreeScene() : null)) : null;","            if (!_crScene) return {canStop: true, hit: null};","            var hits = rcUp.intersectObjects(_crScene.children, true);","            // Ignore objects currently holstered (VrBodyZones or VrHolster): they sit in the","            // head/body zone and would otherwise falsely block standing up. Mirrors the laser","            // raycast's skipMeshes pattern.","            var _crSkip = new Set();","            if (gdjs._webxrVrGrabbableRegistry) {","                for (var _cgi = 0; _cgi < gdjs._webxrVrGrabbableRegistry.length; _cgi++) {","                    var _cge = gdjs._webxrVrGrabbableRegistry[_cgi];","                    if (_cge.beh && _cge.beh._holsterEntry && _cge.beh._holsterEntry.occupant) {","                        var _cgm = _cge.obj.get3DRendererObject ? _cge.obj.get3DRendererObject() : null;","                        if (_cgm) _cgm.traverse(function(ch) { if (ch.isMesh) _crSkip.add(ch); });","                    }","                }","            }","            var firstHit = null;","            for (var _hi = 0; _hi < hits.length; _hi++) {","                if ((!gdjs._webxrHitIsController || !gdjs._webxrHitIsController(hits[_hi])) && !_crSkip.has(hits[_hi].object)) {","                    firstHit = hits[_hi]; break;","                }","            }","            return {canStop: !firstHit, hit: firstHit || null};","        } catch(e) { return {canStop: true, hit: null}; }","    };","}","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","    if (!beh._isCrouching) continue;","    var _csc = gdjs._webxrCanStopCrouching(beh, runtimeScene);","    if (!_csc.canStop) {","        var _now = Date.now();","        if (!beh._lastStopBonkAt || _now - beh._lastStopBonkAt >= 250) {","            beh._lastStopBonkAt = _now;","            try {","                var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","                if (tr && tr.xr) {","                    var _sess = tr.xr.getSession ? tr.xr.getSession() : null;","                    if (_sess && _sess.inputSources) {","                        var _hands = ['left', 'right'];","                        for (var _h = 0; _h < _hands.length; _h++) {","                            for (var _si = 0; _si < _sess.inputSources.length; _si++) {","                                var _src = _sess.inputSources[_si];","                                if (_src.handedness === _hands[_h] && _src.gamepad &&","                                    _src.gamepad.hapticActuators && _src.gamepad.hapticActuators.length > 0) {","                                    _src.gamepad.hapticActuators[0].pulse(0.4, 80);","                                    break;","                                }","                            }","                        }","                    }","                }","            } catch(e) {}","        }","        continue;","    }","    beh._isCrouching = false;","    if (beh._savedShapeScale != null) {","        var phys = null;","        try { phys = obj.getBehavior('Physics3D'); } catch(e) {}","        if (phys && typeof phys.setShapeScale === 'function') {","            phys.setShapeScale(beh._savedShapeScale);","        }","        beh._savedShapeScale = null;","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"True while the player is crouching (between StartCrouching and StopCrouching).","fullName":"Is crouching","functionType":"Condition","group":"Crouch","name":"IsCrouching","sentence":"_PARAM0_ is crouching","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._isCrouching);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"True if the space above the player's head is clear enough to stand up to full height. Casts a ray upward from the head by the remaining stand-up distance only (crouched head → standing head), so doorways and ceilings above standing height do not block. Returns true when the player is not crouching.","fullName":"Can stop crouching","functionType":"Condition","group":"Crouch","name":"CanStopCrouching","sentence":"_PARAM0_ can stop crouching","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!gdjs._webxrCanStopCrouching) {","    gdjs._webxrCanStopCrouching = function(beh, scene) {","        if (!beh._isCrouching) return {canStop: true, hit: null};","        try {","            var cam = scene.getLayer('').getRenderer().getThreeCamera();","            if (!cam) return {canStop: true, hit: null};","            var crouchF = Number(beh._getCrouchHeightFactor ? beh._getCrouchHeightFactor() : 0.5);","            var gap = beh._headsetHeight * (1 - crouchF);","            if (gap <= 0) return {canStop: true, hit: null};","            var origin = cam.getWorldPosition(new THREE.Vector3());","            var rcUp = new THREE.Raycaster(origin, new THREE.Vector3(0, 0, 1), 0.001, gap);","            var _crLr = scene.getLayer('');","            var _crLr3d = _crLr && _crLr.getRenderer ? _crLr.getRenderer() : null;","            var _crScene = _crLr3d ? (_crLr3d._threeScene || _crLr3d.threeScene || (_crLr3d.getThreeScene ? _crLr3d.getThreeScene() : null)) : null;","            if (!_crScene) return {canStop: true, hit: null};","            var hits = rcUp.intersectObjects(_crScene.children, true);","            // Ignore objects currently holstered (VrBodyZones or VrHolster): they sit in the","            // head/body zone and would otherwise falsely block standing up. Mirrors the laser","            // raycast's skipMeshes pattern.","            var _crSkip = new Set();","            if (gdjs._webxrVrGrabbableRegistry) {","                for (var _cgi = 0; _cgi < gdjs._webxrVrGrabbableRegistry.length; _cgi++) {","                    var _cge = gdjs._webxrVrGrabbableRegistry[_cgi];","                    if (_cge.beh && _cge.beh._holsterEntry && _cge.beh._holsterEntry.occupant) {","                        var _cgm = _cge.obj.get3DRendererObject ? _cge.obj.get3DRendererObject() : null;","                        if (_cgm) _cgm.traverse(function(ch) { if (ch.isMesh) _crSkip.add(ch); });","                    }","                }","            }","            var firstHit = null;","            for (var _hi = 0; _hi < hits.length; _hi++) {","                if ((!gdjs._webxrHitIsController || !gdjs._webxrHitIsController(hits[_hi])) && !_crSkip.has(hits[_hi].object)) {","                    firstHit = hits[_hi]; break;","                }","            }","            return {canStop: !firstHit, hit: firstHit || null};","        } catch(e) { return {canStop: true, hit: null}; }","    };","}","eventsFunctionContext.returnValue = beh ? gdjs._webxrCanStopCrouching(beh, runtimeScene).canStop : true;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the uniform scale applied to the physics body when crouching (all axes). Default: 0.5 (half size). Change takes effect on the next StartCrouching call.","fullName":"Set crouch scale","functionType":"Action","group":"Crouch","name":"SetCrouchScale","sentence":"Set crouch body scale of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Scale\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setCrouchScale) beh._setCrouchScale(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Uniform scale factor applied to all axes (e.g. 0.5 = 50% of original size)","name":"Scale","type":"expression"}],"objectGroups":[]},{"description":"Uniform scale applied to the physics body when crouching (0.5 = half size on all axes).","fullName":"Crouch scale","functionType":"ExpressionAndCondition","group":"Crouch","name":"CrouchScale","sentence":"crouch body scale of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getCrouchScale ? Number(beh._getCrouchScale()) : 0.5;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the fraction of real headset height the camera descends to while crouching. 0.5 = camera at 50% of standing height. Change takes effect on the next StartCrouching call.","fullName":"Set crouch height factor","functionType":"Action","group":"Crouch","name":"SetCrouchHeightFactor","sentence":"Set crouch height factor of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Factor\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setCrouchHeightFactor) beh._setCrouchHeightFactor(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Height factor (0.5 = camera at 50% of standing headset height)","name":"Factor","type":"expression"}],"objectGroups":[]},{"description":"Fraction of real headset height the camera descends to while crouching (0.5 = camera at 50% of standing height).","fullName":"Crouch height factor","functionType":"ExpressionAndCondition","group":"Crouch","name":"CrouchHeightFactor","sentence":"crouch height factor of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getCrouchHeightFactor ? Number(beh._getCrouchHeightFactor()) : 0.5;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set a fixed in-game player height for seated play. The rig is shifted so the camera appears at this height above the floor regardless of real headset position. Pass 0 to disable and use the real headset height. Example: 170 for 1.7 m at worldScale 100.","fullName":"Set virtual height","functionType":"Action","group":"Seated mode","name":"SetVirtualHeight","sentence":"Set virtual height of _PARAM0_ to _PARAM2_ game units (0 = disabled)","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Height\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setVirtualHeight) beh._setVirtualHeight(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Virtual height in game units (0 to use real headset height)","name":"Height","type":"expression"}],"objectGroups":[]},{"description":"True when a virtual height override is active (VirtualHeight > 0). Use this to check if seated mode is enabled.","fullName":"Virtual height enabled","functionType":"Condition","group":"Seated mode","name":"IsVirtualHeightEnabled","sentence":"_PARAM0_ virtual height override is active","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var h = beh && beh._getVirtualHeight ? Number(beh._getVirtualHeight()) : 0;","eventsFunctionContext.returnValue = h > 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Current virtual height setting in game units. Returns 0 when disabled (real headset height is used).","fullName":"Virtual height","functionType":"ExpressionAndCondition","group":"Seated mode","name":"VirtualHeight","sentence":"virtual height of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getVirtualHeight ? Number(beh._getVirtualHeight()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Effective in-game player height: returns VirtualHeight if seated mode is active, otherwise the real headset height. Useful for gameplay that needs to know the player's apparent in-game height regardless of which mode is active.","fullName":"Effective height","functionType":"ExpressionAndCondition","group":"Seated mode","name":"EffectiveHeight","sentence":"effective headset height of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!beh) { eventsFunctionContext.returnValue = 0; } else {","    var h = beh._getVirtualHeight ? Number(beh._getVirtualHeight()) : 0;","    eventsFunctionContext.returnValue = h > 0 ? h : (beh._headsetHeight || 0);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Current movement heading in degrees in GDevelop space (same convention as Player.Angle and SetForwardAngle). Pass this to Physics3D::PhysicsCharacter3D::SetForwardAngle each frame so movement aligns with the head, with a deadzone buffer that lets the player glance sideways without changing course. In Off mode returns the object angle directly (legacy body-relative behavior).","fullName":"Movement forward angle","functionType":"ExpressionAndCondition","group":"Locomotion","name":"MovementForwardAngle","sentence":"movement forward angle of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!beh) { eventsFunctionContext.returnValue = 0; } else {","    var _mvMode = beh._getMovementDirectionMode ? beh._getMovementDirectionMode() : 'Head';","    if (_mvMode === 'Off') {","        eventsFunctionContext.returnValue = objs[0].getAngle();","    } else if (_mvMode === 'Controller') {","        var _mvHand = (beh._getMovementControllerHand ? beh._getMovementControllerHand() : 'left').toLowerCase();","        var _mvCtrl = gdjs._webxrVrControllers ? gdjs._webxrVrControllers[_mvHand] : null;","        eventsFunctionContext.returnValue = (_mvCtrl && _mvCtrl.gdObject) ? _mvCtrl.gdObject.getAngle() : (beh._torsoYaw != null ? beh._torsoYaw : objs[0].getAngle());","    } else {","        eventsFunctionContext.returnValue = beh._torsoYaw != null ? beh._torsoYaw : objs[0].getAngle();","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Signed angle in degrees between the head's facing and the current movement heading. Positive when the head is turned counter-clockwise (left) relative to movement, negative when turned clockwise (right). Useful for debugging or driving lean and tilt effects.","fullName":"Head to movement yaw offset","functionType":"ExpressionAndCondition","group":"Locomotion","name":"HeadBodyYawOffset","sentence":"head-to-movement yaw offset of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!beh) { eventsFunctionContext.returnValue = 0; } else {","    var _headPa = -(beh._headYaw || 0);","    var _mvYaw = beh._torsoYaw != null ? beh._torsoYaw : objs[0].getAngle();","    eventsFunctionContext.returnValue = ((_headPa - _mvYaw) % 360 + 540) % 360 - 180;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Current virtual-torso yaw in degrees (Player.Angle convention). This is the head-driven, deadzone-leashed body heading shared by holsters, body-relative followers, and head-relative movement. Useful for diagnostics or driving lean and tilt effects. Returns Player.Angle when the torso has not been initialized yet.","fullName":"Body yaw","functionType":"ExpressionAndCondition","group":"Locomotion","name":"BodyYaw","sentence":"body yaw of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!beh) { eventsFunctionContext.returnValue = 0; } else {","    eventsFunctionContext.returnValue = beh._torsoYaw != null ? beh._torsoYaw : objs[0].getAngle();","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the forward-direction mode used by MovementForwardAngle(). Head: movement follows the virtual-torso yaw (deadzone-leashed head direction). Controller: movement follows the facing of the chosen hand. Off: movement follows Player.Angle directly (legacy). Takes effect on the next frame.","fullName":"Set movement direction mode","functionType":"Action","group":"Locomotion","name":"SetMovementDirectionMode","sentence":"Set movement direction mode of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = eventsFunctionContext.getArgument(\"Mode\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setMovementDirectionMode) beh._setMovementDirectionMode(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Mode (Head, Controller, or Off)","name":"Mode","supplementaryInformation":"[\"Head\",\"Controller\",\"Off\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"Returns the current movement direction mode (\"Head\", \"Controller\", or \"Off\"). As a condition, compares it to the given value.","fullName":"Movement direction mode","functionType":"ExpressionAndCondition","group":"Locomotion","name":"MovementDirectionMode","sentence":"movement direction mode of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getMovementDirectionMode ? String(beh._getMovementDirectionMode()) : 'Head';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the body yaw deadzone in degrees. The head can turn this many degrees away from the virtual-torso heading before the torso is pulled along. 0 = instant tracking; 30-45 is comfortable. Governs holsters, body-relative followers, and Head-mode movement. Takes effect on the next frame.","fullName":"Set body yaw deadzone","functionType":"Action","group":"Locomotion","name":"SetBodyYawDeadzone","sentence":"Set body yaw deadzone of _PARAM0_ to _PARAM2_ degrees","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Deadzone\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setBodyYawDeadzone) beh._setBodyYawDeadzone(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Deadzone in degrees (0 = instant torso tracking, 30-45 is comfortable)","name":"Deadzone","type":"expression"}],"objectGroups":[]},{"description":"Body yaw deadzone in degrees. The head can turn this many degrees away from the virtual-torso heading before the torso is pulled along. 0 = instant tracking.","fullName":"Body yaw deadzone","functionType":"ExpressionAndCondition","group":"Locomotion","name":"BodyYawDeadzone","sentence":"body yaw deadzone of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getBodyYawDeadzone ? Number(beh._getBodyYawDeadzone()) : 30;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the maximum rate in degrees per second at which the virtual-torso heading catches up once the head exceeds the deadzone. 0 = snap instantly to the deadzone edge. Use a low value such as 60 for a gentler transition. Takes effect on the next frame.","fullName":"Set body yaw smoothing","functionType":"Action","group":"Locomotion","name":"SetBodyYawSmoothing","sentence":"Set body yaw smoothing of _PARAM0_ to _PARAM2_ degrees per second","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Smoothing\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setBodyYawSmoothing) beh._setBodyYawSmoothing(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Smoothing in degrees per second (0 = snap, 60 = gentle)","name":"Smoothing","type":"expression"}],"objectGroups":[]},{"description":"Maximum rate in degrees per second at which the virtual-torso heading catches up once the head exceeds the deadzone. 0 = instant snap.","fullName":"Body yaw smoothing","functionType":"ExpressionAndCondition","group":"Locomotion","name":"BodyYawSmoothing","sentence":"body yaw smoothing of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getBodyYawSmoothing ? Number(beh._getBodyYawSmoothing()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set which hand's facing direction drives movement when MovementDirectionMode is Controller. Left is recommended as the locomotion thumbstick is typically on the left controller. Takes effect on the next frame.","fullName":"Set movement controller hand","functionType":"Action","group":"Locomotion","name":"SetMovementControllerHand","sentence":"Set movement controller hand of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = eventsFunctionContext.getArgument(\"Hand\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setMovementControllerHand) beh._setMovementControllerHand(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Hand (left or right)","name":"Hand","supplementaryInformation":"[\"left\",\"right\"]","type":"stringWithSelector"}],"objectGroups":[]},{"description":"Returns the current movement controller hand (\"left\" or \"right\"). Only relevant when MovementDirectionMode is Controller. As a condition, compares it to the given value.","fullName":"Movement controller hand","functionType":"ExpressionAndCondition","group":"Locomotion","name":"MovementControllerHand","sentence":"movement controller hand of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getMovementControllerHand ? String(beh._getMovementControllerHand()) : 'left';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the +Y (right) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox +Y (right)","functionType":"Action","group":"Skybox","name":"SetSkyboxRight","sentence":"Set VR skybox +Y (right) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxRight) beh._setSkyboxRight(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the +Y (right) direction.","fullName":"Skybox +Y (right)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxRight","sentence":"VR skybox +Y (right) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxRight ? String(beh._getSkyboxRight()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the -Y (left) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox -Y (left)","functionType":"Action","group":"Skybox","name":"SetSkyboxLeft","sentence":"Set VR skybox -Y (left) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxLeft) beh._setSkyboxLeft(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the -Y (left) direction.","fullName":"Skybox -Y (left)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxLeft","sentence":"VR skybox -Y (left) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxLeft ? String(beh._getSkyboxLeft()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the +Z (top) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox +Z (top)","functionType":"Action","group":"Skybox","name":"SetSkyboxTop","sentence":"Set VR skybox +Z (top) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxTop) beh._setSkyboxTop(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the +Z (top) direction.","fullName":"Skybox +Z (top)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxTop","sentence":"VR skybox +Z (top) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxTop ? String(beh._getSkyboxTop()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the -Z (bottom) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox -Z (bottom)","functionType":"Action","group":"Skybox","name":"SetSkyboxBottom","sentence":"Set VR skybox -Z (bottom) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxBottom) beh._setSkyboxBottom(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the -Z (bottom) direction.","fullName":"Skybox -Z (bottom)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxBottom","sentence":"VR skybox -Z (bottom) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxBottom ? String(beh._getSkyboxBottom()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the +X (front) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox +X (front)","functionType":"Action","group":"Skybox","name":"SetSkyboxFront","sentence":"Set VR skybox +X (front) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxFront) beh._setSkyboxFront(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the +X (front) direction.","fullName":"Skybox +X (front)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxFront","sentence":"VR skybox +X (front) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxFront ? String(beh._getSkyboxFront()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]},{"description":"Set the VR skybox image used for the -X (back) direction. Takes effect from the next frame (the cube texture is rebuilt automatically). See the Skybox +X (front) property for the orientation convention.","fullName":"Set skybox -X (back)","functionType":"Action","group":"Skybox","name":"SetSkyboxBack","sentence":"Set VR skybox -X (back) of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setSkyboxBack) beh._setSkyboxBack(v);","}","// Invalidate the cached VR cube texture so the next VR frame rebuilds it","// from the updated property values (see VrHeadAnchor.doStepPostEvents).","gdjs._webxrVrSkyCubeTexture = null;","gdjs._webxrVrSkyTrappedScenes = null;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"},{"description":"Image resource name","name":"Value","type":"string"}],"objectGroups":[]},{"description":"VR skybox image resource name currently used for the -X (back) direction.","fullName":"Skybox -X (back)","functionType":"ExpressionAndCondition","group":"Skybox","name":"SkyboxBack","sentence":"VR skybox -X (back) of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getSkyboxBack ? String(beh._getSkyboxBack()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrHeadAnchor","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"doStepPostEvents"},{"functionName":"HeadsetHeight"},{"folderName":"Crouch","children":[{"functionName":"StartCrouching"},{"functionName":"StopCrouching"},{"functionName":"IsCrouching"},{"functionName":"CanStopCrouching"},{"functionName":"SetCrouchScale"},{"functionName":"CrouchScale"},{"functionName":"SetCrouchHeightFactor"},{"functionName":"CrouchHeightFactor"}]},{"folderName":"Seated mode","children":[{"functionName":"SetVirtualHeight"},{"functionName":"IsVirtualHeightEnabled"},{"functionName":"VirtualHeight"},{"functionName":"EffectiveHeight"}]},{"functionName":"HeadYaw"},{"functionName":"HeadPitch"},{"functionName":"HeadRoll"},{"folderName":"Locomotion","children":[{"functionName":"SetMovementDirectionMode"},{"functionName":"MovementDirectionMode"},{"functionName":"SetBodyYawDeadzone"},{"functionName":"BodyYawDeadzone"},{"functionName":"SetBodyYawSmoothing"},{"functionName":"BodyYawSmoothing"},{"functionName":"SetMovementControllerHand"},{"functionName":"MovementControllerHand"},{"functionName":"MovementForwardAngle"},{"functionName":"HeadBodyYawOffset"},{"functionName":"BodyYaw"}]},{"folderName":"Skybox","children":[{"functionName":"SetSkyboxRight"},{"functionName":"SkyboxRight"},{"functionName":"SetSkyboxLeft"},{"functionName":"SkyboxLeft"},{"functionName":"SetSkyboxTop"},{"functionName":"SkyboxTop"},{"functionName":"SetSkyboxBottom"},{"functionName":"SkyboxBottom"},{"functionName":"SetSkyboxFront"},{"functionName":"SkyboxFront"},{"functionName":"SetSkyboxBack"},{"functionName":"SkyboxBack"}]}]},"propertyDescriptors":[{"value":"0.5","type":"Number","label":"Crouch scale — uniform all axes (0.5 = 50% of standing size)","description":"Uniform scale applied to the physics body when crouching. 0.5 = half size on all axes. Range 0.1–0.9.","group":"Crouch","name":"CrouchScale"},{"value":"0.5","type":"Number","label":"Crouch height factor (0.5 = camera at 50% of standing height)","description":"Fraction of real headset height the camera descends to when crouching. 0.5 = camera at half standing height.","group":"Crouch","name":"CrouchHeightFactor"},{"value":"0","type":"Number","label":"Virtual height in game units (0 = use real headset height)","description":"Set a fixed in-game player height regardless of real headset height. Useful for seated players. 0 disables the override. Example: 170 for 1.7 m at worldScale 100.","group":"Seated mode","name":"VirtualHeight"},{"value":"Head","type":"Choice","label":"Movement direction mode","description":"Controls the forward direction used by MovementForwardAngle(). Head: move toward the virtual-torso heading (same heading that drives holsters and body-relative followers, deadzone-leashed to head yaw). Controller: move toward where the chosen hand points. Off: movement follows Player.Angle directly (legacy). Requires SetForwardAngle called each frame using MovementForwardAngle(). Note: the virtual-torso yaw (and therefore holsters) is always computed regardless of this setting.","group":"Locomotion","choices":[{"label":"Head","value":"Head"},{"label":"Controller","value":"Controller"},{"label":"Off","value":"Off"}],"name":"MovementDirectionMode"},{"value":"30","type":"Number","label":"Body yaw deadzone (degrees, 0 = instant head tracking)","description":"How many degrees the head can turn away from the virtual-torso heading before the torso is pulled along. Governs holsters (VrBodyZones body zones), body-relative followers (VrFollower AnchorYaw), and head-relative movement (Head mode). 0 = instant: the torso always matches the head. 45 is a comfortable default that lets the player glance sideways or look down at a hip holster without moving it.","group":"Locomotion","name":"BodyYawDeadzone"},{"value":"0","type":"Number","label":"Body yaw smoothing (degrees per second, 0 = snap)","description":"Maximum rate in degrees per second at which the virtual-torso heading catches up once the head exceeds the deadzone. 0 = instant snap to the deadzone edge. Use a low value such as 60 for a gentler transition.","group":"Locomotion","name":"BodyYawSmoothing"},{"value":"left","type":"Choice","label":"Movement controller hand (Controller mode only)","description":"Which hand's facing direction drives movement when MovementDirectionMode is Controller. Left is recommended as the locomotion thumbstick is typically on the left controller.","group":"Locomotion","choices":[{"label":"left","value":"left"},{"label":"right","value":"right"}],"name":"MovementControllerHand"},{"value":"SkyboxRight.png","type":"Resource","label":"Skybox +Y (right)","description":"Sky image used in VR for the +Y direction. See Skybox +X (front) for the orientation convention.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxRight"},{"value":"SkyboxLeft.png","type":"Resource","label":"Skybox -Y (left)","description":"Sky image used in VR for the -Y direction. See Skybox +X (front) for the orientation convention.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxLeft"},{"value":"SkyboxTop.png","type":"Resource","label":"Skybox +Z (top)","description":"Sky image used in VR for the +Z (up) direction. See Skybox +X (front) for the orientation convention.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxTop"},{"value":"SkyboxBottom.png","type":"Resource","label":"Skybox -Z (bottom)","description":"Sky image used in VR for the -Z (down) direction. See Skybox +X (front) for the orientation convention.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxBottom"},{"value":"SkyboxFront.png","type":"Resource","label":"Skybox +X (front)","description":"Sky image used in VR for the +X direction (the direction faced at Angle=0). GDevelop world axes (front=+X; back=-X; right=+Y; left=-Y; top=+Z, zenith/up; bottom=-Z, nadir/down). Point these at the same six images used by a Scene3D::Skybox layer effect (if you have one) and the VR sky will match flat preview -- the effect's own face-slot names map to different axes internally (a known GDevelop quirk, see project notes), but the actual image content per direction is the same. Change this to use a custom sky in VR; all six faces should come from the same matching set.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxFront"},{"value":"SkyboxBack.png","type":"Resource","label":"Skybox -X (back)","description":"Sky image used in VR for the -X direction. See Skybox +X (front) for the orientation convention.","group":"Skybox","extraInformation":["image"],"choices":[],"name":"SkyboxBack"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"folderName":"Crouch","children":[{"propertyName":"CrouchScale"},{"propertyName":"CrouchHeightFactor"}]},{"folderName":"Seated mode","children":[{"propertyName":"VirtualHeight"}]},{"folderName":"Locomotion","children":[{"propertyName":"MovementDirectionMode"},{"propertyName":"BodyYawDeadzone"},{"propertyName":"BodyYawSmoothing"},{"propertyName":"MovementControllerHand"}]},{"folderName":"Skybox","children":[{"propertyName":"SkyboxRight"},{"propertyName":"SkyboxLeft"},{"propertyName":"SkyboxTop"},{"propertyName":"SkyboxBottom"},{"propertyName":"SkyboxFront"},{"propertyName":"SkyboxBack"}]}]}},{"description":"Track and control a VR controller (left or right hand). Provides button input, thumbstick data, position, rotation, and linear and angular velocity tracking. Supports proximity grab with grip button and magnetic ray-based targeting. Requires VrHeadAnchor behavior on another object in the scene.","fullName":"VR controller tracker (WebXR)","helpPath":"","iconUrl":"","name":"VrController","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    var controllers = gdjs._webxrVrControllers;","    if (!controllers) { beh._vrGrip = null; continue; }","    var handedness = beh._getHandedness();","    var entry = controllers[handedness];","    if (entry && entry.grip) {","        beh._vrGrip = entry.grip;","    } else {","        beh._vrGrip = null;","    }","    if (entry) entry.gdObject = obj;","    if (entry) entry.vrBeh = beh;","    beh._magneticGrabActive = (beh._getMagneticGrabEnabled && (beh._getMagneticGrabEnabled() === 'true' || beh._getMagneticGrabEnabled() === true));","    // The model-space correction is derived only from the design-time mesh orientation","    // (captured below, deferred until the GLB has finished loading) plus the","    // RotationOffset property, so it is deterministic and needs no cross-scene","    // persistence - it is simply recomputed fresh every scene.","    beh._qMeshInit = null;","    beh._qMeshInitCaptured = false;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var anchor = gdjs._webxrVrAnchor;","if (!anchor) return;","if (anchor.runtimeScene !== runtimeScene) return;","","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","","    var handedness = beh._getHandedness();","","    var entry = controllers[handedness];","    if (entry && entry.connected) {","        beh._vrGrip = entry.grip;","        beh._vrRay  = entry.ray;","    } else {","        beh._vrGrip = null;","        beh._vrRay  = null;","    }","    // Deferred _qMeshInit capture: read from actual Three.js mesh once it's ready.","    if (!beh._qMeshInitCaptured) {","        var threeObjInit = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","        if (threeObjInit && threeObjInit.quaternion) {","            var _qiPre = threeObjInit.quaternion;","            if (Math.abs(_qiPre.x) + Math.abs(_qiPre.y) + Math.abs(_qiPre.z) > 0.001) {","                beh._qMeshInit = _qiPre.clone();","                beh._qMeshInitCaptured = true;","            }","            if (!gdjs._webxrVrControllerMeshes) gdjs._webxrVrControllerMeshes = new Set();","            gdjs._webxrVrControllerMeshes.add(threeObjInit);","            beh._qMesh = threeObjInit;","            if (!gdjs._webxrHitIsController) {","                gdjs._webxrHitIsController = function(hit) {","                    return !!(hit && hit.object && hit.object.userData && hit.object.userData.vrController);","                };","            }","        }","    }","    // Mark every descendant of the controller model so raycasts reliably skip them.","    // Belt-and-suspenders: disable the raycast method (prevents hit detection) AND","    // set userData.vrController (checked in hit loops, independent of parent chain).","    // Re-runs each frame until mesh count stabilises to handle async GLB loading.","    if (beh._qMesh && !beh._controllerRaycastReady) {","        var _noRcFn = function(){};","        var _prevMc = beh._controllerMeshCount || 0;","        var _mc = 0;","        beh._qMesh.frustumCulled = false;","        beh._qMesh.traverse(function(ch) {","            ch.userData.vrController = true;","            ch.frustumCulled = false;","            if (ch.isMesh) { ch.raycast = _noRcFn; _mc++; }","        });","        beh._controllerMeshCount = _mc;","        if (_mc > 0 && _mc === _prevMc) beh._controllerRaycastReady = true;","    }","","    beh._prevButtons = beh._curButtons || {};","    var gamepad = null;","    var _sess = tr.xr.getSession ? tr.xr.getSession() : null;","    if (_sess && _sess.inputSources) {","        for (var _si = 0; _si < _sess.inputSources.length; _si++) {","            var _src = _sess.inputSources[_si];","            if (_src.handedness === handedness && _src.gamepad) {","                gamepad = _src.gamepad;","                break;","            }","        }","    }","    if (gamepad) {","        var btns = gamepad.buttons;","        beh._curButtons = {","            trigger:    btns[0] ? btns[0].value > 0.5 : false,","            grip:       btns[1] ? btns[1].value > 0.5 : false,","            thumbstick: btns[3] ? btns[3].pressed : false,","            primary:    btns[4] ? btns[4].pressed : false,","            secondary:  btns[5] ? btns[5].pressed : false,","            menu:       btns[6] ? btns[6].pressed : false","        };","        beh._triggerValue = btns[0] ? btns[0].value : 0;","        beh._gripValue    = btns[1] ? btns[1].value : 0;","        beh._joyX = (gamepad.axes.length > 2) ? gamepad.axes[2] : 0;","        beh._joyY = (gamepad.axes.length > 3) ? gamepad.axes[3] : 0;","        beh._connected = true;","    } else {","        beh._curButtons = {};","        beh._triggerValue = 0;","        beh._gripValue = 0;","        beh._joyX = 0;","        beh._joyY = 0;","        beh._connected = false;","    }","","    var entry2 = controllers[handedness];","    if (entry2) entry2.vrBeh = beh;","    // Re-read property each frame (getter may not be ready at onCreated time)","    if (beh._getMagneticGrabEnabled) {","        beh._magneticGrabActive = (beh._getMagneticGrabEnabled() === 'true' || beh._getMagneticGrabEnabled() === true);","    }","    if (entry2) { entry2._magneticGrabActive = beh._magneticGrabActive; entry2._magneticGrabLength = beh._getMagneticGrabLength ? Number(beh._getMagneticGrabLength()) : 1000; entry2._laserPitchOffset = beh._getLaserPitchOffset ? Number(beh._getLaserPitchOffset()) || 0 : 0; entry2._magneticGrabErrorTolerance = beh._getMagneticGrabErrorTolerance ? Number(beh._getMagneticGrabErrorTolerance()) || 0 : 0;","        var _tlRaw = beh._getTargetingRayLength ? Number(beh._getTargetingRayLength()) : 0;","        var _tlLaser = beh._getLaserLength ? Number(beh._getLaserLength()) : 5000;","        if (!(_tlLaser > 0)) _tlLaser = 5000;","        entry2._targetingRayLength = (_tlRaw > 0) ? _tlRaw : _tlLaser;","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var anchor = gdjs._webxrVrAnchor;","if (!anchor) return;","if (anchor.runtimeScene !== runtimeScene) return;","","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","","    var handedness = beh._getHandedness();","","    var entry = controllers[handedness];","    if (entry && entry.connected) {","        beh._vrGrip = entry.grip;","        beh._vrRay  = entry.ray;","    } else {","        beh._vrGrip = null;","        beh._vrRay  = null;","    }","","    // Deferred _qMeshInit capture: read from actual Three.js mesh once it's ready.","    if (!beh._qMeshInitCaptured) {","        var threeObjInit = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","        if (threeObjInit && threeObjInit.quaternion) {","            var _qiPost = threeObjInit.quaternion;","            if (Math.abs(_qiPost.x) + Math.abs(_qiPost.y) + Math.abs(_qiPost.z) > 0.001) {","                beh._qMeshInit = _qiPost.clone();","                beh._qMeshInitCaptured = true;","            }","        }","    }","","    // Position update: done here (postEvents) so the rig is already updated for this frame.","    if (beh._vrGrip) {","        var wp = new THREE.Vector3();","        beh._vrGrip.getWorldPosition(wp);","        // Apply controller-local offset (for model alignment fine-tuning)","        var offX = beh._getOffsetX ? Number(beh._getOffsetX()) : 0;","        var offY = beh._getOffsetY ? Number(beh._getOffsetY()) : 0;","        var offZ = beh._getOffsetZ ? Number(beh._getOffsetZ()) : 0;","        if (offX !== 0 || offY !== 0 || offZ !== 0) {","            var localOff = new THREE.Vector3(offX, offY, -offZ);","            var wqOff = new THREE.Quaternion();","            beh._vrGrip.getWorldQuaternion(wqOff);","            localOff.applyQuaternion(wqOff);","            wp.add(localOff);","        }","        // Keep hand anchor at the adjusted position so VrGrabbable/VrClimbable/VrInteractable","        // share the same reference point as the visual model.","        var entry2pre = controllers[handedness];","        var ha = entry2pre && entry2pre.handAnchor;","        if (ha) {","            var _haWs = gdjs._webxrVrWorldScale || 100;","            ha.position.set(offX / _haWs, offY / _haWs, -offZ / _haWs);","        }","        // Publish adjusted position for other behaviors (VrGrabbable, VrInteractable, VrClimbable)","        if (entry2pre) { entry2pre._adjustedWP = wp.clone(); }","        var dx = wp.x - anchor.threeX;","        var dy = wp.y - anchor.threeY;","        var dz = wp.z - anchor.threeZ;","        obj.setX(anchor.x + dx);","        obj.setY(anchor.y - dy);","        obj.setZ(anchor.z + dz);","    }","","    // === Throw/launch debug (gated by gdjs._webxrDebugThrow) ===","    gdjs._webxrRtSceneRef = runtimeScene;","    if (typeof gdjs._webxrDebugThrow === 'undefined') gdjs._webxrDebugThrow = true;","    if (!gdjs._webxrDebugLines) gdjs._webxrDebugLines = {};","    if (!gdjs._webxrDbgFn) {","        gdjs._webxrDbgFn = function(key, text) {","            if (!gdjs._webxrDebugThrow || !gdjs._webxrRtSceneRef) return;","            gdjs._webxrDebugLines[key] = text;","            var _o=['track.L','track.R','throw.enter','throw.cond','throw','throw.hist','throw.rb','throw.post','launch','launch.rb'];","            var _s = [];","            for (var _i = 0; _i < _o.length; _i++) {","                if (gdjs._webxrDebugLines[_o[_i]]) _s.push(gdjs._webxrDebugLines[_o[_i]]);","            }","            try { gdjs._webxrRtSceneRef.getGame().getVariables().get('VrDebug').setString(_s.join('\\n')); } catch(e) {}","        };","    }","    if (!gdjs._webxrThrowVelFromHistory) {","        gdjs._webxrThrowVelFromHistory = function(vh, now, windowMs) {","            if (!vh || vh.length === 0) return {x:0, y:0, z:0, n:0};","            var _pk = null, _pkSq = -1, _pkT = 0;","            for (var _ti = 0; _ti < vh.length; _ti++) {","                var _age = now - vh[_ti].t;","                if (_age < 20 || _age > windowMs) continue;","                var _s = vh[_ti].vx*vh[_ti].vx + vh[_ti].vy*vh[_ti].vy + vh[_ti].vz*vh[_ti].vz;","                if (_s > _pkSq) { _pkSq = _s; _pk = vh[_ti]; _pkT = vh[_ti].t; }","            }","            if (!_pk) {","                var _sx=0,_sy=0,_sz=0,_n=0;","                for (var _tj = vh.length - 1; _tj >= 0 && _n < 3; _tj--) {","                    if (now - vh[_tj].t < 20) continue;","                    _sx += vh[_tj].vx; _sy += vh[_tj].vy; _sz += vh[_tj].vz; _n++;","                }","                return _n > 0 ? {x:_sx/_n, y:_sy/_n, z:_sz/_n, n:_n} : {x:0, y:0, z:0, n:0};","            }","            var _half = 45;","            var _ax=0,_ay=0,_az=0,_an=0;","            for (var _tk = 0; _tk < vh.length; _tk++) {","                if (Math.abs(vh[_tk].t - _pkT) > _half) continue;","                if (now - vh[_tk].t < 20) continue;","                _ax += vh[_tk].vx; _ay += vh[_tk].vy; _az += vh[_tk].vz; _an++;","            }","            if (_an === 0) return {x:_pk.vx, y:_pk.vy, z:_pk.vz, n:1};","            return {x:_ax/_an, y:_ay/_an, z:_az/_an, n:_an};","        };","    }","    // === Velocity tracking (time-stamped, units/sec, 200ms window) ===","    var dt = runtimeScene.getTimeManager().getElapsedTime() / 1000;","    if (dt <= 0) dt = 1/72;","    var curGdX = obj.getX(), curGdY = obj.getY(), curGdZ = obj.getZ();","    if (!beh._prevGdPos) beh._prevGdPos = {x: curGdX, y: curGdY, z: curGdZ};","    var dvx = (curGdX - beh._prevGdPos.x) / dt;","    var dvy = (curGdY - beh._prevGdPos.y) / dt;","    var dvz = (curGdZ - beh._prevGdPos.z) / dt;","    beh._prevGdPos = {x: curGdX, y: curGdY, z: curGdZ};","    if (!beh._velHistory) beh._velHistory = [];","    var now = performance.now();","    var _avx = 0, _avy = 0, _avz = 0;","    if (beh._vrGrip) {","        var _wqC = new THREE.Quaternion();","        beh._vrGrip.getWorldQuaternion(_wqC);","        if (!beh._prevGripQ) beh._prevGripQ = _wqC.clone();","        var _qd = _wqC.clone().multiply(beh._prevGripQ.clone().invert());","        var _qw = Math.max(-1, Math.min(1, _qd.w));","        var _ang = 2 * Math.acos(_qw);","        if (_ang > Math.PI) _ang -= 2 * Math.PI;","        var _sh = Math.sqrt(1 - _qw * _qw);","        if (_sh > 1e-5 && Math.abs(_ang) > 1e-5) {","            _avx = (_qd.x / _sh) * _ang / dt;","            _avy = (_qd.y / _sh) * _ang / dt;","            _avz = (_qd.z / _sh) * _ang / dt;","        }","        beh._prevGripQ = _wqC.clone();","    }","    var _spdSq = dvx*dvx + dvy*dvy + dvz*dvz;","    var _ok = isFinite(dvx) && isFinite(dvy) && isFinite(dvz) && dt >= 0.002 && _spdSq <= 4000*4000;","    if (_ok) beh._velHistory.push({vx: dvx, vy: dvy, vz: dvz, avx: _avx, avy: _avy, avz: _avz, t: now});","    // Prune samples older than 200ms; cap at 20 entries","    while (beh._velHistory.length > 0 && beh._velHistory[0].t < now - 200) beh._velHistory.shift();","    if (beh._velHistory.length > 20) beh._velHistory.shift();","    // Time-weighted average (linear decay over 200ms window) for publishing","    var wSumX = 0, wSumY = 0, wSumZ = 0, wSumAX = 0, wSumAY = 0, wSumAZ = 0, wTotal = 0;","    for (var vi = 0; vi < beh._velHistory.length; vi++) {","        var w = Math.max(0, 1 - (now - beh._velHistory[vi].t) / 200);","        wSumX += beh._velHistory[vi].vx * w; wSumY += beh._velHistory[vi].vy * w; wSumZ += beh._velHistory[vi].vz * w;","        wSumAX += beh._velHistory[vi].avx * w; wSumAY += beh._velHistory[vi].avy * w; wSumAZ += beh._velHistory[vi].avz * w;","        wTotal += w;","    }","    beh._velX = wTotal > 0 ? wSumX / wTotal : 0;","    beh._velY = wTotal > 0 ? wSumY / wTotal : 0;","    beh._velZ = wTotal > 0 ? wSumZ / wTotal : 0;","    beh._angVelX = wTotal > 0 ? wSumAX / wTotal : 0;","    beh._angVelY = wTotal > 0 ? -(wSumAY / wTotal) : 0;","    beh._angVelZ = wTotal > 0 ? wSumAZ / wTotal : 0;","    var entry2 = controllers[handedness];","    if (entry2) { entry2._velX = beh._velX; entry2._velY = beh._velY; entry2._velZ = beh._velZ; entry2._velHistory = beh._velHistory; entry2._angVelX = beh._angVelX; entry2._angVelY = beh._angVelY; entry2._angVelZ = beh._angVelZ; }","    beh._dbgCounter = (beh._dbgCounter || 0) + 1;","    if (beh._dbgCounter % 30 === 0) {","        gdjs._webxrDbgFn('track.' + (handedness === 'left' ? 'L' : 'R'),","            'T' + (handedness === 'left' ? 'L' : 'R') +","            ' inst=' + dvx.toFixed(0) + ',' + dvy.toFixed(0) + ',' + dvz.toFixed(0) +","            ' avg=' + beh._velX.toFixed(0) + ',' + beh._velY.toFixed(0) + ',' + beh._velZ.toFixed(0) +","            ' n=' + beh._velHistory.length);","    }","","    // === Quaternion / rotation / ray direction ===","    if (beh._vrGrip) {","        var wq = new THREE.Quaternion();","        beh._vrGrip.getWorldQuaternion(wq);","        beh._worldQuat = wq;","        // Apply the fixed model-space correction, then decompose in GDevelop's ZYX convention.","        // Y-conjugate wq to match the mesh's Y-flipped local frame (fixes inverted yaw/roll).","        var wqLocal = new THREE.Quaternion(-wq.x, wq.y, -wq.z, wq.w);","        var q_final = wqLocal.clone().multiply(gdjs._webxrControllerCorrection(beh));","        // Back-fill GDevelop API state first (setAngle etc. may internally update the mesh).","        var euler = new THREE.Euler().setFromQuaternion(q_final, 'ZYX');","        beh._rotX = euler.x * 180 / Math.PI;","        beh._rotY = euler.y * 180 / Math.PI;","        beh._rotZ = euler.z * 180 / Math.PI;","        obj.setAngle(euler.z * 180 / Math.PI);","        if (obj.setRotationX) obj.setRotationX(euler.x * 180 / Math.PI);","        if (obj.setRotationY) obj.setRotationY(euler.y * 180 / Math.PI);","        // Override the Three.js mesh quaternion directly to bypass any Euler round-trip errors.","        var threeObj = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","        if (threeObj) { threeObj.quaternion.copy(q_final); threeObj.updateMatrix(); }","        var rayQuat = new THREE.Quaternion();","        var raySrc = beh._vrRay || beh._vrGrip;","        raySrc.getWorldQuaternion(rayQuat);","        var pitchDeg = beh._getLaserPitchOffset ? Number(beh._getLaserPitchOffset()) || 0 : 0;","        if (pitchDeg !== 0) {","            rayQuat.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), pitchDeg * Math.PI / 180));","        }","        var fwd = new THREE.Vector3(0, 0, -1).applyQuaternion(rayQuat);","        beh._rayDirX = fwd.x; beh._rayDirY = -fwd.y; beh._rayDirZ = fwd.z;","        if (entry2) { entry2._worldQuat = wq; entry2._rayFwdDir = {x: fwd.x, y: fwd.y, z: fwd.z}; }","    } else {","        beh._rotX = beh._rotY = beh._rotZ = 0;","        beh._rayDirX = 0; beh._rayDirY = 0; beh._rayDirZ = -1;","    }","    if (entry2) { entry2._magneticGrabActive = beh._magneticGrabActive; entry2._magneticGrabLength = beh._getMagneticGrabLength ? Number(beh._getMagneticGrabLength()) : 1000; entry2._laserPitchOffset = beh._getLaserPitchOffset ? Number(beh._getLaserPitchOffset()) || 0 : 0; entry2._magneticGrabErrorTolerance = beh._getMagneticGrabErrorTolerance ? Number(beh._getMagneticGrabErrorTolerance()) || 0 : 0;","        var _tlRaw = beh._getTargetingRayLength ? Number(beh._getTargetingRayLength()) : 0;","        var _tlLaser = beh._getLaserLength ? Number(beh._getLaserLength()) : 5000;","        if (!(_tlLaser > 0)) _tlLaser = 5000;","        entry2._targetingRayLength = (_tlRaw > 0) ? _tlRaw : _tlLaser;","    }","    // === Targeting ray + laser beam ===","    var laserEnabled = beh._getLaserEnabled ? (beh._getLaserEnabled() === 'true' || beh._getLaserEnabled() === true) : false;","    var suppressed = (gdjs._webxrSuppressLaserUntil && gdjs._webxrSuppressLaserUntil[handedness] > performance.now());","    if (suppressed) laserEnabled = false;","    var stopAtGeom = beh._getLaserStopAtGeometry ? (beh._getLaserStopAtGeometry() === 'true' || beh._getLaserStopAtGeometry() === true) : true;","    var llen = beh._getLaserLength ? Number(beh._getLaserLength()) : 5000;","    if (!(llen > 0)) llen = 5000;","    var tlenRaw = beh._getTargetingRayLength ? Number(beh._getTargetingRayLength()) : 0;","    var tlen = (tlenRaw > 0) ? tlenRaw : llen;","    var drawVisual = laserEnabled && beh._vrGrip;","    var castRay = !!beh._vrGrip;","    if (drawVisual || castRay) {","        // (1) origin + orientation, computed independently of the laser line","        var lwp = new THREE.Vector3();","        (beh._vrRay || beh._vrGrip).getWorldPosition(lwp);","        var lwq = new THREE.Quaternion();","        (beh._vrRay || beh._vrGrip).getWorldQuaternion(lwq);","        var pitch = beh._getLaserPitchOffset ? Number(beh._getLaserPitchOffset()) : 0;","        if (pitch !== 0) {","            lwq.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(1, 0, 0), pitch * Math.PI / 180));","        }","        // reset hit data every active frame","        beh._laserHitDistance = -1;","        beh._laserHitPointThree = null;","        beh._laserHitThreeObject = null;","        beh._laserHitGdObject = null;","        // (2) scene reference, cached independently of the laser line","        var sceneRef = beh._laserScene;","        if (!sceneRef) {","            try {","                var llr = runtimeScene.getLayer('');","                var llr3d = llr.getRenderer ? llr.getRenderer() : null;","                if (llr3d) sceneRef = llr3d._threeScene || llr3d.threeScene || (llr3d.getThreeScene ? llr3d.getThreeScene() : null);","            } catch(e) {}","            beh._laserScene = sceneRef;","        }","        // (3) shared per-hand ray - feeds VrTargetable and all laser-hit expressions;","        // always runs when grip is present. See gdjs._webxrHandRayHits (onFirstSceneLoaded).","        if (castRay) {","            var _wsLaser = gdjs._webxrVrWorldScale || 100;","            var _laserNear = _wsLaser * 0.10;","            var _handHits = gdjs._webxrHandRayHits(runtimeScene, handedness);","            for (var hi = 0; hi < _handHits.length; hi++) {","                var _hh = _handHits[hi];","                if (_hh.distance < _laserNear || _hh.distance > tlen) continue;","                beh._laserHitDistance = _hh.distance;","                beh._laserHitPointThree = _hh.point;","                beh._laserHitThreeObject = _hh.threeObject;","                beh._laserHitGdObject = _hh.gdObject;","                break;","            }","        }","        // (4) visual beam + marker - only when laser is enabled and not suppressed","        if (drawVisual) {","            var _lc = (beh._getLaserColor ? String(beh._getLaserColor()) : '255;0;0').split(';');","            var lr2 = Math.max(0,Math.min(255,+_lc[0]||0))/255;","            var lg2 = Math.max(0,Math.min(255,+_lc[1]||0))/255;","            var lb2 = Math.max(0,Math.min(255,+_lc[2]||0))/255;","            var markerOn = beh._getLaserHitMarkerEnabled ? (beh._getLaserHitMarkerEnabled() === 'true' || beh._getLaserHitMarkerEnabled() === true) : true;","            var markerRad = beh._getLaserHitMarkerSize ? Number(beh._getLaserHitMarkerSize()) : 5;","            if (!(markerRad > 0)) markerRad = 5;","            if (!beh._laserLine) {","                var laserGeom = new THREE.BufferGeometry().setFromPoints([","                    new THREE.Vector3(0, 0, 0),","                    new THREE.Vector3(0, 0, -llen)","                ]);","                var laserMat = new THREE.LineBasicMaterial({ color: new THREE.Color(lr2, lg2, lb2) });","                beh._laserLine = new THREE.Line(laserGeom, laserMat);","                beh._laserLine.raycast = function() {};","                beh._laserLine.frustumCulled = false;","                if (sceneRef) { sceneRef.add(beh._laserLine); }","            }","            if (markerOn && !beh._laserHitMarker && beh._laserLine) {","                var mkGeom = new THREE.SphereGeometry(markerRad, 12, 12);","                var mkMat = new THREE.MeshBasicMaterial({ color: new THREE.Color(lr2, lg2, lb2), transparent: true, opacity: 0.5 });","                beh._laserHitMarker = new THREE.Mesh(mkGeom, mkMat);","                beh._laserHitMarker.raycast = function() {};","                beh._laserHitMarker.frustumCulled = false;","                beh._laserHitMarker.visible = false;","                beh._laserHitMarker._builtRadius = markerRad;","                beh._laserLine.add(beh._laserHitMarker);","            }","            if (beh._laserLine) {","                beh._laserLine.visible = true;","                if (beh._laserHitMarker) beh._laserHitMarker.visible = false;","                beh._laserLine.position.set(lwp.x, -lwp.y, lwp.z);","                beh._laserLine.quaternion.set(-lwq.x, lwq.y, -lwq.z, lwq.w);","                beh._laserLine.material.color.setRGB(lr2, lg2, lb2);","                var drawLen = (stopAtGeom && beh._laserHitDistance > 0 && beh._laserHitDistance <= llen) ? beh._laserHitDistance : llen;","                var posAttr = beh._laserLine.geometry.attributes.position;","                if (posAttr && posAttr.getZ(1) !== -drawLen) {","                    posAttr.setZ(1, -drawLen);","                    posAttr.needsUpdate = true;","                }","                if (beh._laserHitMarker) {","                    if (beh._laserHitMarker._builtRadius !== markerRad) {","                        beh._laserHitMarker.geometry.dispose();","                        beh._laserHitMarker.geometry = new THREE.SphereGeometry(markerRad, 12, 12);","                        beh._laserHitMarker._builtRadius = markerRad;","                    }","                    beh._laserHitMarker.material.color.setRGB(lr2, lg2, lb2);","                    beh._laserHitMarker.visible = markerOn && stopAtGeom && (beh._laserHitDistance > 0) && (beh._laserHitDistance <= llen);","                    if (beh._laserHitMarker.visible) beh._laserHitMarker.position.set(0, 0, -drawLen);","                }","                if (!markerOn && beh._laserHitMarker) {","                    beh._laserLine.remove(beh._laserHitMarker);","                    beh._laserHitMarker.geometry.dispose();","                    beh._laserHitMarker.material.dispose();","                    beh._laserHitMarker = null;","                }","            }","        } else if (beh._laserLine) {","            // laser off (or suppressed) but targeting ray still active - hide the visual only","            beh._laserLine.visible = false;","            if (beh._laserHitMarker) beh._laserHitMarker.visible = false;","        }","    } else {","        // no grip - clear hit data and tear down the laser line","        beh._laserHitDistance = -1;","        beh._laserHitPointThree = null;","        beh._laserHitThreeObject = null;","        if (beh._laserLine) {","            if (beh._laserHitMarker) {","                beh._laserHitMarker.geometry.dispose();","                beh._laserHitMarker.material.dispose();","                beh._laserHitMarker = null;","            }","            if (beh._laserScene) beh._laserScene.remove(beh._laserLine);","            beh._laserLine.geometry.dispose();","            beh._laserLine.material.dispose();","            beh._laserLine = null;","            beh._laserScene = null;","        }","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","senten