t\""]},{"type":{"value":"SceneVariablePushString"},"parameters":["__MazeGenerator.Directions","\"Right\""]},{"type":{"value":"SceneVariablePushString"},"parameters":["__MazeGenerator.Directions","\"Up\""]},{"type":{"value":"SceneVariablePushString"},"parameters":["__MazeGenerator.Directions","\"Down\""]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.numDirections","=","4"]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.Index","=","Variable(__MazeGenerator.FloorInProgress[Variable(__MazeGenerator.NumFloorInProgress)-1])"]},{"type":{"value":"SetSceneVariableAsBoolean"},"parameters":["__MazeGenerator.FloorTodo[Variable(__MazeGenerator.Index)]",""]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.PickDirection","=","0"]},{"type":{"value":"SetSceneVariableAsBoolean"},"parameters":["__MazeGenerator.FoundDirection",""]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Try each direction in a random order to see if maze can build in that direction (wall exists in that direction, next cell in that direction hasn't been completed yet)"},{"type":"BuiltinCommonInstructions::Repeat","repeatExpression":"4","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.PickDirection","=","RandomInRange(0,Variable(__MazeGenerator.numDirections)-1)"]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"The conditions to check for each direction are:\n1. Check the direction picked randomly, stored in Directions variable\n2. There is no wall in that direction, add continue with next floor in that direction\n3. Don't move to a space we have already visited before (FloorTodo array starts as true for all cells, goes to false once visited). This prevents the maze from being too easy by having too many ways to get to each cell in the maze\n4. Once a valid direction is found, skip all the other directions (FoundDirection is true once a direction is found). If the first direction it finds isn't valid, then the loop repeats again to try one of the other directions instead"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"VarSceneTxt"},"parameters":["__MazeGenerator.Directions[Variable(__MazeGenerator.PickDirection)]","=","\"Left\""]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator[GetArgumentAsString(\"MazeID\")].LeftWall[Variable(__MazeGenerator.Index)]","False"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator.FloorTodo[Variable(__MazeGenerator.Index)-1]","True"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator.FoundDirection","False"]}],"actions":[{"type":{"value":"SetSceneVariableAsBoolean"},"parameters":["__MazeGenerator.FoundDirection","True"]},{"type":{"value":"SceneVariablePushNumber"},"parameters":["__MazeGenerator.FloorInProgress","Variable(__MazeGenerator.Index)-1"]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.NumFloorInProgress","+","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"VarSceneTxt"},"parameters":["__MazeGenerator.Directions[Variable(__MazeGenerator.PickDirection)]","=","\"Right\""]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator[GetArgumentAsString(\"MazeID\")].RightWall[Variable(__MazeGenerator.Index)]","False"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator.FloorTodo[Variable(__MazeGenerator.Index)+1]","True"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator.FoundDirection","False"]}],"actions":[{"type":{"value":"SetSceneVariableAsBoolean"},"parameters":["__MazeGenerator.FoundDirection","True"]},{"type":{"value":"SceneVariablePushNumber"},"parameters":["__MazeGenerator.FloorInProgress","Variable(__MazeGenerator.Index)+1"]},{"type":{"value":"ModVarScene"},