nctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setMax) beh._setMax(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrInteractable","type":"behavior"},{"description":"Maximum value","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Maximum value for the interaction (degrees for Lever, scene units for Slider/Button)","fullName":"Maximum","functionType":"ExpressionAndCondition","group":"Configuration","name":"Max","sentence":"_PARAM0_ maximum","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getMax ? Number(beh._getMax()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrInteractable","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if this Button-type interactable is in toggle mode, 0 if it is momentary. Configured via the property editor.","fullName":"Toggle mode","functionType":"ExpressionAndCondition","group":"Configuration","name":"Toggle","sentence":"_PARAM0_ toggle mode","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getToggle ? beh._getToggle() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrInteractable","type":"behavior"}],"objectGroups":[]},{"description":"Set the maximum proximity distance in scene units for the grip to start interacting.","fullName":"Set grab range","functionType":"Action","group":"Configuration","name":"SetGrabRange","sentence":"Set grab range of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setGrabRange) beh._setGrabRange(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrInteractable","type":"behavior"},{"description":"Grab range in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Maximum proximity distance in scene units for the grip to start interacting","fullName":"Grab range","functionType":"ExpressionAndCondition","group":"Configuration","name":"GrabRange","sentence":"_PARAM0_ grab range","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getGrabRange ? Number(beh._getGrabRange()) || 50 : 50;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrInteractable","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"onDestroy"},{"functionName":"doStepPreEvents"},{"functionName":"doStepPostEvents"},{"folderName":"State","children":[{"functionName":"IsInteracting"},{"functionName":"IsAtMin"},{"functionName":"IsAtMax"},{"functionName":"GetValue"},{"functionName":"Lock"},{"functionName":"Unlock"}]},{"folderName":"Configuration","children":[{"functionName":"Type"},{"functionName":"Axis"},{"functionName":"SetMin"},{"functionName":"Min"},{"functionName":"SetMax"},{"functionName":"Max"},{"functionName":"Toggle"},{"functionName":"SetGrabRange"},{"functionName":"GrabRange"}]}]},"propertyDescriptors":[{"value":"Lever","type":"Choice","label":"Interaction type","description":"Lever rotates around the axis, Slider translates along it, Button presses along it","choices":[{"label":"Lever","value":"Lever"},{"label":"Slider","value":"Slider"},{"label":"Button","value":"Button"}],"name":"Type"},{"value":"Z","type":"Choice","label":"Interaction axis (object-local)","description":"The object-local axis the interaction is constrained to","choices":[{"label":"X","value":"X"},{"label":"Y","value":"Y"},{"label":"Z","value":"Z"}],"name":"Axis"},{"value":"0","type":"Number","label":"Minimum (degrees for Lever, scene units for Slider/Button)","description":"Physical lower bound of the interaction range","name":"Min"},{"value":"90","type":"Number","label":"Maximum (degrees for Lever, scene units for Slider/Button)","description":"Physical upper bound of the interaction range","name":"Max"},{"value":"false","type":"Boolean","label":"Toggle (Button type only)","description":"When true, pressing the button latches it at Max until pressed again","name":"Toggle"},{"value":"50","type":"Number","label":"Grab range (scene units)","description":"Maximum distance from the controller to the object origin to initiate interaction","name":"GrabRange"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"Type"},{"propertyName":"Axis"},{"propertyName":"Min"},{"propertyName":"Max"},{"propertyName":"Toggle"},{"propertyName":"GrabRange"}]}},{"description":"Make objects selectable and interactive with VR controller rays or proximity touch. When a controller's laser ray hits the object or controller physically touches it, the object becomes selected. Use IsSelected condition to detect interaction and trigger actions. Supports visual feedback without requiring Physics3D.","fullName":"VR Selectable (WebXR)","helpPath":"","iconUrl":"","name":"VrSelectable","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","if (!gdjs._webxrVrSelectableRegistry) gdjs._webxrVrSelectableRegistry = [];","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    beh._state = 'idle';","    beh._selectingHand = null;","    gdjs._webxrVrSelectableRegistry.push({obj: obj, beh: beh});","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    if (gdjs._webxrVrSelectableRegistry) {","        gdjs._webxrVrSelectableRegistry = gdjs._webxrVrSelectableRegistry.filter(function(e){ return e.obj !== obj; });","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var anchor = gdjs._webxrVrAnchor;","if (!anchor) return;","","// Helper: get controller GDevelop position","function _ctrlPos(hand) {","    var entry = controllers[hand];","    if (!entry || !entry.grip || !entry.connected) return null;","    var wp = entry._adjustedWP ? entry._adjustedWP.clone() : new THREE.Vector3();","    if (!entry._adjustedWP) entry.grip.getWorldPosition(wp);","    return { x: anchor.x + (wp.x - anchor.threeX), y: anchor.y - (wp.y - anchor.threeY), z: anchor.z + (wp.z - anchor.threeZ) };","}","","// Helper: check if a GDevelop-coord point is inside obj's AABB (center-based)","function _inAABB(px, py, pz, obj) {","    var hw = (obj.getWidth ? obj.getWidth() : 0) / 2;","    var hh = (obj.getHeight ? obj.getHeight() : 0) / 2;","    var hd = (obj.getDepth ? obj.getDepth() : 0) / 2;","    return px >= obj.getX() - hw && px <= obj.getX() + hw &&","           py >= obj.getY() - hh && py <= obj.getY() + hh &&","           pz >= obj.getZ() - hd && pz <= obj.getZ() + hd;","}","","// Same interpretation as VrGrabbable MagneticGrabEnabled (missing getter => ray selection OFF, default since 0.29.0).","function _webxrReadSelectableMagneticEnabled(b) {","    if (!b || !b._getMagneticGrabEnabled) return false;","    var v = b._getMagneticGrabEnabled();","    if (v === false || v === 'false' || v === 'False' || v === 0 || v === '0') return false;","    return true;","}","","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","","    var state = beh._state;","","    // ============ IDLE ============","    if (state === 'idle') {","        var hands = ['left', 'right'];","        for (var hi = 0; hi < hands.length; hi++) {","            var hand = hands[hi];","            var entry = controllers[hand];","            if (!entry || !entry.connected) continue;","","            var selected = false;","","            // 1. AABB touch check (cheap, no raycast needed)","            var cp = _ctrlPos(hand);","            if (cp && _inAABB(cp.x, cp.y, cp.z, obj)) {","                selected = true;","            }","","            // 2. Raycast check (controller forward ray hits bounding box)","            var selRayMagOn = _webxrReadSelectableMagneticEnabled(beh);","            if (gdjs._webxrDebugMagneticGrabProp) {","                var _rawS = beh._getMagneticGrabEnabled ? beh._getMagneticGrabEnabled() : '(no getter)';","                var _sigS = String(_rawS) + '|' + selRayMagOn;","                if (beh._webxrDbgSelRaySig !== _sigS) { beh._webxrDbgSelRaySig = _sigS; console.log('[WebXR VrSelectable MagneticGrabEnabled]', { object: obj.getName ? obj.getName() : '', raw: _rawS, raySelectionOn: selRayMagOn, hasGetter: !!beh._getMagneticGrabEnabled }); }","            }","            if (!selected && selRayMagOn && entry.grip) {","                var _wsMag2 = gdjs._webxrVrWorldScale || 100;","                var _selNear = _wsMag2 * 0.06;","                var _selFar = (entry._magneticGrabLength > 0 ? entry._magneticGrabLength : 1000);","                var _handHitsS = gdjs._webxrHandRayHits(runtimeScene, hand);","                for (var _hsi = 0; _hsi < _handHitsS.length; _hsi++) {","                    var _hs = _handHitsS[_hsi];","                    if (_hs.distance < _selNear || _hs.distance > _selFar) continue;","                    var hp = _hs.point;","                    var hitGdX = anchor.x + (hp.x - anchor.threeX);","                    var hitGdY = anchor.y - (hp.y - anchor.threeY);","                    var hitGdZ = anchor.z + (hp.z - anchor.threeZ);","                    if (_inAABB(hitGdX, hitGdY, hitGdZ, obj)) {","                        selected = true;","                    }","                    break;","                }","            }","","            if (selected) {","                // Mutual exclusion: only one selectable selected per hand at a time","                var alreadySelected = false;","                var reg = gdjs._webxrVrSelectableRegistry || [];","                for (var ri = 0; ri < reg.length; ri++) {","                    if (reg[ri].beh._state === 'selected' && reg[ri].beh._selectingHand === hand) {","                        alreadySelected = true;","                        break;","                    }","                }","                if (!alreadySelected) {","                    beh._selectingHand = hand;","                    beh._state = 'selected';","                    break;","                }","            }","        }","    }","","    // ============ SELECTED ============","    else if (state === 'selected') {","        var sHand = beh._selectingHand;","        var sEntry = sHand ? controllers[sHand] : null;","        if (!sEntry || !sEntry.connected) {","            beh._state = 'idle';","            beh._selectingHand = null;","        } else {","            var stillSelected = false;","","            // AABB touch check","            var scp = _ctrlPos(sHand);","            if (scp && _inAABB(scp.x, scp.y, scp.z, obj)) {","                stillSelected = true;","            }","","            var selRayMagOnS = _webxrReadSelectableMagneticEnabled(beh);","            // Raycast check","            if (!stillSelected && selRayMagOnS && sEntry.grip) {","                var _wsMagS = gdjs._webxrVrWorldScale || 100;","                var _selNearS = _wsMagS * 0.06;","                var _selFarS = (sEntry._magneticGrabLength > 0 ? sEntry._magneticGrabLength : 1000);","                var _handHitsSS = gdjs._webxrHandRayHits(runtimeScene, sHand);","                for (var _hssi = 0; _hssi < _handHitsSS.length; _hssi++) {","                    var _hss = _handHitsSS[_hssi];","                    if (_hss.distance < _selNearS || _hss.distance > _selFarS) continue;","                    var sHp = _hss.point;","                    var sHitGdX = anchor.x + (sHp.x - anchor.threeX);","                    var sHitGdY = anchor.y - (sHp.y - anchor.threeY);","                    var sHitGdZ = anchor.z + (sHp.z - anchor.threeZ);","                    if (_inAABB(sHitGdX, sHitGdY, sHitGdZ, obj)) {","                        stillSelected = true;","                    }","                    break;","                }","            }","","            if (!stillSelected) {","                beh._state = 'idle';","                beh._selectingHand = null;","            }","        }","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"","parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"description":"Check if this object is currently selected (being hit by a controller ray-cast laser or touched by a controller)","fullName":"Is selected","functionType":"Condition","group":"State","name":"IsSelected","sentence":"_PARAM0_ is selected","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._state === 'selected');"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"description":"Returns the hand currently selecting this object (\"left\", \"right\", or empty)","fullName":"Selecting hand","functionType":"ExpressionAndCondition","group":"State","name":"SelectingHand","sentence":"_PARAM0_ selecting hand","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._selectingHand || '') : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"description":"Allow this selectable to be hit by the controller laser ray for selection (same as enabling Magnetic grab enabled)","fullName":"Enable magnetic grab","functionType":"Action","group":"Magnetic","name":"EnableMagneticGrab","sentence":"Enable magnetic grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setMagneticGrabEnabled) beh._setMagneticGrabEnabled('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"description":"Prevent this selectable from being hit by the controller laser ray (proximity touch still works)","fullName":"Disable magnetic grab","functionType":"Action","group":"Magnetic","name":"DisableMagneticGrab","sentence":"Disable magnetic grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setMagneticGrabEnabled) beh._setMagneticGrabEnabled('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if the controller laser ray can select this object, 0 if only proximity touch works. As a condition, checks whether magnetic grab is enabled.","fullName":"Magnetic grab enabled","functionType":"ExpressionAndCondition","group":"Magnetic","name":"MagneticGrabEnabled","sentence":"_PARAM0_ magnetic grab enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getMagneticGrabEnabled ? beh._getMagneticGrabEnabled() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrSelectable","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"doStepPreEvents"},{"functionName":"doStepPostEvents"},{"functionName":"onDestroy"},{"folderName":"State","children":[{"functionName":"IsSelected"},{"functionName":"SelectingHand"}]},{"folderName":"Magnetic","children":[{"functionName":"EnableMagneticGrab"},{"functionName":"DisableMagneticGrab"},{"functionName":"MagneticGrabEnabled"}]}]},"propertyDescriptors":[{"value":"false","type":"Boolean","label":"Magnetic grab enabled","description":"If enabled, the controller laser ray can select this object (proximity touch always works regardless). Off by default since 0.29.0.","name":"MagneticGrabEnabled"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"MagneticGrabEnabled"}]}},{"description":"Detect when a controller's laser pointer is aimed at this object. Works on any 3D object regardless of whether it has a VrGrabbable behavior. Use IsTargeted to pick targeted instances each frame, JustTargeted for the one-frame entry edge, and TargetingHand to identify which controller is aiming (\"left\", \"right\", or \"both\"). Requires the controller to have the laser enabled with Stop at geometry on.","fullName":"VR Targetable (WebXR)","helpPath":"","iconUrl":"","name":"VrTargetable","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","if (!gdjs._webxrVrTargetableRegistry) gdjs._webxrVrTargetableRegistry = [];","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    beh._isTargeted = false;","    beh._justTargeted = false;","    beh._targetingHand = '';","    beh._targetCount = 0;","    beh._everTargeted = false;","    beh._hitPointX = 0;","    beh._hitPointY = 0;","    beh._hitPointZ = 0;","    beh._targetedLeft = false;","    beh._targetedRight = false;","    gdjs._webxrVrTargetableRegistry.push({ obj: obj, beh: beh });","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","if (!gdjs._webxrVrTargetableRegistry) return;","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    gdjs._webxrVrTargetableRegistry = gdjs._webxrVrTargetableRegistry.filter(function(e) { return e.obj !== obj; });","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var controllers = gdjs._webxrVrControllers;","var anchor = gdjs._webxrVrAnchor;","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    var wasT = beh._isTargeted;","    beh._isTargeted = false;","    beh._justTargeted = false;","    beh._targetingHand = '';","    beh._targetedLeft = false;","    beh._targetedRight = false;","    var enabled = beh._getTargetableEnabled ? (beh._getTargetableEnabled() === 'true' || beh._getTargetableEnabled() === true) : true;","    var tThree = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","    if (!enabled || !controllers || !tThree) continue;","    var hitLeft = false, hitRight = false;","    var hands = ['left', 'right'];","    for (var h = 0; h < 2; h++) {","        var entry = controllers[hands[h]];","        var hitGdObj = (entry && entry.vrBeh) ? entry.vrBeh._laserHitGdObject : null;","        if (!entry || !entry.connected || !entry.vrBeh || !hitGdObj) continue;","        var found = hitGdObj === obj;","        if (found) {","            if (hands[h] === 'left') hitLeft = true; else hitRight = true;","            var hp = entry.vrBeh._laserHitPointThree;","            if (hp && anchor) {","                beh._hitPointX = anchor.x + (hp.x - anchor.threeX);","                beh._hitPointY = anchor.y - (hp.y - anchor.threeY);","                beh._hitPointZ = anchor.z + (hp.z - anchor.threeZ);","            }","        }","    }","    beh._targetedLeft = hitLeft;","    beh._targetedRight = hitRight;","    beh._isTargeted = hitLeft || hitRight;","    beh._targetingHand = (hitLeft && hitRight) ? 'both' : (hitLeft ? 'left' : (hitRight ? 'right' : ''));","    if (beh._isTargeted && !wasT) {","        beh._justTargeted = true;","        beh._targetCount = (beh._targetCount || 0) + 1;","        beh._everTargeted = true;","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"True this frame if a controller's laser is aimed at this object. Picks only the targeted instances, so subsequent actions affect the correct object. Continuous condition: use JustTargeted for a one-frame entry event.","fullName":"Is targeted by laser","functionType":"Condition","group":"State","name":"IsTargeted","sentence":"_PARAM0_ is targeted by a laser","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._isTargeted);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"True for exactly one frame when a laser first aims at this object (rising edge). Use to trigger one-shot events such as a sound or highlight on aim-entry.","fullName":"Just targeted by laser","functionType":"Condition","group":"State","name":"JustTargeted","sentence":"_PARAM0_ was just targeted by a laser","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._justTargeted);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"True if this object has been targeted by a laser at least once since the scene started or since the last ResetTargeting.","fullName":"Was ever targeted","functionType":"Condition","group":"State","name":"WasEverTargeted","sentence":"_PARAM0_ was ever targeted by a laser","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._everTargeted);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"The hand whose laser is currently targeting this object. Returns \"left\", \"right\", \"both\" (when both lasers hit simultaneously), or an empty string when not targeted.","fullName":"Targeting hand","functionType":"ExpressionAndCondition","group":"State","name":"TargetingHand","sentence":"_PARAM0_ targeting hand","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._targetingHand || '') : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"True when this object is being targeted by the specified hand's laser. Pass \"left\", \"right\", or the result of VrController::Handedness(). Also returns true when the value is \"left\" or \"right\" and both lasers are simultaneously hitting this object - use this instead of comparing TargetingHand directly so dual-wield works correctly.","fullName":"Targeted by hand","functionType":"Condition","group":"State","name":"IsTargetedByHand","sentence":"_PARAM0_ is targeted by the _PARAM2_ laser","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var hand = ('' + (eventsFunctionContext.getArgument('Hand') || '')).toLowerCase();","var ok = false;","if (beh) {","    if (hand === 'left') ok = !!beh._targetedLeft;","    else if (hand === 'right') ok = !!beh._targetedRight;","    else if (hand === 'both') ok = !!(beh._targetedLeft && beh._targetedRight);","    else ok = !!beh._isTargeted;","}","eventsFunctionContext.returnValue = ok;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"},{"description":"Hand: \"left\", \"right\", \"both\", or VrController::Handedness()","name":"Hand","type":"string"}],"objectGroups":[]},{"description":"Number of times this object has been targeted (each new aim-entry increments this). Resets to 0 with ResetTargeting.","fullName":"Target count","functionType":"ExpressionAndCondition","group":"State","name":"TargetCount","sentence":"_PARAM0_ target count","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._targetCount || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"X coordinate of the laser hit point on this object in GDevelop world coordinates. Returns 0 when not targeted.","fullName":"Target point X","functionType":"ExpressionAndCondition","group":"Hit point","name":"TargetPointX","sentence":"_PARAM0_ target point X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._hitPointX || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Y coordinate of the laser hit point on this object in GDevelop world coordinates (Y axis inverted vs Three.js). Returns 0 when not targeted.","fullName":"Target point Y","functionType":"ExpressionAndCondition","group":"Hit point","name":"TargetPointY","sentence":"_PARAM0_ target point Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._hitPointY || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Z coordinate of the laser hit point on this object in GDevelop world coordinates. Returns 0 when not targeted.","fullName":"Target point Z","functionType":"ExpressionAndCondition","group":"Hit point","name":"TargetPointZ","sentence":"_PARAM0_ target point Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._hitPointZ || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Allow controller lasers to target this object (same as enabling the Targetable enabled property).","fullName":"Enable targeting","functionType":"Action","group":"Targeting","name":"EnableTargeting","sentence":"Enable targeting on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setTargetableEnabled) beh._setTargetableEnabled('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Prevent controller lasers from targeting this object.","fullName":"Disable targeting","functionType":"Action","group":"Targeting","name":"DisableTargeting","sentence":"Disable targeting on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setTargetableEnabled) beh._setTargetableEnabled('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if controller lasers can target this object, 0 if targeting is disabled.","fullName":"Targeting enabled","functionType":"ExpressionAndCondition","group":"Targeting","name":"TargetingEnabled","sentence":"_PARAM0_ targeting enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getTargetableEnabled ? beh._getTargetableEnabled() : 'true';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]},{"description":"Reset the target count to 0 and clear the WasEverTargeted flag.","fullName":"Reset targeting stats","functionType":"Action","group":"Targeting","name":"ResetTargeting","sentence":"Reset targeting stats on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    beh._targetCount = 0;","    beh._everTargeted = false;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrTargetable","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"doStepPreEvents"},{"functionName":"onDestroy"},{"folderName":"State","children":[{"functionName":"IsTargeted"},{"functionName":"JustTargeted"},{"functionName":"WasEverTargeted"},{"functionName":"TargetingHand"},{"functionName":"TargetCount"},{"functionName":"IsTargetedByHand"}]},{"folderName":"Hit point","children":[{"functionName":"TargetPointX"},{"functionName":"TargetPointY"},{"functionName":"TargetPointZ"}]},{"folderName":"Targeting","children":[{"functionName":"EnableTargeting"},{"functionName":"DisableTargeting"},{"functionName":"TargetingEnabled"},{"functionName":"ResetTargeting"}]}]},"propertyDescriptors":[{"value":"true","type":"Boolean","label":"Targetable enabled","description":"When disabled, controller lasers cannot target this object and IsTargeted will always return false.","name":"TargetableEnabled"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"TargetableEnabled"}]}},{"description":"Automatic body-anchored holster zones (hips, shoulders, chest, head, mouth). Place on the same object as VrHeadAnchor. Zones follow the player yaw. Grabbable objects with matching HolsterTag snap into zones on release. Use VrHolster for manually-placed zones instead.","fullName":"VR Body Zones","helpPath":"","iconUrl":"","name":"VrBodyZones","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    beh._zoneHeadRoot = null;","    beh._zoneBodyRoot = null;","    beh._zoneSpheres = {};","    beh._zoneInsideState = {};","    beh._zoneEntries = [];","    if (!gdjs._webxrVrHolsterHelpersInstalled) {","        gdjs._webxrVrHolsterHelpersInstalled = true;","        gdjs._webxrVrHolsterRegistry = gdjs._webxrVrHolsterRegistry || [];","        gdjs._webxrVrHolsterFireHaptic = function(hand, intensity, durationMs) {","            var sc = gdjs._webxrRtSceneRef;","            if (!sc) return;","            var tr2 = sc.getGame().getRenderer().getThreeRenderer();","            if (!tr2 || !tr2.xr) return;","            var sess = tr2.xr.getSession ? tr2.xr.getSession() : null;","            if (!sess) return;","            var srcs = sess.inputSources || [];","            for (var _si = 0; _si < srcs.length; _si++) {","                var _src = srcs[_si];","                if (_src.handedness === hand && _src.gamepad &&","                    _src.gamepad.hapticActuators && _src.gamepad.hapticActuators.length > 0) {","                    _src.gamepad.hapticActuators[0].pulse(intensity, durationMs);","                    break;","                }","            }","        };","        gdjs._webxrVrHolsterTagMatches = function(grabbableTag, acceptedCsv) {","            if (!acceptedCsv || acceptedCsv.trim() === '') return true;","            if (!grabbableTag || grabbableTag.trim() === '') return false;","            var acc = acceptedCsv.split(',');","            for (var _ti = 0; _ti < acc.length; _ti++) {","                if (acc[_ti].trim().toLowerCase() === grabbableTag.trim().toLowerCase()) return true;","            }","            return false;","        };","        gdjs._webxrVrHolsterTryDockOnRelease = function(obj, beh, hand, handEntry) {","            if (gdjs._webxrArcheryActive && gdjs._webxrArcheryActive[hand] > performance.now()) return false;","            if (beh._noRedockUntil && beh._noRedockUntil > performance.now()) return false;","            var reg = gdjs._webxrVrHolsterRegistry;","            if (!reg || !handEntry) return false;","            var wp = handEntry._adjustedWP;","            if (!wp) return false;","            var tag = beh._getHolsterTag ? beh._getHolsterTag() : '';","            var _tAnc = gdjs._webxrVrAnchor;","            // Pass 1: hand in zone bounds (preferred - deliberate release), pick closest zone to hand","            var _p1Best = null, _p1BestDist = Infinity;","            var _holdBonus = 10;","            for (var _ri = 0; _ri < reg.length; _ri++) {","                var _e = reg[_ri];","                if (gdjs._webxrVrHolsterIsFull(_e)) continue;","                if (!gdjs._webxrVrHolsterTagMatches(tag, _e.acceptedTags || '')) continue;","                if (_e.source === 'vrDoorKeyZone') {","                    var _dkBeh = null; try { _dkBeh = obj.getBehavior('VrKey'); } catch(_ek) {}","                    if (!_dkBeh) continue;","                    var _dkTag = _dkBeh._getKeyTag ? String(_dkBeh._getKeyTag()) : '';","                    if (!gdjs._webxrVrHolsterTagMatches(_dkTag, _e.acceptedKeyTags || '')) continue;","                    if (!_tAnc) continue;","                    var _hGdXdk = _tAnc.x + (wp.x - _tAnc.threeX);","                    var _hGdYdk = _tAnc.y - (wp.y - _tAnc.threeY);","                    var _hGdZdk = _tAnc.z + (wp.z - _tAnc.threeZ);","                    var _dxDk = _hGdXdk - (_e.gdX||0), _dyDk = _hGdYdk - (_e.gdY||0), _dzDk = _hGdZdk - (_e.gdZ||0);","                    var _p1Dist = Math.sqrt(_dxDk*_dxDk + _dyDk*_dyDk + _dzDk*_dzDk);","                    if (_p1Dist <= _e.radius + _holdBonus && _p1Dist < _p1BestDist) { _p1BestDist = _p1Dist; _p1Best = _e; }","                    continue;","                }","                var _hit;","                var _p1Dist = Infinity;","                if (_e.holsterObj) {","                    var _hO = _e.holsterObj;","                    var _hOWP = _e.worldPos;","                    var _hORadius = Math.max(_hO.getWidth(), _hO.getHeight(), _hO.getDepth()) / 2 + _holdBonus;","                    var _h2dx = wp.x - _hOWP.x, _h2dy = wp.y - _hOWP.y, _h2dz = wp.z - _hOWP.z;","                    var _h2DistSq = _h2dx*_h2dx + _h2dy*_h2dy + _h2dz*_h2dz;","                    _hit = _h2DistSq <= _hORadius*_hORadius;","                    if (_hit) _p1Dist = Math.sqrt(_h2DistSq);","                } else {","                    var _zp = _e.worldPos; if (!_zp) continue;","                    var _dx = wp.x - _zp.x, _dy = wp.y - _zp.y, _dz = wp.z - _zp.z;","                    _p1Dist = Math.sqrt(_dx*_dx + _dy*_dy + _dz*_dz);","                    if (_e.shape === 'box') {","                        var _cy = Math.cos(-_e.parentYaw), _sy = Math.sin(-_e.parentYaw);","                        var _lx =  _dx * _cy - _dy * _sy;","                        var _ly =  _dx * _sy + _dy * _cy;","                        _hit = Math.abs(_lx) <= _e.sizeX * 0.5 + _holdBonus","                            && Math.abs(_ly) <= _e.sizeY * 0.5 + _holdBonus","                            && Math.abs(_dz) <= _e.sizeZ * 0.5 + _holdBonus;","                    } else {","                        _hit = _p1Dist <= _e.radius + _holdBonus;","                    }","                }","                if (!_hit) continue;","                if (_p1Dist < _p1BestDist) { _p1BestDist = _p1Dist; _p1Best = _e; }","            }","            if (_p1Best) {","                gdjs._webxrVrHolsterAdd(_p1Best, obj, beh);","                beh._holsterEntry = _p1Best;","                if (gdjs._webxrVrHolsterFireHaptic)","                    gdjs._webxrVrHolsterFireHaptic(hand, _p1Best.holdingHapticIntensity || 0.4, _p1Best.holdingHapticDuration || 40);","                return true;","            }","            // Pass 2: object AABB overlaps zone bounds (fallback - sword tip reaches into zone while hand is outside), pick closest zone to hand","            var _dAnc = gdjs._webxrVrAnchor;","            if (!_dAnc || !obj) return false;","            var _dohw = (obj.getWidth  ? obj.getWidth()  : 0) / 2;","            var _dohh = (obj.getHeight ? obj.getHeight() : 0) / 2;","            var _dohd = (obj.getDepth  ? obj.getDepth()  : 0) / 2;","            var _dox = obj.getX(), _doy = obj.getY(), _doz = obj.getZ();","            var _p2Best = null, _p2BestDist = Infinity;","            for (var _ri2 = 0; _ri2 < reg.length; _ri2++) {","                var _e2 = reg[_ri2];","                if (gdjs._webxrVrHolsterIsFull(_e2)) continue;","                if (!gdjs._webxrVrHolsterTagMatches(tag, _e2.acceptedTags || '')) continue;","                if (_e2.source === 'vrDoorKeyZone') {","                    var _dkBeh2 = null; try { _dkBeh2 = obj.getBehavior('VrKey'); } catch(_ek2) {}","                    if (!_dkBeh2) continue;","                    var _dkTag2 = _dkBeh2._getKeyTag ? String(_dkBeh2._getKeyTag()) : '';","                    if (!gdjs._webxrVrHolsterTagMatches(_dkTag2, _e2.acceptedKeyTags || '')) continue;","                    var _zGxDk = _e2.gdX||0, _zGyDk = _e2.gdY||0, _zGzDk = _e2.gdZ||0;","                    var _dqxDk = Math.max(_dox-_dohw, Math.min(_zGxDk, _dox+_dohw));","                    var _dqyDk = Math.max(_doy-_dohh, Math.min(_zGyDk, _doy+_dohh));","                    var _dqzDk = Math.max(_doz-_dohd, Math.min(_zGzDk, _doz+_dohd));","                    var _dqdxDk=_dqxDk-_zGxDk,_dqdyDk=_dqyDk-_zGyDk,_dqdzDk=_dqzDk-_zGzDk;","                    if (Math.sqrt(_dqdxDk*_dqdxDk+_dqdyDk*_dqdyDk+_dqdzDk*_dqdzDk) > _e2.radius) continue;","                    var _p2Dist = _tAnc ? (function(){","                        var _rX=_tAnc.x+(wp.x-_tAnc.threeX)-_zGxDk,_rY=_tAnc.y-(wp.y-_tAnc.threeY)-_zGyDk,_rZ=_tAnc.z+(wp.z-_tAnc.threeZ)-_zGzDk;","                        return Math.sqrt(_rX*_rX+_rY*_rY+_rZ*_rZ);","                    })() : 0;","                    if (_p2Dist < _p2BestDist) { _p2BestDist = _p2Dist; _p2Best = _e2; }","                    continue;","                }","                var _hit2;","                if (_e2.holsterObj) {","                    var _hO2 = _e2.holsterObj;","                    var _hO2R = Math.max(_hO2.getWidth(), _hO2.getHeight(), _hO2.getDepth()) / 2 + _holdBonus;","                    var _d2Three = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","                    if (_d2Three) {","                        var _d2WP = new THREE.Vector3(); _d2Three.getWorldPosition(_d2WP);","                        var _d2dx = _d2WP.x - _e2.worldPos.x, _d2dy = _d2WP.y - _e2.worldPos.y, _d2dz = _d2WP.z - _e2.worldPos.z;","                        _hit2 = _d2dx*_d2dx + _d2dy*_d2dy + _d2dz*_d2dz <= _hO2R*_hO2R;","                    }","                } else {","                    var _zp2 = _e2.worldPos;","                    if (!_zp2) continue;","                    var _zGx = _dAnc.x + (_zp2.x - _dAnc.threeX);","                    var _zGy = _dAnc.y - (_zp2.y - _dAnc.threeY);","                    var _zGz = _dAnc.z + (_zp2.z - _dAnc.threeZ);","                    var _dqx = Math.max(_dox-_dohw, Math.min(_zGx, _dox+_dohw));","                    var _dqy = Math.max(_doy-_dohh, Math.min(_zGy, _doy+_dohh));","                    var _dqz = Math.max(_doz-_dohd, Math.min(_zGz, _doz+_dohd));","                    var _dqdx = _dqx-_zGx, _dqdy = _dqy-_zGy, _dqdz = _dqz-_zGz;","                    if (_e2.shape === 'box') {","                        var _dbcy = Math.cos(_e2.parentYaw), _dbsy = Math.sin(_e2.parentYaw);","                        var _dblx = _dqdx*_dbcy - _dqdy*_dbsy;","                        var _dbly = _dqdx*_dbsy + _dqdy*_dbcy;","                        _hit2 = Math.abs(_dblx) <= _e2.sizeX*0.5","                             && Math.abs(_dbly) <= _e2.sizeY*0.5","                             && Math.abs(_dqdz) <= _e2.sizeZ*0.5;","                    } else {","                        _hit2 = Math.sqrt(_dqdx*_dqdx + _dqdy*_dqdy + _dqdz*_dqdz) <= _e2.radius;","                    }","                }","                if (!_hit2) continue;","                var _p2Dist = _e2.worldPos ? Math.sqrt(","                    (wp.x-_e2.worldPos.x)*(wp.x-_e2.worldPos.x) +","                    (wp.y-_e2.worldPos.y)*(wp.y-_e2.worldPos.y) +","                  