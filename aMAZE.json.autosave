umentAsString(\"MazeID\")].DownWall[Variable(__MazeGenerator.Index)]","False"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator[GetArgumentAsString(\"MazeID\")].RightWall[Variable(__MazeGenerator.Index)+Variable(__MazeGenerator[GetArgumentAsString(\"MazeID\")].NumColumns)]","False"]}]},{"type":{"value":"BuiltinCommonInstructions::And"},"parameters":[],"subInstructions":[{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator[GetArgumentAsString(\"MazeID\")].RightWall[Variable(__MazeGenerator.Index)]","False"]},{"type":{"value":"SceneVariableAsBoolean"},"parameters":["__MazeGenerator[GetArgumentAsString(\"MazeID\")].DownWall[Variable(__MazeGenerator.Index)+1]","False"]}]}]}],"actions":[{"type":{"value":"Create"},"parameters":["","Corner","0","0","GetArgumentAsString(\"Layer\")"]},{"type":{"value":"ModVarObjet"},"parameters":["Corner","__MazeGenerator_Column","=","mod(Variable(__MazeGenerator.Index),Variable(__MazeGenerator[GetArgumentAsString(\"MazeID\")].NumColumns)) + 1"]},{"type":{"value":"ModVarObjet"},"parameters":["Corner","__MazeGenerator_Row","=","floor(Variable(__MazeGenerator.Index)/Variable(__MazeGenerator[GetArgumentAsString(\"MazeID\")].NumColumns)) + 1"]},{"type":{"value":"Scene3D::Base3DBehavior::SetZ"},"parameters":["Corner","Corner3D","=","GetArgumentAsNumber(\"Z\")"]},{"type":{"value":"ModVarObjetTxt"},"parameters":["Corner","__MazeGenerator_MazeID","=","GetArgumentAsString(\"MazeID\")"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Egal"},"parameters":["GetArgumentAsNumber(\"ResizeWidth\")",">","0"]}],"actions":[{"type":{"value":"ResizableCapability::ResizableBehavior::SetWidth"},"parameters":["Corner","CornerResizable","=","GetArgumentAsNumber(\"ResizeWidth\")"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Egal"},"parameters":["GetArgumentAsNumber(\"ResizeHeight\")",">","0"]}],"actions":[{"type":{"value":"ResizableCapability::ResizableBehavior::SetHeight"},"parameters":["Corner","CornerResizable","=","GetArgumentAsNumber(\"ResizeHeight\")"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Egal"},"parameters":["GetArgumentAsNumber(\"ResizeDepth\")",">","0"]}],"actions":[{"type":{"value":"Scene3D::Base3DBehavior::SetDepth"},"parameters":["Corner","Corner3D","=","GetArgumentAsNumber(\"ResizeDepth\")"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetCenter"},"parameters":["Corner","=","Variable(__MazeGenerator.FloorX) + Variable(__MazeGenerator[GetArgumentAsString(\"MazeID\")].FloorWidth)","=","Variable(__MazeGenerator.FloorY) + Variable(__MazeGenerator[GetArgumentAsString(\"MazeID\")].FloorHeight)"]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.Index","+","1"]}]}]}],"parameters":[{"description":"MazeID chosen during maze creation","name":"MazeID","type":"string"},{"description":"Corner Object","name":"Corner","type":"objectList"},{"description":"Corner Object 3D behavior","name":"Corner3D","supplementaryInformation":"Scene3D::Base3DBehavior","type":"behavior"},{"description":"Corner Object Resizable behavior","name":"CornerResizable","supplementaryInformation":"ResizableCapability::ResizableBehavior","type":"behavior"},{"description":"Layer","name":"Layer","type":"string"},{"description":"Z position (bottom of the object)","name":"Z","type":"expression"},{"description":"Resize Width of Corner (Optional)","name":"ResizeWidth","type":"expression"},{"description":"Resize Height of Corner (Optional)","name":"ResizeHeight","type":"expression"},{"description":"Resize Depth of Corner (Optional)","name":"ResizeDepth","type":"expression"}],"objectGroups":[]},{"description":"Internal: set the seed used by the maze random generator (0 = unseeded, Math.random).","fullName":"Set maze random seed","functionType":"Action","name":"SetMazeSeed","private":true,"sentence":"Set maze random seed to _PARAM1_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const seed = eventsFunctionContext.getArgument('Seed') | 0;","gdjs.__mazeGeneratorRngState = seed === 0 ? null : seed;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Seed","name":"Seed","type":"expression"}],"objectGroups":[]},{"description":"Internal: random integer in [Min, Max], deterministic when a seed is set (mulberry32).","fullName":"Maze random in range","functionType":"Expression","name":"MazeRandomInRange","private":true,"sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const min = eventsFunctionContext.getArgument('Min');","const max = eventsFunctionContext.getArgument('Max');","let r;","if (gdjs.__mazeGeneratorRngState == null) {","  r = Math.random();","} else {","  let t = (gdjs.__mazeGeneratorRngState = (gdjs.__mazeGeneratorRngState + 0x6D2B79F5) | 0);","  t = Math.imul(t ^ (t >>> 15), t | 1);","  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);","  r = ((t ^ (t >>> 14)) >>> 0) / 4294967296;","}","eventsFunctionContext.returnValue = min + Math.floor(r * (max - min + 1));"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Min","name":"Min","type":"expression"},{"description":"Max","name":"Max","type":"expression"}],"objectGroups":[]},{"description":"Generate a random maze that is always the same for the same seed (and same size). Seed 0 gives a different maze every time.","fullName":"Generate a maze (with seed)","functionType":"Action","name":"GenerateMazeWithSeed","sentence":"Create a random maze called _PARAM7_ at point x=_PARAM1_, y=_PARAM2_ of width _PARAM3_ and height _PARAM4_, made with _PARAM5_ by _PARAM6_ cells using seed _PARAM8_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"MazeGenerator::SetMazeSeed"},"parameters":["","GetArgumentAsNumber(\"Seed\")"]},{"type":{"value":"MazeGenerator::GenerateMaze"},"parameters":["","GetArgumentAsNumber(\"MazeX\")","GetArgumentAsNumber(\"MazeY\")","GetArgumentAsNumber(\"MazeWidth\")","GetArgumentAsNumber(\"MazeHeight\")","GetArgumentAsNumber(\"CellWidth\")","GetArgumentAsNumber(\"CellHeight\")","GetArgumentAsString(\"MazeID\")",""]},{"type":{"value":"MazeGenerator::SetMazeSeed"},"parameters":["","0"]}]}],"parameters":[{"description":"Top-left point, X coordinate of maze in scene","name":"MazeX","type":"expression"},{"description":"Top-left point, Y coordinate of maze in scene","name":"MazeY","type":"expression"},{"description":"Width of whole maze (in pixels)","name":"MazeWidth","type":"expression"},{"description":"Height of whole maze (in pixels)","name":"MazeHeight","type":"expression"},{"description":"Cell Width (in pixels)","name":"CellWidth","type":"expression"},{"description":"Cell Height (in pixels)","name":"CellHeight","type":"expression"},{"description":"Custom name for new maze (MazeID)","name":"MazeID","type":"string"},{"description":"Seed (0 = random each time)","name":"Seed","type":"expression"}],"objectGroups":[]},{"description":"Finds the dead end (cell with exactly 3 walls) that is the farthest, by number of steps through the maze, from a given cell. Read the result with MazeFarthestDeadEndRow, MazeFarthestDeadEndColumn and MazeFarthestDeadEndDistance, then use the MazeObject condition 'in a certain row and column' on your floor objects to pick the floor at that position. If the maze has no dead end reachable from the start, the distance is -1.","fullName":"Find farthest dead end","functionType":"Action","name":"FindFarthestDeadEnd","sentence":"Find the farthest dead end in maze _PARAM1_ from row _PARAM2_ column _PARAM3_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const mazeID = eventsFunctionContext.getArgument('MazeID');","const startRow = eventsFunctionContext.getArgument('StartRow');","const startCol = eventsFunctionContext.getArgument('StartColumn');","const maze = runtimeScene.getVariables().get('__MazeGenerator').getChild(mazeID);","const cols = maze.getChild('NumColumns').getAsNumber();","const total = maze.getChild('NumberOfCells').getAsNumber();","const rows = total / cols;","const left = maze.getChild('LeftWall').getAllChildrenArray();","const right = maze.getChild('RightWall').getAllChildrenArray();","const up = maze.getChild('UpWall').getAllChildrenArray();","const down = maze.getChild('DownWall').getAllChildrenArray();","const wall = (arr, i) => arr[i].getAsBoolean();","","const result = { row: 0, column: 0, distance: -1 };","gdjs.__mazeFarthestDeadEnd = result;","const start = (startRow - 1) * cols + (startCol - 1);","if (!(start >= 0 && start < total)) return;","","// Breadth-first search over cells, tracking the farthest cell with exactly 3 walls (a dead end).","const dist = new Array(total).fill(-1);","const queue = [start];","dist[start] = 0;","for (let head = 0; head < queue.length; head++) {","  const i = queue[head];","  const col = i % cols;","  const walls = wall(left, i) + wall(right, i) + wall(up, i) + wall(down, i);","  if (walls === 3 && i !== start && dist[i] > result.distance) {","    result.distance = dist[i];","    result.row = Math.floor(i / cols) + 1;","    result.column = col + 1;","  }","  const next = [];","  if (!wall(left, i) && col > 0) next.push(i - 1);","  if (!wall(right, i) && col < cols - 1) next.push(i + 1);","  if (!wall(up, i) && i >= cols) next.push(i - cols);","  if (!wall(down, i) && i < total - cols) next.push(i + cols);","  for (const n of next) {","    if (dist[n] === -1) {","      dist[n] = dist[i] + 1;","      queue.push(n);","    }","  }","}"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[{"description":"MazeID","name":"MazeID","type":"string"},{"description":"Start Row (e.g. the player's cell)","name":"StartRow","type":"expression"},{"description":"Start Column (e.g. the player's cell)","name":"StartColumn","type":"expression"}],"objectGroups":[]},{"description":"Row of the dead end found by the last Find farthest dead end action","fullName":"Farthest dead end row","functionType":"Expression","name":"MazeFarthestDeadEndRow","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const r = gdjs.__mazeFarthestDeadEnd;","eventsFunctionContext.returnValue = r ? r.row : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"Column of the dead end found by the last Find farthest dead end action","fullName":"Farthest dead end column","functionType":"Expression","name":"MazeFarthestDeadEndColumn","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const r = gdjs.__mazeFarthestDeadEnd;","eventsFunctionContext.returnValue = r ? r.column : 0;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]},{"description":"Number of steps to the dead end found by the last Find farthest dead end action (-1 if none)","fullName":"Farthest dead end distance","functionType":"Expression","name":"MazeFarthestDeadEndDistance","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const r = gdjs.__mazeFarthestDeadEnd;","eventsFunctionContext.returnValue = r ? r.distance : -1;"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"GenerateMaze"},{"functionName":"FindMazePath"},{"functionName":"MazeCellDepth"},{"functionName":"TraverseMaze"},{"functionName":"MazeNumRows"},{"functionName":"MazeNumColumns"},{"functionName":"MazeNumCells"},{"functionName":"MazeCellWidth"},{"functi