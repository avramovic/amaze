upplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller angular velocity X (rad/s, 200ms time-weighted average, GDevelop axes)","fullName":"Angular velocity X","functionType":"ExpressionAndCondition","group":"Tracking","name":"AngularVelocityX","sentence":"_PARAM0_ angular velocity X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._angVelX || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller angular velocity Y (rad/s, 200ms time-weighted average, GDevelop axes)","fullName":"Angular velocity Y","functionType":"ExpressionAndCondition","group":"Tracking","name":"AngularVelocityY","sentence":"_PARAM0_ angular velocity Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._angVelY || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller angular velocity Z (rad/s, 200ms time-weighted average, GDevelop axes)","fullName":"Angular velocity Z","functionType":"ExpressionAndCondition","group":"Tracking","name":"AngularVelocityZ","sentence":"_PARAM0_ angular velocity Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._angVelZ || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller angular speed magnitude (rad/s). Use for melee weapon swing force/damage.","fullName":"Swing speed","functionType":"ExpressionAndCondition","group":"Tracking","name":"SwingSpeed","sentence":"_PARAM0_ swing speed","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","if (!beh) { eventsFunctionContext.returnValue = 0; } else {","    var x = beh._angVelX || 0, y = beh._angVelY || 0, z = beh._angVelZ || 0;","    eventsFunctionContext.returnValue = Math.sqrt(x*x + y*y + z*z);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller linear speed magnitude (scene units/sec). Use for melee weapon stab force/damage.","fullNa