aze in scene","name":"MazeX","type":"expression"},{"description":"Top-left point, Y coordinate of maze in scene","name":"MazeY","type":"expression"},{"description":"Width of whole maze (in pixels)","name":"MazeWidth","type":"expression"},{"description":"Height of whole maze (in pixels)","name":"MazeHeight","type":"expression"},{"description":"Cell Width (in pixels)","name":"CellWidth","type":"expression"},{"description":"Cell Height (in pixels)","name":"CellHeight","type":"expression"},{"description":"Custom name for new maze (MazeID)","name":"MazeID","type":"string"}],"objectGroups":[]},{"description":"Finds a path through a maze between two cells, storing the result in a scene variable array","fullName":"Find Maze Path","functionType":"Action","name":"FindMazePath","sentence":"Find path through maze _PARAM1_ from row _PARAM2_ column _PARAM3_ to row _PARAM4_ column _PARAM5_, store result as _PARAM6_","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Starting from the start cell, traverse through the maze picking random directions until the end cell is encountered. At each step, record the direction taken as a string in a new array."},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"VariableClearChildren"},"parameters":["__MazeGenerator.FloorTodo"]},{"type":{"value":"VariableClearChildren"},"parameters":["__MazeGenerator.FloorInProgress"]},{"type":{"value":"VariableClearChildren"},"parameters":["__MazeGenerator.Path"]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.StartIndex","=","(GetArgumentAsNumber(\"StartRow\")-1)*MazeGenerator::MazeNumColumns(GetArgumentAsString(\"MazeID\"))+(GetArgumentAsNumber(\"StartColumn\")-1)"]},{"type":{"value":"ModVarScene"},"parameters":["__MazeGenerator.EndIndex","=","(GetArgumentAsNumber(\"EndRow\")-1)*MazeGenerator::MazeNumColumns(GetArgumentAsString(\"MazeID\"))+(GetArgumentAsNumber(\"EndColumn\