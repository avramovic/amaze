l;","eventsFunctionContext.returnValue = beh ? (beh._rayDirX || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller forward ray direction Y (GDevelop axes)","fullName":"Ray direction Y","functionType":"ExpressionAndCondition","group":"Magnetic","name":"RayDirY","sentence":"_PARAM0_ ray direction Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._rayDirY || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Controller forward ray direction Z (GDevelop axes)","fullName":"Ray direction Z","functionType":"ExpressionAndCondition","group":"Magnetic","name":"RayDirZ","sentence":"_PARAM0_ ray direction Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh ? (beh._rayDirZ || 0) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Enable magnetic grab mode: the controller will cast a ray to attract VrGrabbable objects","fullName":"Enable magnetic grab","functionType":"Action","group":"Magnetic","name":"EnableMagneticGrab","sentence":"Enable magnetic grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh) { if (beh._setMagneticGrabEnabled) beh._setMagneticGrabEnabled('true'); beh._magneticGrabActive = true; }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Disable magnetic grab mode","fullName":"Disable magnetic grab","functionType":"Action","group":"Magnetic","name":"DisableMagneticGrab","sentence":"Disable magnetic grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh) { if (beh._setMagneticGrabEnabled) beh._setMagneticGrabEnabled('false'); beh._magneticGrabActive = false; }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Show the laser pointer beam from this controller (same as enabling the Laser enabled property)","fullName":"Enable laser pointer","functionType":"Action","group":"Laser","name":"EnableLaserPointer","sentence":"Enable laser pointer on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserEnabled) beh._setLaserEnabled('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Hide the laser pointer beam from this controller","fullName":"Disable laser pointer","functionType":"Action","group":"Laser","name":"DisableLaserPointer","sentence":"Disable laser pointer on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserEnabled) beh._setLaserEnabled('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the laser beam color. Accepts a GDevelop color string (R;G;B with values 0–255).","fullName":"Set laser color","functionType":"Action","group":"Laser","name":"SetLaserColor","sentence":"Set laser color of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var s = String(eventsFunctionContext.getArgument('Color') || '').trim();","var r = 255, g = 0, b = 0;","var parts = s.split(';');","if (parts.length >= 3) {","    r = Math.max(0, Math.min(255, Math.round(Number(parts[0]))));","    g = Math.max(0, Math.min(255, Math.round(Number(parts[1]))));","    b = Math.max(0, Math.min(255, Math.round(Number(parts[2]))));","}","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setLaserColor) beh._setLaserColor(r + ';' + g + ';' + b);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Color (R;G;B)","name":"Color","type":"color"}],"objectGroups":[]},{"description":"Laser beam color as a R;G;B string (0-255 each component).","fullName":"Laser color","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserColor","sentence":"_PARAM0_ laser color is _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getLaserColor ? String(beh._getLaserColor()) : '255;0;0';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Color (R;G;B) to compare","name":"Color","type":"string"}],"objectGroups":[]},{"description":"Set the visual length of the laser beam in scene units. If the laser is currently enabled, the geometry is rebuilt immediately.","fullName":"Set laser length","functionType":"Action","group":"Laser","name":"SetLaserLength","sentence":"Set laser length of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var len = Number(eventsFunctionContext.getArgument('Length'));","if (!(len > 0)) len = 5000;","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setLaserLength) beh._setLaserLength(String(len));","    if (beh._laserLine) {","        beh._laserLine.geometry.dispose();","        beh._laserLine.geometry = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), new THREE.Vector3(0, 0, -len)]);","        beh._laserHitDistance = -1;","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Length in scene units (must be > 0)","name":"Length","type":"expression"}],"objectGroups":[]},{"description":"Laser beam length in scene units","fullName":"Laser length","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserLength","sentence":"_PARAM0_ laser length","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getLaserLength ? Number(beh._getLaserLength()) || 5000 : 5000;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the max distance for the controller targeting ray in scene units. Set to 0 to inherit Laser length. The targeting ray is always cast when a controller is connected, so VrTargetable objects can be detected even when the laser is hidden.","fullName":"Set targeting ray length","functionType":"Action","group":"Targeting","name":"SetTargetingRayLength","sentence":"Set targeting ray length of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var len = Number(eventsFunctionContext.getArgument('Length'));","if (len < 0) len = 0;","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setTargetingRayLength) beh._setTargetingRayLength(String(len));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Distance in scene units, or 0 to inherit laser length","name":"Length","type":"expression"}],"objectGroups":[]},{"description":"Max distance the controller targeting ray reaches when detecting VrTargetable objects, in scene units. Returns 0 if set to inherit laser length.","fullName":"Targeting ray length","functionType":"ExpressionAndCondition","group":"Targeting","name":"TargetingRayLength","sentence":"_PARAM0_ targeting ray length","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getTargetingRayLength ? Number(beh._getTargetingRayLength()) || 0 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the pitch offset for the laser beam direction. Positive tilts down, negative tilts up. Takes effect immediately.","fullName":"Set laser pitch offset","functionType":"Action","group":"Laser","name":"SetLaserPitchOffset","sentence":"Set laser pitch offset of _PARAM0_ to _PARAM2_ degrees","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var pitch = Number(eventsFunctionContext.getArgument('Pitch'));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setLaserPitchOffset) beh._setLaserPitchOffset(String(pitch));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Pitch offset in degrees (positive = tilt down, negative = tilt up)","name":"Pitch","type":"expression"}],"objectGroups":[]},{"description":"Pitch offset of the laser beam in degrees","fullName":"Laser pitch offset","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserPitchOffset","sentence":"_PARAM0_ laser pitch offset","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getLaserPitchOffset ? Number(beh._getLaserPitchOffset()) || 0 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Make the laser beam stop when it hits scene geometry. The laser length becomes the maximum reach; the actual beam clips at the first surface hit.","fullName":"Enable laser stop at geometry","functionType":"Action","group":"Laser","name":"EnableLaserStopAtGeometry","sentence":"Enable laser stop at geometry on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserStopAtGeometry) beh._setLaserStopAtGeometry('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Allow the laser beam to pass through scene geometry. The beam always draws at its full configured length.","fullName":"Disable laser stop at geometry","functionType":"Action","group":"Laser","name":"DisableLaserStopAtGeometry","sentence":"Disable laser stop at geometry on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserStopAtGeometry) beh._setLaserStopAtGeometry('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if the laser is set to stop at geometry, 0 if it passes through. As a condition, checks whether laser-stop-at-geometry is enabled.","fullName":"Laser stop at geometry","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserStopAtGeometry","sentence":"_PARAM0_ laser stop at geometry","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getLaserStopAtGeometry ? beh._getLaserStopAtGeometry() : 'true';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Show a small sphere at the point where the laser hits geometry, colored to match the laser beam.","fullName":"Enable laser hit marker","functionType":"Action","group":"Laser","name":"EnableLaserHitMarker","sentence":"Enable laser hit marker on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserHitMarkerEnabled) beh._setLaserHitMarkerEnabled('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Hide the sphere that appears at the laser's hit point.","fullName":"Disable laser hit marker","functionType":"Action","group":"Laser","name":"DisableLaserHitMarker","sentence":"Disable laser hit marker on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setLaserHitMarkerEnabled) beh._setLaserHitMarkerEnabled('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if the laser hit marker sphere is enabled, 0 if hidden. As a condition, checks whether the hit marker is enabled.","fullName":"Laser hit marker enabled","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitMarkerEnabled","sentence":"_PARAM0_ laser hit marker enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getLaserHitMarkerEnabled ? beh._getLaserHitMarkerEnabled() : 'true';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the radius of the sphere shown at the laser hit point. Takes effect immediately if the marker is active.","fullName":"Set laser hit marker size","functionType":"Action","group":"Laser","name":"SetLaserHitMarkerSize","sentence":"Set laser hit marker size of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var size = Number(eventsFunctionContext.getArgument('Size'));","if (!(size > 0)) size = 5;","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setLaserHitMarkerSize) beh._setLaserHitMarkerSize(String(size));","    if (beh._laserHitMarker && beh._laserHitMarker._builtRadius !== size) {","        beh._laserHitMarker.geometry.dispose();","        beh._laserHitMarker.geometry = new THREE.SphereGeometry(size, 12, 12);","        beh._laserHitMarker._builtRadius = size;","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Radius in scene units (must be > 0)","name":"Size","type":"expression"}],"objectGroups":[]},{"description":"Radius of the laser hit marker sphere in scene units","fullName":"Laser hit marker size","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitMarkerSize","sentence":"_PARAM0_ laser hit marker size","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getLaserHitMarkerSize ? Number(beh._getLaserHitMarkerSize()) || 5 : 5;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"True this frame if the laser is enabled and is hitting a scene object. Use with LaserHitPointX/Y/Z to read the contact location.","fullName":"Laser is hitting geometry","functionType":"Condition","group":"Laser","name":"IsLaserHittingGeometry","sentence":"_PARAM0_ laser is hitting geometry","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._laserHitDistance > 0);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Distance in scene units from the controller to the current laser hit point. Returns -1 if the laser is not hitting anything.","fullName":"Laser hit distance","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitDistance","sentence":"_PARAM0_ laser hit distance","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = (beh && typeof beh._laserHitDistance === 'number') ? beh._laserHitDistance : -1;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"X coordinate of the laser hit point in GDevelop world coordinates. Returns 0 if the laser is not hitting anything.","fullName":"Laser hit point X","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitPointX","sentence":"_PARAM0_ laser hit point X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var hp = beh ? beh._laserHitPointThree : null;","if (hp && gdjs._webxrVrAnchor) {","    var anchor = gdjs._webxrVrAnchor;","    eventsFunctionContext.returnValue = anchor.x + (hp.x - anchor.threeX);","} else {","    eventsFunctionContext.returnValue = 0;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Y coordinate of the laser hit point in GDevelop world coordinates (Y axis is inverted vs Three.js). Returns 0 if the laser is not hitting anything.","fullName":"Laser hit point Y","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitPointY","sentence":"_PARAM0_ laser hit point Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var hp = beh ? beh._laserHitPointThree : null;","if (hp && gdjs._webxrVrAnchor) {","    var anchor = gdjs._webxrVrAnchor;","    eventsFunctionContext.returnValue = anchor.y - (hp.y - anchor.threeY);","} else {","    eventsFunctionContext.returnValue = 0;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Z coordinate of the laser hit point in GDevelop world coordinates. Returns 0 if the laser is not hitting anything.","fullName":"Laser hit point Z","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserHitPointZ","sentence":"_PARAM0_ laser hit point Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var hp = beh ? beh._laserHitPointThree : null;","if (hp && gdjs._webxrVrAnchor) {","    var anchor = gdjs._webxrVrAnchor;","    eventsFunctionContext.returnValue = anchor.z + (hp.z - anchor.threeZ);","} else {","    eventsFunctionContext.returnValue = 0;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Check if magnetic grab mode is active on this controller","fullName":"Magnetic grab is active","functionType":"Condition","group":"Magnetic","name":"IsMagneticGrabActive","sentence":"_PARAM0_ magnetic grab is active","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._magneticGrabActive);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Trigger a haptic pulse on this controller's gamepad (GamepadHapticActuator.pulse). Intensity 0–1, duration in milliseconds. No-op if not in VR or hardware has no actuator.","fullName":"Vibrate joystick","functionType":"Action","group":"Input","name":"VibrateJoystick","sentence":"Vibrate joystick of _PARAM0_ with intensity _PARAM2_ for _PARAM3_ ms","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var sess = tr.xr.getSession ? tr.xr.getSession() : null;","if (!sess || !sess.inputSources) return;","var value = Number(eventsFunctionContext.getArgument('Value') || 0);","var duration = Number(eventsFunctionContext.getArgument('Duration') || 0);","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    var hand = beh._getHandedness();","    for (var si = 0; si < sess.inputSources.length; si++) {","        var src = sess.inputSources[si];","        if (src.handedness === hand && src.gamepad &&","            src.gamepad.hapticActuators && src.gamepad.hapticActuators.length > 0) {","            src.gamepad.hapticActuators[0].pulse(value, duration);","            break;","        }","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Intensity (0–1), passed to pulse() as value","name":"Value","type":"expression"},{"description":"Duration in milliseconds, passed to pulse() as duration","name":"Duration","type":"expression"}],"objectGroups":[]},{"description":"Set the maximum reach in scene units of the controller's forward ray for magnetic grab targeting and selection.","fullName":"Set magnetic grab length","functionType":"Action","group":"Magnetic","name":"SetMagneticGrabLength","sentence":"Set magnetic grab length of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var len = Number(eventsFunctionContext.getArgument('Length'));","if (!(len > 0)) len = 1000;","var controllers = gdjs._webxrVrControllers || {};","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setMagneticGrabLength) beh._setMagneticGrabLength(String(len));","    var hand = beh._getHandedness ? beh._getHandedness() : null;","    var entry = hand ? controllers[hand] : null;","    if (entry) entry._magneticGrabLength = len;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Length in scene units (must be > 0)","name":"Length","type":"expression"}],"objectGroups":[]},{"description":"Maximum reach in scene units of the controller's forward ray for magnetic grab targeting and selection","fullName":"Magnetic grab length","functionType":"ExpressionAndCondition","group":"Magnetic","name":"MagneticGrabLength","sentence":"_PARAM0_ magnetic grab length","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getMagneticGrabLength ? Number(beh._getMagneticGrabLength()) || 1000 : 1000;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the near-miss tolerance in scene units for magnetic grab targeting. If the ray hits geometry within this distance of a grabbable's bounding box, that grabbable can be targeted. The closest qualifying grabbable wins. Set to 0 to require a direct ray hit.","fullName":"Set magnetic grab error tolerance","functionType":"Action","group":"Magnetic","name":"SetMagneticGrabErrorTolerance","sentence":"Set magnetic grab error tolerance of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tol = Number(eventsFunctionContext.getArgument('Tolerance'));","if (tol < 0) tol = 0;","var controllers = gdjs._webxrVrControllers || {};","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (!beh) continue;","    if (beh._setMagneticGrabErrorTolerance) beh._setMagneticGrabErrorTolerance(String(tol));","    var hand = beh._getHandedness ? beh._getHandedness() : null;","    var entry = hand ? controllers[hand] : null;","    if (entry) entry._magneticGrabErrorTolerance = tol;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Tolerance in scene units (0 = direct hit only)","name":"Tolerance","type":"expression"}],"objectGroups":[]},{"description":"Near-miss tolerance in scene units for magnetic grab targeting. If the ray hits geometry within this distance of a grabbable's bounding box, that grabbable can be targeted.","fullName":"Magnetic grab error tolerance","functionType":"ExpressionAndCondition","group":"Magnetic","name":"MagneticGrabErrorTolerance","sentence":"_PARAM0_ magnetic grab error tolerance","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getMagneticGrabErrorTolerance ? Number(beh._getMagneticGrabErrorTolerance()) || 0 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns the handedness of this controller (\"left\" or \"right\"). Set via the property editor at initialization.","fullName":"Handedness","functionType":"ExpressionAndCondition","group":"Configuration","name":"Handedness","sentence":"_PARAM0_ handedness","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHandedness ? String(beh._getHandedness()) : 'right';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's X offset from the headset anchor in scene units.","fullName":"Set controller offset X","functionType":"Action","group":"Offset","name":"SetOffsetX","sentence":"Set controller offset X of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setOffsetX) beh._setOffsetX(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Offset X in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller X offset from the headset anchor in scene units","fullName":"Controller offset X","functionType":"ExpressionAndCondition","group":"Offset","name":"OffsetX","sentence":"_PARAM0_ controller offset X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getOffsetX ? Number(beh._getOffsetX()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's Y offset from the headset anchor in scene units.","fullName":"Set controller offset Y","functionType":"Action","group":"Offset","name":"SetOffsetY","sentence":"Set controller offset Y of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setOffsetY) beh._setOffsetY(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Offset Y in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller Y offset from the headset anchor in scene units","fullName":"Controller offset Y","functionType":"ExpressionAndCondition","group":"Offset","name":"OffsetY","sentence":"_PARAM0_ controller offset Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getOffsetY ? Number(beh._getOffsetY()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's Z offset from the headset anchor in scene units.","fullName":"Set controller offset Z","functionType":"Action","group":"Offset","name":"SetOffsetZ","sentence":"Set controller offset Z of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setOffsetZ) beh._setOffsetZ(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Offset Z in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller Z offset from the headset anchor in scene units","fullName":"Controller offset Z","functionType":"ExpressionAndCondition","group":"Offset","name":"OffsetZ","sentence":"_PARAM0_ controller offset Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getOffsetZ ? Number(beh._getOffsetZ()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's fine-tune rotation offset around its local X axis, in degrees, on top of its design-time orientation. Normally only needed for a custom controller model whose default alignment is off.","fullName":"Set controller rotation offset X","functionType":"Action","group":"Rotation Offset","name":"SetRotationOffsetX","sentence":"Set controller rotation offset X of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setRotationOffsetX) beh._setRotationOffsetX(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Rotation offset X in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller fine-tune rotation offset around its local X axis, in degrees","fullName":"Controller rotation offset X","functionType":"ExpressionAndCondition","group":"Rotation Offset","name":"RotationOffsetX","sentence":"_PARAM0_ controller rotation offset X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getRotationOffsetX ? Number(beh._getRotationOffsetX()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's fine-tune rotation offset around its local Y axis, in degrees, on top of its design-time orientation. Normally only needed for a custom controller model whose default alignment is off.","fullName":"Set controller rotation offset Y","functionType":"Action","group":"Rotation Offset","name":"SetRotationOffsetY","sentence":"Set controller rotation offset Y of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setRotationOffsetY) beh._setRotationOffsetY(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Rotation offset Y in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller fine-tune rotation offset around its local Y axis, in degrees","fullName":"Controller rotation offset Y","functionType":"ExpressionAndCondition","group":"Rotation Offset","name":"RotationOffsetY","sentence":"_PARAM0_ controller rotation offset Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getRotationOffsetY ? Number(beh._getRotationOffsetY()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Set the controller's fine-tune rotation offset around its local Z axis, in degrees, on top of its design-time orientation. Normally only needed for a custom controller model whose default alignment is off.","fullName":"Set controller rotation offset Z","functionType":"Action","group":"Rotation Offset","name":"SetRotationOffsetZ","sentence":"Set controller rotation offset Z of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setRotationOffsetZ) beh._setRotationOffsetZ(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"},{"description":"Rotation offset Z in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Controller fine-tune rotation offset around its local Z axis, in degrees","fullName":"Controller rotation offset Z","functionType":"ExpressionAndCondition","group":"Rotation Offset","name":"RotationOffsetZ","sentence":"_PARAM0_ controller rotation offset Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getRotationOffsetZ ? Number(beh._getRotationOffsetZ()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Calibrates the controller's Rotation Offset so its model matches the real controller's current physical orientation. Hold the controller level, pointing straight forward as you would naturally grip it, then trigger this action once. Only needed for a custom controller model whose default alignment is off; the standard controller model does not need this. Requires the controller to be actively tracked (connected); does nothing otherwise.","fullName":"Calibrate controller rotation","functionType":"Action","group":"Rotation Offset","name":"CalibrateRotation","sentence":"Calibrate rotation of _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    var deg = gdjs._webxrSolveRotationOffsetDegrees ? gdjs._webxrSolveRotationOffsetDegrees(beh) : null;","    if (!deg) continue;","    if (beh._setRotationOffsetX) beh._setRotationOffsetX(String(deg.x));","    if (beh._setRotationOffsetY) beh._setRotationOffsetY(String(deg.y));","    if (beh._setRotationOffsetZ) beh._setRotationOffsetZ(String(deg.z));","    gdjs._webxrVrDbg('CalibrateRotation', beh._getHandedness ? beh._getHandedness() : '?', 'RotationOffsetX/Y/Z =', deg.x.toFixed(2), deg.y.toFixed(2), deg.z.toFixed(2));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns a short live preview of the Rotation Offset that CalibrateRotation would set right now, as a compact string (e.g. \"L 12.3,-4.5,90.0\" for handedness, X, Y, Z in degrees) - handy for showing on a 3D Text object next to the controller so you can read calibration values with no cable or console attached. Hold the controller in the reference pose and read the number directly; trigger CalibrateRotation once it looks stable to store it. Returns \"not tracked\" if the controller isn't currently connected.","fullName":"Calibration preview","functionType":"ExpressionAndCondition","group":"Rotation Offset","name":"CalibrationPreview","sentence":"_PARAM0_ calibration preview","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var deg = (beh && gdjs._webxrSolveRotationOffsetDegrees) ? gdjs._webxrSolveRotationOffsetDegrees(beh) : null;","if (!deg) {","    eventsFunctionContext.returnValue = 'not tracked';","} else {","    var h = beh._getHandedness ? beh._getHandedness() : '?';","    var hc = h === 'left' ? 'L' : (h === 'right' ? 'R' : '?');","    eventsFunctionContext.returnValue = hc + ' ' + deg.x.toFixed(1) + ',' + deg.y.toFixed(1) + ',' + deg.z.toFixed(1);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if the laser pointer beam is currently enabled, 0 if it is hidden. As a condition, checks whether the laser is enabled.","fullName":"Laser pointer enabled","functionType":"ExpressionAndCondition","group":"Laser","name":"LaserEnabled","sentence":"_PARAM0_ laser pointer enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getLaserEnabled ? beh._getLaserEnabled() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if magnetic grab is enabled in the property configuration, 0 if disabled. Use IsMagneticGrabActive to check the current runtime state.","fullName":"Magnetic grab enabled (property)","functionType":"ExpressionAndCondition","group":"Magnetic","name":"MagneticGrabEnabled","sentence":"_PARAM0_ magnetic grab enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getMagneticGrabEnabled ? beh._getMagneticGrabEnabled() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrController","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"doStepPreEvents"},{"functionName":"doStepPostEvents"},{"functionName":"onDestroy"},{"folderName":"Input","children":[{"functionName":"IsConnected"},{"functionName":"IsTriggerPressed"},{"functionName":"IsTriggerJustPressed"},{"functionName":"IsTriggerJustReleased"},{"functionName":"IsGripPressed"},{"functionName":"IsGripJustPressed"},{"functionName":"IsGripJustReleased"},{"functionName":"IsPrimaryButtonPressed"},{"functionName":"IsPrimaryButtonJustPressed"},{"functionName":"IsPrimaryButtonJustReleased"},{"functionName":"IsSecondaryButtonPressed"},{"functionName":"IsSecondaryButtonJustPressed"},{"functionName":"IsSecondaryButtonJustReleased"},{"functionName":"IsMenuButtonPressed"},{"functionName":"IsMenuButtonJustPressed"},{"functionName":"IsThumbstickPressed"},{"functionName":"IsThumbstickJustPressed"},{"functionName":"IsThumbstickJustReleased"},{"functionName":"JoyX"},{"functionName":"JoyY"},{"functionName":"TriggerValue"},{"functionName":"GripValue"},{"functionName":"VibrateJoystick"}]},{"folderName":"Tracking","children":[{"functionName":"VelocityX"},{"functionName":"VelocityY"},{"functionName":"VelocityZ"},{"functionName":"AngularVelocityX"},{"functionName":"AngularVelocityY"},{"functionName":"AngularVelocityZ"},{"functionName":"SwingSpeed"},{"functionName":"StabSpeed"},{"functionName":"RotationX"},{"functionName":"RotationY"},{"functionName":"RotationZ"}]},{"folderName":"Magnetic","children":[{"functionName":"RayDirX"},{"functionName":"RayDirY"},{"functionName":"MagneticGrabEnabled"},{"functionName":"RayDirZ"},{"functionName":"EnableMagneticGrab"},{"functionName":"DisableMagneticGrab"},{"functionName":"IsMagneticGrabActive"},{"functionName":"SetMagneticGrabLength"},{"functionName":"MagneticGrabLength"},{"functionName":"SetMagneticGrabErrorTolerance"},{"functionName":"MagneticGrabErrorTolerance"}]},{"folderName":"Laser","children":[{"functionName":"EnableLaserPointer"},{"functionName":"DisableLaserPointer"},{"functionName":"LaserEnabled"},{"functionName":"SetLaserColor"},{"functionName":"LaserColor"},{"functionName":"SetLaserLength"},{"functionName":"LaserLength"},{"functionName":"SetLaserPitchOffset"},{"functionName":"LaserPitchOffset"},{"functionName":"EnableLaserStopAtGeometry"},{"functionName":"DisableLaserStopAtGeometry"},{"functionName":"LaserStopAtGeometry"},{"functionName":"EnableLaserHitMarker"},{"functionName":"DisableLaserHitMarker"},{"functionName":"LaserHitMarkerEnabled"},{"functionName":"SetLaserHitMarkerSize"},{"functionName":"LaserHitMarkerSize"},{"functionName":"IsLaserHittingGeometry"},{"functionName":"LaserHitDistance"},{"functionName":"LaserHitPointX"},{"functionName":"LaserHitPointY"},{"functionName":"LaserHitPointZ"}]},{"folderName":"Targeting","children":[{"functionName":"SetTargetingRayLength"},{"functionName":"TargetingRayLength"}]},{"folderName":"Configuration","children":[{"functionName":"Handedness"}]},{"folderName":"Offset","children":[{"functionName":"SetOffsetX"},{"functionName":"OffsetX"},{"functionName":"SetOffsetY"},{"functionName":"OffsetY"},{"functionName":"SetOffsetZ"},{"functionName":"OffsetZ"}]},{"folderName":"Rotation Offset","children":[{"functionName":"SetRotationOffsetX"},{"functionName":"RotationOffsetX"},{"functionName":"SetRotationOffsetY"},{"functionName":"RotationOffsetY"},{"functionName":"SetRotationOffsetZ"},{"functionName":"RotationOffsetZ"},{"functionName":"CalibrateRotation"},{"functionName":"CalibrationPreview"}]}]},"propertyDescriptors":[{"value":"right","type":"Choice","label":"Handedness","description":"Which hand this controller tracks","choices":[{"label":"left","value":"left"},{"label":"right","value":"right"}],"name":"Handedness"},{"value":"0","type":"Number","label":"Offset X","description":"Controller-local X offset in scene units (X+ = forward, X- = backward). Shifts the controller model and effective grab point relative to the hardware grip.","name":"OffsetX"},{"value":"0","type":"Number","label":"Offset Y","description":"Controller-local Y offset in scene units (Y+ = right, Y- = left). Shifts the controller model and effective grab point relative to the hardware grip.","name":"OffsetY"},{"value":"0","type":"Number","label":"Offset Z","description":"Controller-local Z offset in scene units (Z+ = up, Z- = down). Shifts the controller model and effective grab point relative to the hardware grip.","name":"OffsetZ"},{"value":"90.85","type":"Number","label":"Rotation offset X","description":"Fine-tune rotation offset in degrees applied around the controller model's local X axis, on top of its design-time orientation. Default is the measured average for the standard Meta Quest 3 GLBs (left/right differ slightly; each controller instance overrides this with its own precise calibrated value). Set via the Calibrate rotation action or by hand for a custom model.","name":"RotationOffsetX"},{"value":"-42.2","type":"Number","label":"Rotation offset Y","description":"Fine-tune rotation offset in degrees applied around the controller model's local Y axis, on top of its design-time orientation. Default is the measured average for the standard Meta Quest 3 GLBs (left/right differ slightly; each controller instance overrides this with its own precise calibrated value). Set via the Calibrate rotation action or by hand for a custom model.","name":"RotationOffsetY"},{"value":"169.05","type":"Number","label":"Rotation offset Z","description":"Fine-tune rotation offset in degrees applied around the controller model's local Z axis, on top of its design-time orientation. Default is the measured average for the standard Meta Quest 3 GLBs (left/right differ slightly; each controller instance overrides this with its own precise calibrated value). Set via the Calibrate rotation action or by hand for a custom model.","name":"RotationOffsetZ"},{"value":"false","type":"Boolean","label":"Laser enabled","description":"Show a debug laser beam from the controller grip forward","name":"LaserEnabled"},{"value":"255;0;0","type":"Color","label":"Laser color","description":"Laser beam color (R;G;B)","name":"LaserColor"},{"value":"5000","type":"Number","label":"Laser length","description":"Visual length of the laser beam in scene units. Applied when the laser is first enabled.","name":"LaserLength"},{"value":"0","type":"Number","label":"Targeting ray length","description":"Max distance the controller targeting ray reaches when detecting VrTargetable objects, in scene units. Set to 0 to inherit Laser length. The targeting ray is always cast, independent of the laser beam, so VrTargetable objects can be targeted even when the laser is hidden.","name":"TargetingRayLength"},{"value":"0","type":"Number","label":"Laser pitch offset","description":"Pitch offset in degrees applied to the laser beam direction. Positive tilts down, negative tilts up. Use to fine-tune aim if the target ray space does not match hardware expectations.","name":"LaserPitchOffset"},{"value":"true","type":"Boolean","label":"Laser stops at geometry","description":"When enabled, the laser beam clips at the first scene geometry it hits instead of drawing its full configured length. Disable to restore pass-through behavior.","name":"LaserStopAtGeometry"},{"value":"true","type":"Boolean","label":"Laser hit marker enabled","description":"Show a small sphere at the point where the laser hits geometry, colored to match the laser beam. Only visible when the laser is enabled and hitting something.","name":"LaserHitMarkerEnabled"},{"value":"5","type":"Number","label":"Laser hit marker size","description":"Radius of the hit marker sphere in scene units. Default 5 works well when laser length is around 5000 units.","name":"LaserHitMarkerSize"},{"value":"false","type":"Boolean","label":"Magnetic grab enabled","description":"Enable magnetic ray targeting (e.g. disable and re-enable when player picks up magnetic gloves). Off by default since 0.29.0: turn this on for controllers that should be able to magnetically target VrGrabbable/VrSelectable objects.","name":"MagneticGrabEnabled"},{"value":"1000","type":"Number","label":"Magnetic grab length","description":"Maximum reach in scene units of the controller's forward ray for magnetic grab targeting and selection.","name":"MagneticGrabLength"},{"value":"5","type":"Number","label":"Magnetic grab error tolerance","description":"If the ray hits geometry near a magnetic-grabbable (within this distance in scene units from the object's bounding box), target the closest qualifying grabbable. Set to 0 to require a direct ray hit.","name":"MagneticGrabErrorTolerance"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"Handedness"},{"propertyName":"OffsetX"},{"propertyName":"OffsetY"},{"propertyName":"OffsetZ"},{"propertyName":"RotationOffsetX"},{"propertyName":"RotationOffsetY"},{"propertyName":"RotationOffsetZ"},{"propertyName":"LaserEnabled"},{"propertyName":"LaserColor"},{"propertyName":"LaserLength"},{"propertyName":"TargetingRayLength"},{"propertyName":"LaserPitchOffset"},{"propertyName":"LaserStopAtGeometry"},{"propertyName":"LaserHitMarkerEnabled"},{"propertyName":"LaserHitMarkerSize"},{"propertyName":"MagneticGrabEnabled"},{"propertyName":"MagneticGrabLength"},{"propertyName":"MagneticGrabErrorTolerance"}]}},{"description":"Make objects grabbable and throwable by VR controllers. Supports proximity grab (grip button near object), throwing with momentum transfer on release, and magnetic attraction via controller laser ray. Requires Physics3D behavior with Dynamic body type.","fullName":"VR Grabbable (WebXR)","helpPath":"","iconUrl":"","name":"VrGrabbable","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","if (!gdjs._webxrVrGrabbableRegistry) gdjs._webxrVrGrabbableRegistry = [];","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    beh._state = 'idle';","    beh._grabbingHand = null;","    beh._grabOffset = {x:0,y:0,z:0};","    beh._flyTimer = 0;","    beh._origGravScale = 1;","    beh._targetingHand = null;","    beh._otherHoldingHand = null;","    beh._holsterEntry = null;","    gdjs._webxrVrGrabbableRegistry.push({obj: obj, beh: beh});","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDestroy","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    if (gdjs._webxrVrGrabbableRegistry) {","        gdjs._webxrVrGrabbableRegistry = gdjs._webxrVrGrabbableRegistry.filter(function(e){ return e.obj !== obj; });","    }","    if (beh._holsterEntry) { beh._holsterEntry.occupant = null; beh._holsterEntry = null; }","    if (beh._state === 'grabbed' || beh._state === 'targeted' || beh._state === 'flyingToCtrl') {","        var phys = null;","        try { phys = obj.getBehavior('Physics3D'); } catch(e) {}","        if (phys && typeof phys.gravityScale === 'number') {","            phys.setGravityScale(beh._origGravScale);","            if (phys._body && typeof Jolt !== 'undefined') {","                var _fBi = phys._sharedData.bodyInterface;","                var _fId = phys._body.GetID();","                var _fMt = (beh._origJoltMotionType !== undefined) ? beh._origJoltMotionType : Jolt.EMotionType_Dynamic;","                _fBi.SetMotionType(_fId, _fMt, Jolt.EActivation_Activate);","                beh._origJoltMotionType = undefined;","                _fBi.SetLinearVelocity(_fId, phys.getVec3(0, 0, 0));","                _fBi.SetAngularVelocity(_fId, phys.getVec3(0, 0, 0));","                _fBi.ActivateBody(_fId);","            }","        }","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var anchor = gdjs._webxrVrAnchor;","if (!anchor) return;","var dt = runtimeScene.getTimeManager().getElapsedTime() / 1000;","gdjs._webxrRtSceneRef = runtimeScene;","if (typeof gdjs._webxrDebugThrow === 'undefined') gdjs._webxrDebugThrow = true;","if (!gdjs._webxrDebugLines) gdjs._webxrDebugLines = {};","if (!gdjs._webxrDbgFn) {","    gdjs._webxrDbgFn = function(key, text) {","        if (!gdjs._webxrDebugThrow || !gdjs._webxrRtSceneRef) return;","        gdjs._webxrDebugLines[key] = text;","        var _o=['track.L','track.R','throw.enter','throw.cond','throw','throw.hist','throw.rb','throw.post','launch','launch.rb'];","        var _s = [];","        for (var _i = 0; _i < _o.length; _i++) {","            if (gdjs._webxrDebugLines[_o[_i]]) _s.push(gdjs._webxrDebugLines[_o[_i]]);","        }","        try { gdjs._webxrRtSceneRef.getGame().getVariables().get('VrDebug').setString(_s.join('\\n')); } catch(e) {}","    };","}","if (!gdjs._webxrThrowVelFromHistory) {","    gdjs._webxrThrowVelFromHistory = function(vh, now, windowMs) {","        if (!vh || vh.length === 0) return {x:0, y:0, z:0, n:0};","        var _pk = null, _pkSq = -1, _pkT = 0;","        for (var _ti = 0; _ti < vh.length; _ti++) {","            var _age = now - vh[_ti].t;","            if (_age < 20 || _age > windowMs) continue;","            var _s = vh[_ti].vx*vh[_ti].vx + vh[_ti].vy*vh[_ti].vy + vh[_ti].vz*vh[_ti].vz;","            if (_s > _pkSq) { _pkSq = _s; _pk = vh[_ti]; _pkT = vh[_ti].t; }","        }","        if (!_pk) {","            var _sx=0,_sy=0,_sz=0,_n=0;","            for (var _tj = vh.length - 1; _tj >= 0 && _n < 3; _tj--) {","                if (now - vh[_tj].t < 20) continue;","                _sx += vh[_tj].vx; _sy += vh[_tj].vy; _sz += vh[_tj].vz; _n++;","            }","            return _n > 0 ? {x:_sx/_n, y:_sy/_n, z:_sz/_n, n:_n} : {x:0, y:0, z:0, n:0};","        }","        var _half = 45;","        var _ax=0,_ay=0,_az=0,_an=0;","        for (var _tk = 0; _tk < vh.length; _tk++) {","            if (Math.abs(vh[_tk].t - _pkT) > _half) continue;","            if (now - vh[_tk].t < 20) continue;","            _ax += vh[_tk].vx; _ay += vh[_tk].vy; _az += vh[_tk].vz; _an++;","        }","        if (_an === 0) return {x:_pk.vx, y:_pk.vy, z:_pk.vz, n:1};","        return {x:_ax/_an, y:_ay/_an, z:_az/_an, n:_an};","    };","}","","// Helper: get gamepad for a hand","function _getGamepad(hand) {","    var sess = tr.xr.getSession ? tr.xr.getSession() : null;","    if (!sess || !sess.inputSources) return null;","    for (var si = 0; si < sess.inputSources.length; si++) {","        var src = sess.inputSources[si];","        if (src.handedness === hand && src.gamepad) return src.gamepad;","    }","    return null;","}","","// Helper: get controller GDevelop position (uses VrController offset if set)","function _ctrlPos(hand) {","    var entry = controllers[hand];","    if (!entry || !entry.grip || !entry.connected) return null;","    var wp = entry._adjustedWP ? entry._adjustedWP.clone() : new THREE.Vector3();","    if (!entry._adjustedWP) entry.grip.getWorldPosition(wp);","    return { x: anchor.x + (wp.x - anchor.threeX), y: anchor.y - (wp.y - anchor.threeY), z: anchor.z + (wp.z - anchor.threeZ) };","}","","// True world-space AABB in GDevelop scene coords. Mirrors VrClimbable (webxr.json:9778):","// ensureUpToDate + Box3.setFromObject handles GLB pivot (ModelOrigin), fit-scale, and rotation.","// Y-flip: Three Y -> scene Y is negated. Falls back to getWidth box if model not yet loaded.","function _grabbableWorldAabb(obj) {","    var three = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","    var rend  = obj.getRenderer ? obj.getRenderer() : null;","    if (rend && rend.ensureUpToDate) rend.ensureUpToDate();","    if (three && typeof THREE !== 'undefined') {","        var b = new THREE.Box3().setFromObject(three);","        if (!b.isEmpty() && isFinite(b.min.x) && isFinite(b.max.x)) {","            return { minX: b.min.x, maxX: b.max.x,","                     minY: -b.max.y, maxY: -b.min.y,","                     minZ: b.min.z, maxZ: b.max.z };","        }","    }","    var hw = (obj.getWidth  ? obj.getWidth()  : 0) / 2;","    var hh = (obj.getHeight ? obj.getHeight() : 0) / 2;","    var hd = (obj.getDepth  ? obj.getDepth()  : 0) / 2;","    return { minX: obj.getX()-hw, maxX: obj.getX()+hw,","             minY: obj.getY()-hh, maxY: obj.getY()+hh,","             minZ: obj.getZ()-hd, maxZ: obj.getZ()+hd };","}","// Nearest distance (scene units) from a scene-space point to the object's world AABB. 0 when inside.","function _grabbableAabbDist(obj, cp) {","    if (!cp) return Infinity;","    var a = _grabbableWorldAabb(obj);","    var qx = Math.max(a.minX, Math.min(cp.x, a.maxX));","    var qy = Math.max(a.minY, Math.min(cp.y, a.maxY));","    var qz = Math.max(a.minZ, Math.min(cp.z, a.maxZ));","    var dx = cp.x-qx, dy = cp.y-qy, dz = cp.z-qz;","    return Math.sqrt(dx*dx + dy*dy + dz*dz);","}","","// Helper: disable physics gravity + zero velocity","function _disablePhysicsGravity(phys) {","    if (!phys || !phys._body || typeof Jolt === 'undefined') return;","    var bi = phys._sharedData.bodyInterface;","    var id = phys._body.GetID();","    phys.setGravityScale(0);","    bi.SetLinearVelocity(id, phys.getVec3(0, 0, 0));","    bi.SetAngularVelocity(id, phys.getVec3(0, 0, 0));","    bi.ActivateBody(id);","}","","// Helper: restore physics gravity","function _restorePhysicsGravity(phys, gravScale) {","    if (!phys || !phys._body || typeof Jolt === 'undefined') return;","    phys.setGravityScale(gravScale);","    phys._sharedData.bodyInterface.ActivateBody(phys._body.GetID());","}","","// Global helper: restore physics on a grabbed object (called from VrArrow fire path)","gdjs._webxrVrGrabbableRestorePhysics = function(obj) {","    var _rReg = gdjs._webxrVrGrabbableRegistry;","    if (!_rReg) return;","    for (var _rri = 0; _rri < _rReg.length; _rri++) {","        if (_rReg[_rri].obj !== obj) continue;","        var _rBeh = _rReg[_rri].beh;","        var _rPhys = null;","        try { _rPhys = obj.getBehavior('Physics3D'); } catch(e) {}","        if (_rPhys) {","            _restoreBodyMotionType(_rBeh, _rPhys);","            _restorePhysicsGravity(_rPhys, _rBeh._origGravScale != null ? _rBeh._origGravScale : 1);","        }","        break;","    }","};","","// Helper: switch body to Kinematic while grabbed so Jolt never integrates the held pose","function _makeBodyKinematic(beh, phys) {","    if (!phys || !phys._body || typeof Jolt === 'undefined') return;","    var origType = phys.bodyType || 'Dynamic';","    beh._origJoltMotionType = origType === 'Kinematic' ? Jolt.EMotionType_Kinematic :","                             origType === 'Static'    ? Jolt.EMotionType_Static :","                                                        Jolt.EMotionType_Dynamic;","    phys._sharedData.bodyInterface.SetMotionType(phys._body.GetID(), Jolt.EMotionType_Kinematic, Jolt.EActivation_Activate);","}","","// Helper: restore original motion type on release","function _restoreBodyMotionType(beh, phys) {","    if (!phys || !phys._body || typeof Jolt === 'undefined') return;","    var mt = (beh._origJoltMotionType !== undefined) ? beh._origJoltMotionType : Jolt.EMotionType_Dynamic;","    phys._sharedData.bodyInterface.SetMotionType(phys._body.GetID(), mt, Jolt.EActivation_Activate);","    beh._origJoltMotionType = undefined;","}","","// MagneticGrabEnabled on this behavior: re-read via getter every frame. Missing getter => OFF (default since 0.29.0). Only explicit true-like values enable magnetic targeting.","function _webxrReadGrabbableMagneticEnabled(b) {","    if (!b || !b._getMagneticGrabEnabled) return false;","    var v = b._getMagneticGrabEnabled();","    if (v === false || v === 'false' || v === 'False' || v === 0 || v === '0') return false;","    return true;","}","","function _webxrGrabbableHitDistanceToAabb(hits, obj, anchor) {","    if (!hits || hits.length === 0) return Infinity;","    var hp = hits[0].point;","    var cp = { x: anchor.x + (hp.x - anchor.threeX),","               y: anchor.y - (hp.y - anchor.threeY),","               z: anchor.z + (hp.z - anchor.threeZ) };","    return _grabbableAabbDist(obj, cp);","}","// Magnetic aim: each shared-ray hit already carries the GDevelop object that","// owns it (resolved once by the physics or triangle pass), so a direct hit is","// a plain identity check instead of a per-hit Three.js parent-chain walk.","function _webxrGrabbableMagneticRayHitsObject(hits, obj, anchor) {","    if (!hits || hits.length === 0) return false;","    for (var _hii = 0; _hii < hits.length; _hii++) {","        if (hits[_hii].gdObject === obj) return true;","    }","    return false;","}","","// Debug: ray vs AABB metrics. Set gdjs._webxrDebugMagneticGrabProp = true (logs GrabbableMagneticCube by default). Set gdjs._webxrDebugMagneticGrabRay to an object name or 'all'.","function _webxrMagAabbDebugMetrics(hitGx, hitGy, hitGz, obj) {","    var cx = obj.getX();","    var cy = obj.getY();","    var cz = obj.getZ();","    var hw = (obj.getWidth ? obj.getWidth() : 0) / 2;","    var hh = (obj.getHeight ? obj.getHeight() : 0) / 2;","    var hd = (obj.getDepth ? obj.getDepth() : 0) / 2;","    var dxc = hitGx - cx, dyc = hitGy - cy, dzc = hitGz - cz;","    var distCenterToHit = Math.sqrt(dxc * dxc + dyc * dyc + dzc * dzc);","    var qx = Math.max(cx - hw, Math.min(hitGx, cx + hw));","    var qy = Math.max(cy - hh, Math.min(hitGy, cy + hh));","    var qz = Math.max(cz - hd, Math.min(hitGz, cz + hd));","    var distHitToClosestPointOnAabb = Math.sqrt((hitGx - qx) * (hitGx - qx) + (hitGy - qy) * (hitGy - qy) + (hitGz - qz) * (hitGz - qz));","    var inside = hitGx >= cx - hw && hitGx <= cx + hw && hitGy >= cy - hh && hitGy <= cy + hh && hitGz >= cz - hd && hitGz <= cz + hd;","    var marginInsideToNearestFace = inside ? Math.min(hitGx - (cx - hw), cx + hw - hitGx, hitGy - (cy - hh), cy + hh - hitGy, hitGz - (cz - hd), cz + hd - hitGz) : null;","    return {","        distCenterToHit: distCenterToHit,","        oldCenterDistanceRulePassLe20: distCenterToHit <= 20,","        insideObjectAABB: inside,","        distHitToClosestPointOnAabbVolume: distHitToClosestPointOnAabb,","        marginInsideToNearestFace: marginInsideToNearestFace,","        halfExtents: { x: hw, y: hh, z: hd },","        objCenter: { x: cx, y: cy, z: cz },","        hitGDevelop: { x: hitGx, y: hitGy, z: hitGz }","    };","}","","function _captureGrabOffset(beh, obj, handEntry) {","    if (!handEntry || !handEntry.grip) return;","    var threeObj = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","    if (!threeObj) return;","    var gWP = new THREE.Vector3();","    var gWQ = new THREE.Quaternion();","    var _capAnchor = handEntry.handAnchor || handEntry.grip;","    _capAnchor.getWorldPosition(gWP);","    _capAnchor.getWorldQuaternion(gWQ);","    var outerWP = new THREE.Vector3();","    threeObj.getWorldPosition(outerWP);","    beh._grabOuterDeltaX = threeObj.position.x - obj.getX();","    beh._grabOuterDeltaY = threeObj.position.y - obj.getY();","    beh._grabOuterDeltaZ = threeObj.position.z - obj.getZ();","    var oQ = threeObj.quaternion.clone();","    beh._grabWorldQuat = oQ.clone();","    var gWQInv = gWQ.clone().invert();","    beh._grabLocalPos = outerWP.clone().sub(gWP).applyQuaternion(gWQInv);","    var gWQYConj = new THREE.Quaternion(-gWQ.x, gWQ.y, -gWQ.z, gWQ.w);","    var mode = (beh._getGrabMode ? String(beh._getGrabMode()) : 'AABB');","    if (mode === 'Center') {","        var hx = beh._getHoldOffsetX ? Number(beh._getHoldOffsetX()) : 0;","        var hy = beh._getHoldOffsetY ? Number(beh._getHoldOffsetY()) : 0;","        var hz = beh._getHoldOffsetZ ? Number(beh._getHoldOffsetZ()) : 0;","        var rxDeg = beh._getHoldRotationX ? Number(beh._getHoldRotationX()) : 0;","        var ryDeg = beh._getHoldRotationY ? Number(beh._getHoldRotationY()) : 0;","        var rzDeg = beh._getHoldRotationZ ? Number(beh._getHoldRotationZ()) : 0;","        var D2R = Math.PI / 180;","        beh._grabLocalQuat = new THREE.Quaternion().setFromEuler(new THREE.Euler(rxDeg*D2R, ryDeg*D2R, rzDeg*D2R, 'ZYX'));","        // HoldOffset is specified relative to the raw grip. The per-frame update adds the","        // handAnchor's local offset on top, so subtract it back out to keep the final","        // sword position = grip + rotate(q, HoldOffset) as the user configured.","        var _capWs = gdjs._webxrVrWorldScale || 100;","        var _ancOff = (handEntry.handAnchor) ? handEntry.handAnchor.position : {x:0,y:0,z:0};","        beh._grabLocalPosTarget = new THREE.Vector3(","            hx - _ancOff.x * _capWs,","            hy - _ancOff.y * _capWs,","            hz - _ancOff.z * _capWs","        );","    } else {","        beh._grabLocalQuat = gWQYConj.clone().invert().multiply(oQ);","        if (beh._magneticHitWorld) {","            beh._grabLocalPosTarget = new THREE.Vector3(0, 0, 0);","        } else {","            beh._grabLocalPosTarget = beh._grabLocalPos.clone();","        }","    }","    beh._magneticHitWorld = null;","}","","// Global helper: force-grab an idle grabbable into a hand (used by VrGrabbable.ForceRetrieveToHand,","// and also shared with holster-based force-retrieve after zone bookkeeping is done).","gdjs._webxrVrGrabbableBeginForcedGrab = function(obj, beh, handEntry, hand) {","    var phys = null;","    try { phys = obj.getBehavior('Physics3D'); } catch(e) {}","    if (!phys) return false;","    if (beh._origJoltMotionType === undefined) beh._origGravScale = (typeof phys.gravityScale === 'number') ? phys.gravityScale : 1;","    _disablePhysicsGravity(phys);","    _makeBodyKinematic(beh, phys);","    var grip = handEntry.handAnchor || handEntry.grip;","    if (!grip) return false;","    var gWP = new THREE.Vector3(), gWQ = new THREE.Quaternion();","    grip.getWorldPosition(gWP);","    grip.getWorldQuaternion(gWQ);","    var gWQInv = gWQ.clone().invert();","    var threeObj = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","    if (threeObj) {","        beh._grabOuterDeltaX = threeObj.position.x - obj.getX();","        beh._grabOuterDeltaY = threeObj.position.y - obj.getY();","        beh._grabOuterDeltaZ = threeObj.position.z - obj.getZ();","    } else {","        beh._grabOuterDeltaX = beh._grabOuterDeltaY = beh._grabOuterDeltaZ = 0;","    }","    var _zMode = (beh._getGrabMode ? String(beh._getGrabMode()) : 'AABB');","    if (_zMode === 'Center') {","        var _zhx = beh._getHoldOffsetX ? Number(beh._getHoldOffsetX()) : 0;","        var _zhy = beh._getHoldOffsetY ? Number(beh._getHoldOffsetY()) : 0;","        var _zhz = beh._getHoldOffsetZ ? Number(beh._getHoldOffsetZ()) : 0;","        var _zrxD = beh._getHoldRotationX ? Number(beh._getHoldRotationX()) : 0;","        var _zryD = beh._getHoldRotationY ? Number(beh._getHoldRotationY()) : 0;","        var _zrzD = beh._getHoldRotationZ ? Number(beh._getHoldRotationZ()) : 0;","        var _D2R = Math.PI / 180;","        beh._grabLocalQuat = new THREE.Quaternion().setFromEuler(new THREE.Euler(_zrxD*_D2R, _zryD*_D2R, _zrzD*_D2R, 'ZYX'));","        var _zWs = gdjs._webxrVrWorldScale || 100;","        var _zAncOff = handEntry.handAnchor ? handEntry.handAnchor.position : {x:0,y:0,z:0};","        var _zHoldPos = 