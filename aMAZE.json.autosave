pplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hold rotation Y in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Y rotation offset in degrees for the held object (used when GrabMode is Center)","fullName":"Hold rotation Y","functionType":"ExpressionAndCondition","group":"Hold Pose","name":"HoldRotationY","sentence":"_PARAM0_ hold rotation Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHoldRotationY ? Number(beh._getHoldRotationY()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the Z hold rotation offset in degrees (applied when GrabMode is Center). Pitch=, Yaw=, Roll=Z.","fullName":"Set hold rotation Z","functionType":"Action","group":"Hold Pose","name":"SetHoldRotationZ","sentence":"Set hold rotation Z of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHoldRotationZ) beh._setHoldRotationZ(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hold rotation Z in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Z rotation offset in degrees for the held object (used when GrabMode is Center)","fullName":"Hold rotation Z","functionType":"ExpressionAndCondition","group":"Hold Pose","name":"HoldRotationZ","sentence":"_PARAM0_ hold rotation Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHoldRotationZ ? Number(beh._getHoldRotationZ()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if the controller laser ray can target this object for magnetic grab, 0 if disabled. As a condition, checks whether magnetic grab is enabled.","fullName":"Magnetic grab enabled","functionType":"ExpressionAndCondition","group":"Magnetic","name":"MagneticGrabEnabled","sentence":"_PARAM0_ magnetic grab enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getMagneticGrabEnabled ? beh._getMagneticGrabEnabled() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Allow this grabbable to be grabbed with a grip press that stays held until a second press (same as enabling Sticky grab).","fullName":"Enable sticky grab","functionType":"Action","group":"Sticky","name":"EnableStickyGrab","sentence":"Enable sticky grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setStickyGrab) beh._setStickyGrab('true');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Make this grabbable drop as soon as grip is released (same as disabling Sticky grab).","fullName":"Disable sticky grab","functionType":"Action","group":"Sticky","name":"DisableStickyGrab","sentence":"Disable sticky grab on _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setStickyGrab) beh._setStickyGrab('false');","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Returns 1 if sticky grab is enabled on this object (grip press grabs and holds; second press drops), 0 if disabled (grip-hold-to-hold behavior). As a condition, checks whether sticky grab is enabled.","fullName":"Sticky grab enabled","functionType":"ExpressionAndCondition","group":"Sticky","name":"StickyGrabEnabled","sentence":"_PARAM0_ sticky grab enabled","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","var v = beh && beh._getStickyGrab ? beh._getStickyGrab() : 'false';","eventsFunctionContext.returnValue = (v === 'true' || v === true) ? 1 : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Force this idle grabbable directly into the specified hand. If sticky grab is ON the object stays held until the next grip press. If sticky grab is OFF the object attaches but drops immediately with zero throw velocity if grip is not currently held. Only works when the object is idle (not already grabbed or holstered).","fullName":"Force grabbable into hand","functionType":"Action","group":"Force","name":"ForceRetrieveToHand","sentence":"Force _PARAM0_ into _PARAM2_ hand","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var handStr = String(eventsFunctionContext.getArgument(\"Hand\")).toLowerCase();","if (handStr !== 'left' && handStr !== 'right') return;","if (objs.length === 0) return;","var obj = objs[0];","var beh = obj.getBehavior(behaviorName);","if (!beh) return;","if (beh._state && beh._state !== 'idle') return;","if (beh._holsterEntry) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var hEntry = controllers[handStr];","if (!hEntry || !hEntry.connected) return;","if (gdjs._webxrVrGrabbableBeginForcedGrab) {","    gdjs._webxrVrGrabbableBeginForcedGrab(obj, beh, hEntry, handStr);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hand (\"left\" or \"right\")","name":"Hand","type":"string"}],"objectGroups":[]},{"description":"Immediately release this object from the hand holding it without throwing. Restores physics and clears all grab state. Use before transferring the object to another system (e.g. activating VrFollower).","fullName":"Force release from hand","functionType":"Action","group":"Force","name":"ForceRelease","sentence":"Force release _PARAM0_ from hand, keep kinematic: _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var _kk = eventsFunctionContext.getArgument(\"KeepKinematic\");","var _keepK = _kk === true || _kk === 1 || String(_kk) === 'true';","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    if (!_keepK && beh._origJoltMotionType !== undefined) {","        var phys = null;","        try { phys = obj.getBehavior('Physics3D'); } catch(e) {}","        if (phys && phys._body && typeof Jolt !== 'undefined') {","            phys._sharedData.bodyInterface.SetMotionType(phys._body.GetID(), beh._origJoltMotionType, Jolt.EActivation_Activate);","            beh._origJoltMotionType = undefined;","            if (typeof beh._origGravScale === 'number') phys.setGravityScale(beh._origGravScale);","        }","    }","    beh._state = 'idle';","    beh._grabbingHand = null;","    beh._otherHoldingHand = null;","    beh._grabLocalPos = null;","    beh._grabLocalQuat = null;","    beh._grabWorldQuat = null;","    beh._grabOuterDeltaX = null;","    beh._grabOuterDeltaY = null;","    beh._grabOuterDeltaZ = null;","    beh._suppressThrowVelocityOnNextRelease = false;","    beh._noRedockUntil = 0;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"If true, the physics body stays kinematic after release (use when handing off to VrFollower so physics does not fight the follower). If false (default), physics is restored to its original type (use for a normal programmatic drop).","name":"KeepKinematic","type":"yesorno"}],"objectGroups":[]},{"description":"Returns 1 if this object is currently holstered in a VrBodyZones or VrHolster zone, 0 otherwise.","fullName":"Is holstered","functionType":"Condition","group":"Holster","name":"IsHolstered","sentence":"_PARAM0_ is holstered","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._holsterEntry && beh._holsterEntry.occupant);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the tag used to match this grabbable to compatible holster zones. A zone whose AcceptedTags contains this tag (or has empty AcceptedTags) will accept this object. Leave empty to match any zone.","fullName":"Set holster tag","functionType":"Action","group":"Holster","name":"SetHolsterTag","sentence":"Set holster tag of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = String(eventsFunctionContext.getArgument(\"Value\") || '');","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHolsterTag) beh._setHolsterTag(v);","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Holster tag (e.g. \"pistol\", \"sword\")","name":"Value","type":"string"}],"objectGroups":[]},{"description":"Tag used to match this grabbable to compatible holster zones. Zones filter by AcceptedTags; empty tag matches any zone.","fullName":"Holster tag","functionType":"ExpressionAndCondition","group":"Holster","name":"HolsterTag","sentence":"_PARAM0_ holster tag","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHolsterTag ? String(beh._getHolsterTag()) : '';"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"string"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local X offset for the object's origin when holstered (zone forward axis).","fullName":"Set hang offset X","functionType":"Action","group":"Hang Pose","name":"SetHangOffsetX","sentence":"Set hang offset X of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangOffsetX) beh._setHangOffsetX(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang offset X in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local X offset for the object's origin when holstered.","fullName":"Hang offset X","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangOffsetX","sentence":"_PARAM0_ hang offset X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangOffsetX ? Number(beh._getHangOffsetX()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local Y offset for the object's origin when holstered (left/right of zone center).","fullName":"Set hang offset Y","functionType":"Action","group":"Hang Pose","name":"SetHangOffsetY","sentence":"Set hang offset Y of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangOffsetY) beh._setHangOffsetY(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang offset Y in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local Y offset for the object's origin when holstered.","fullName":"Hang offset Y","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangOffsetY","sentence":"_PARAM0_ hang offset Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangOffsetY ? Number(beh._getHangOffsetY()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local Z offset for the object's origin when holstered (up/down).","fullName":"Set hang offset Z","functionType":"Action","group":"Hang Pose","name":"SetHangOffsetZ","sentence":"Set hang offset Z of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangOffsetZ) beh._setHangOffsetZ(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang offset Z in scene units","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local Z offset for the object's origin when holstered.","fullName":"Hang offset Z","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangOffsetZ","sentence":"_PARAM0_ hang offset Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangOffsetZ ? Number(beh._getHangOffsetZ()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local X rotation (pitch) for the object when holstered, in degrees.","fullName":"Set hang rotation X","functionType":"Action","group":"Hang Pose","name":"SetHangRotationX","sentence":"Set hang rotation X of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangRotationX) beh._setHangRotationX(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang rotation X (pitch) in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local X rotation (pitch, degrees) for the object when holstered.","fullName":"Hang rotation X","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangRotationX","sentence":"_PARAM0_ hang rotation X","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangRotationX ? Number(beh._getHangRotationX()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local Y rotation (yaw) for the object when holstered, in degrees.","fullName":"Set hang rotation Y","functionType":"Action","group":"Hang Pose","name":"SetHangRotationY","sentence":"Set hang rotation Y of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangRotationY) beh._setHangRotationY(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang rotation Y (yaw) in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local Y rotation (yaw, degrees) for the object when holstered.","fullName":"Hang rotation Y","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangRotationY","sentence":"_PARAM0_ hang rotation Y","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangRotationY ? Number(beh._getHangRotationY()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]},{"description":"Set the zone-local Z rotation (roll) for the object when holstered, in degrees.","fullName":"Set hang rotation Z","functionType":"Action","group":"Hang Pose","name":"SetHangRotationZ","sentence":"Set hang rotation Z of _PARAM0_ to _PARAM2_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var v = Number(eventsFunctionContext.getArgument(\"Value\"));","for (var i = 0; i < objs.length; i++) {","    var beh = objs[i].getBehavior(behaviorName);","    if (beh && beh._setHangRotationZ) beh._setHangRotationZ(String(v));","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"},{"description":"Hang rotation Z (roll) in degrees","name":"Value","type":"expression"}],"objectGroups":[]},{"description":"Zone-local Z rotation (roll, degrees) for the object when holstered.","fullName":"Hang rotation Z","functionType":"ExpressionAndCondition","group":"Hang Pose","name":"HangRotationZ","sentence":"_PARAM0_ hang rotation Z","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = beh && beh._getHangRotationZ ? Number(beh._getHangRotationZ()) : 0;"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"expressionType":{"type":"expression"},"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrGrabbable","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"onCreated"},{"functionName":"doStepPreEvents"},{"functionName":"doStepPostEvents"},{"functionName":"onDestroy"},{"folderName":"State","children":[{"functionName":"IsGrabbed"},{"functionName":"IsTargeted"},{"functionName":"GrabbingHand"}]},{"folderName":"Magnetic","children":[{"functionName":"EnableMagneticGrab"},{"functionName":"DisableMagneticGrab"},{"functionName":"MagneticGrabEnabled"}]},{"folderName":"Sticky","children":[{"functionName":"EnableStickyGrab"},{"functionName":"DisableStickyGrab"},{"functionName":"StickyGrabEnabled"}]},{"folderName":"Force","children":[{"functionName":"ForceRetrieveToHand"},{"functionName":"ForceRelease"}]},{"folderName":"Grab","children":[{"functionName":"SetGrabMode"},{"functionName":"GrabMode"},{"functionName":"SetGrabRange"},{"functionName":"GrabRange"},{"functionName":"SetThrowScale"},{"functionName":"ThrowScale"}]},{"folderName":"Hold Pose","children":[{"functionName":"SetHoldOffsetX"},{"functionName":"HoldOffsetX"},{"functionName":"SetHoldOffsetY"},{"functionName":"HoldOffsetY"},{"functionName":"SetHoldOffsetZ"},{"functionName":"HoldOffsetZ"},{"functionName":"SetHoldRotationX"},{"functionName":"HoldRotationX"},{"functionName":"SetHoldRotationY"},{"functionName":"HoldRotationY"},{"functionName":"SetHoldRotationZ"},{"functionName":"HoldRotationZ"}]},{"folderName":"Holster","children":[{"functionName":"IsHolstered"},{"functionName":"SetHolsterTag"},{"functionName":"HolsterTag"}]},{"folderName":"Hang Pose","children":[{"functionName":"SetHangOffsetX"},{"functionName":"HangOffsetX"},{"functionName":"SetHangOffsetY"},{"functionName":"HangOffsetY"},{"functionName":"SetHangOffsetZ"},{"functionName":"HangOffsetZ"},{"functionName":"SetHangRotationX"},{"functionName":"HangRotationX"},{"functionName":"SetHangRotationY"},{"functionName":"HangRotationY"},{"functionName":"SetHangRotationZ"},{"functionName":"HangRotationZ"}]}]},"propertyDescriptors":[{"value":"10","type":"Number","label":"Grab range (scene units)","description":"Maximum distance from controller center to object AABB edge for proximity grab","name":"GrabRange"},{"value":"1.5","type":"Number","label":"Throw velocity multiplier","description":"Scales controller velocity when throwing the object on grip release (1 = natural arm speed)","name":"ThrowScale"},{"value":"false","type":"Boolean","label":"Magnetic grab enabled","description":"If enabled, this object can be targeted by a controller's magnetic ray (proximity grab always works regardless). Off by default since 0.29.0.","name":"MagneticGrabEnabled"},{"value":"false","type":"Boolean","label":"Sticky grab","description":"When ON, a grip press grabs the object and it stays held after grip is released. A second grip press drops it (click-to-grab, click-to-drop). When OFF (default), the object drops as soon as grip is released.","name":"StickyGrab"},{"value":"AABB","type":"Choice","label":"Grab mode","description":"How the object attaches when grabbed. AABB: held wherever the controller first touches it (contact point stays at grip). Center: object origin snaps to grip, then Hold Offset/Rotation are applied - use for items with an authored hold pose like a gun handle or sword hilt.","choices":[{"label":"AABB","value":"AABB"},{"label":"Center","value":"Center"}],"name":"GrabMode"},{"value":"0","type":"Number","label":"Hold offset X (controller-local right)","description":"Offset from controller center along its right axis when held","group":"Hold Pose","name":"HoldOffsetX"},{"value":"0","type":"Number","label":"Hold offset Y (controller-local up)","description":"Offset from controller center along its up axis when held","group":"Hold Pose","name":"HoldOffsetY"},{"value":"0","type":"Number","label":"Hold offset Z (controller-local forward)","description":"Offset from controller center along its pointing direction when held. Positive = forward, negative = behind grip.","group":"Hold Pose","name":"HoldOffsetZ"},{"value":"0","type":"Number","label":"Hold rotation X (pitch, degrees)","description":"Additional pitch rotation applied to the object on top of controller orientation","group":"Hold Pose","name":"HoldRotationX"},{"value":"0","type":"Number","label":"Hold rotation Y (yaw, degrees)","description":"Additional yaw rotation applied to the object on top of controller orientation","group":"Hold Pose","name":"HoldRotationY"},{"value":"0","type":"Number","label":"Hold rotation Z (roll, degrees)","description":"Additional roll rotation applied to the object on top of controller orientation","group":"Hold Pose","name":"HoldRotationZ"},{"value":"","type":"String","label":"Holster tag","description":"Tag used to match this grabbable to compatible zones. A zone with matching AcceptedTags (or empty AcceptedTags) will accept this object on release. Leave empty to match any zone.","group":"Holster","advanced":true,"name":"HolsterTag"},{"value":"0","type":"Number","label":"Hang offset X (zone-local forward)","description":"Offset along the zone's forward axis when holstered","group":"Hang Pose","advanced":true,"name":"HangOffsetX"},{"value":"0","type":"Number","label":"Hang offset Y (zone-local left/right)","description":"Offset along the zone's left/right axis when holstered","group":"Hang Pose","advanced":true,"name":"HangOffsetY"},{"value":"0","type":"Number","label":"Hang offset Z (zone-local up)","description":"Offset along the zone's up axis when holstered","group":"Hang Pose","advanced":true,"name":"HangOffsetZ"},{"value":"0","type":"Number","label":"Hang rotation X (pitch, degrees)","description":"Pitch rotation applied to the object when holstered (zone-local)","group":"Hang Pose","advanced":true,"name":"HangRotationX"},{"value":"0","type":"Number","label":"Hang rotation Y (yaw, degrees)","description":"Yaw rotation applied to the object when holstered (zone-local)","group":"Hang Pose","advanced":true,"name":"HangRotationY"},{"value":"0","type":"Number","label":"Hang rotation Z (roll, degrees)","description":"Roll rotation applied to the object when holstered (zone-local)","group":"Hang Pose","advanced":true,"name":"HangRotationZ"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"GrabRange"},{"propertyName":"ThrowScale"},{"propertyName":"MagneticGrabEnabled"},{"propertyName":"StickyGrab"},{"folderName":"Hold Pose","children":[{"propertyName":"HoldOffsetX"},{"propertyName":"HoldOffsetY"},{"propertyName":"HoldOffsetZ"},{"propertyName":"HoldRotationX"},{"propertyName":"HoldRotationY"},{"propertyName":"HoldRotationZ"}]},{"propertyName":"GrabMode"},{"folderName":"Holster","children":[{"propertyName":"HolsterTag"}]},{"folderName":"Hang Pose","children":[{"propertyName":"HangOffsetX"},{"propertyName":"HangOffsetY"},{"propertyName":"HangOffsetZ"},{"propertyName":"HangRotationX"},{"propertyName":"HangRotationY"},{"propertyName":"HangRotationZ"}]}]}},{"description":"Makes a Static or Kinematic physics object climbable. When a controller grips the surface, the player's body moves opposite to hand movement (you pull yourself along). Supports two-hand climbing and riding moving kinematic platforms. Add IsClimbing condition to event sheet to suppress player gravity while anchored.","fullName":"VR Climbable (WebXR)","helpPath":"","iconUrl":"","name":"VrClimbable","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh) continue;","    beh._leftAnchor = null;","    beh._rightAnchor = null;","    beh._prevObjPos = null;","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrClimbable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPreEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var tr = runtimeScene.getGame().getRenderer().getThreeRenderer();","if (!tr || !tr.xr || !tr.xr.isPresenting) return;","var controllers = gdjs._webxrVrControllers;","if (!controllers) return;","var anchor = gdjs._webxrVrAnchor;","if (!anchor) return;","var playerObj = gdjs._webxrVrAnchorObject;","if (!playerObj) return;","var dt = runtimeScene.getTimeManager().getElapsedTime() / 1000;","gdjs._webxrRtSceneRef = runtimeScene;","if (typeof gdjs._webxrDebugThrow === 'undefined') gdjs._webxrDebugThrow = true;","if (!gdjs._webxrDebugLines) gdjs._webxrDebugLines = {};","if (!gdjs._webxrDbgFn) {","    gdjs._webxrDbgFn = function(key, text) {","        if (!gdjs._webxrDebugThrow || !gdjs._webxrRtSceneRef) return;","        gdjs._webxrDebugLines[key] = text;","        var _o=['track.L','track.R','throw.enter','throw.cond','throw','throw.hist','throw.rb','throw.post','launch','launch.rb'];","        var _s = [];","        for (var _i = 0; _i < _o.length; _i++) {","            if (gdjs._webxrDebugLines[_o[_i]]) _s.push(gdjs._webxrDebugLines[_o[_i]]);","        }","        try { gdjs._webxrRtSceneRef.getGame().getVariables().get('VrDebug').setString(_s.join('\\n')); } catch(e) {}","    };","}","if (!gdjs._webxrThrowVelFromHistory) {","    gdjs._webxrThrowVelFromHistory = function(vh, now, windowMs) {","        if (!vh || vh.length === 0) return {x:0, y:0, z:0, n:0};","        var _pk = null, _pkSq = -1, _pkT = 0;","        for (var _ti = 0; _ti < vh.length; _ti++) {","            var _age = now - vh[_ti].t;","            if (_age < 20 || _age > windowMs) continue;","            var _s = vh[_ti].vx*vh[_ti].vx + vh[_ti].vy*vh[_ti].vy + vh[_ti].vz*vh[_ti].vz;","            if (_s > _pkSq) { _pkSq = _s; _pk = vh[_ti]; _pkT = vh[_ti].t; }","        }","        if (!_pk) {","            var _sx=0,_sy=0,_sz=0,_n=0;","            for (var _tj = vh.length - 1; _tj >= 0 && _n < 3; _tj--) {","                if (now - vh[_tj].t < 20) continue;","                _sx += vh[_tj].vx; _sy += vh[_tj].vy; _sz += vh[_tj].vz; _n++;","            }","            return _n > 0 ? {x:_sx/_n, y:_sy/_n, z:_sz/_n, n:_n} : {x:0, y:0, z:0, n:0};","        }","        var _half = 45;","        var _ax=0,_ay=0,_az=0,_an=0;","        for (var _tk = 0; _tk < vh.length; _tk++) {","            if (Math.abs(vh[_tk].t - _pkT) > _half) continue;","            if (now - vh[_tk].t < 20) continue;","            _ax += vh[_tk].vx; _ay += vh[_tk].vy; _az += vh[_tk].vz; _an++;","        }","        if (_an === 0) return {x:_pk.vx, y:_pk.vy, z:_pk.vz, n:1};","        return {x:_ax/_an, y:_ay/_an, z:_az/_an, n:_an};","    };","}","","function _getGamepadClimb(hand) {","    var sess = tr.xr.getSession ? tr.xr.getSession() : null;","    if (!sess || !sess.inputSources) return null;","    for (var si = 0; si < sess.inputSources.length; si++) {","        var src = sess.inputSources[si];","        if (src.handedness === hand && src.gamepad) return src.gamepad;","    }","    return null;","}","","function _ctrlPosClimb(hand) {","    var entry = controllers[hand];","    if (!entry || !entry.grip || !entry.connected) return null;","    var wp = entry._adjustedWP ? entry._adjustedWP.clone() : new THREE.Vector3();","    if (!entry._adjustedWP) entry.grip.getWorldPosition(wp);","    return { x: anchor.x + (wp.x - anchor.threeX), y: anchor.y - (wp.y - anchor.threeY), z: anchor.z + (wp.z - anchor.threeZ) };","}","","if (!gdjs._webxrVrHandIsClimbing) gdjs._webxrVrHandIsClimbing = { left: false, right: false };","gdjs._webxrVrHandIsClimbing.left = false;","gdjs._webxrVrHandIsClimbing.right = false;","for (var i = 0; i < objs.length; i++) {","    var obj = objs[i];","    var beh = obj.getBehavior(behaviorName);","    if (!beh || !beh.activated()) continue;","","    // Track platform movement (for kinematic objects)","    var objNowX = obj.getX(), objNowY = obj.getY(), objNowZ = obj.getZ();","    var platDX = 0, platDY = 0, platDZ = 0;","    var physBeh = null;","    try { physBeh = obj.getBehavior('Physics3D'); } catch(e) {}","    if (physBeh && physBeh._bodyType === 'Kinematic' && beh._prevObjPos) {","        platDX = objNowX - beh._prevObjPos.x;","        platDY = objNowY - beh._prevObjPos.y;","        platDZ = objNowZ - beh._prevObjPos.z;","    }","    beh._prevObjPos = {x: objNowX, y: objNowY, z: objNowZ};","","    // World-space AABB in GDevelop coords - uses Three.js Box3.setFromObject so","    // rotation, GLB pivot, and origin/center settings are all handled correctly.","    var _aabb = null;","    var _climbThree = obj.get3DRendererObject ? obj.get3DRendererObject() : null;","    var _climbRend  = obj.getRenderer ? obj.getRenderer() : null;","    if (_climbRend && _climbRend.ensureUpToDate) _climbRend.ensureUpToDate();","    if (_climbThree && typeof THREE !== 'undefined') {","        var _cb3 = new THREE.Box3().setFromObject(_climbThree);","        if (isFinite(_cb3.min.x) && isFinite(_cb3.max.x)) {","            _aabb = { minX: _cb3.min.x, maxX: _cb3.max.x,","                      minY: -_cb3.max.y, maxY: -_cb3.min.y,","                      minZ: _cb3.min.z, maxZ: _cb3.max.z };","        }","    }","    if (!_aabb) {","        var _chw = (obj.getWidth  ? obj.getWidth()  : 0) / 2;","        var _chh = (obj.getHeight ? obj.getHeight() : 0) / 2;","        var _chd = (obj.getDepth  ? obj.getDepth()  : 0) / 2;","        _aabb = { minX: obj.getX() - _chw, maxX: obj.getX() + _chw,","                  minY: obj.getY() - _chh, maxY: obj.getY() + _chh,","                  minZ: obj.getZ() - _chd, maxZ: obj.getZ() + _chd };","    }","","    beh._isLaunching = false; // reset each frame","    var prevLeft = !!beh._leftAnchor;","    var prevRight = !!beh._rightAnchor;","","    var grabRadius = beh._getGrabRadius ? Number(beh._getGrabRadius()) : 10;","    var hands = ['left', 'right'];","    for (var hi = 0; hi < hands.length; hi++) {","        var hand = hands[hi];","        var entry = controllers[hand];","        if (!entry) continue;","        var gp = _getGamepadClimb(hand);","        var curGrip = gp && gp.buttons[1] ? gp.buttons[1].value > 0.5 : false;","        var climbKey = '_climbPrevGrip_' + obj.id;","        var prevGrip = entry[climbKey] || false;","        entry[climbKey] = curGrip;","        var anchorSlot = (hand === 'left') ? '_leftAnchor' : '_rightAnchor';","        if (curGrip && !prevGrip) {","            var cp = _ctrlPosClimb(hand);","            if (cp) {","                var nearX = Math.max(_aabb.minX, Math.min(cp.x, _aabb.maxX));","                var nearY = Math.max(_aabb.minY, Math.min(cp.y, _aabb.maxY));","                var nearZ = Math.max(_aabb.minZ, Math.min(cp.z, _aabb.maxZ));","                var dd2 = Math.sqrt((cp.x-nearX)*(cp.x-nearX)+(cp.y-nearY)*(cp.y-nearY)+(cp.z-nearZ)*(cp.z-nearZ));","                if (dd2 <= grabRadius) { beh[anchorSlot] = {x: cp.x, y: cp.y, z: cp.z}; }","            }","        }","        if (!curGrip) { beh[anchorSlot] = null; }","        if (beh[anchorSlot]) gdjs._webxrVrHandIsClimbing[hand] = true;","    }","","    var nowLeft = !!beh._leftAnchor;","    var nowRight = !!beh._rightAnchor;","","    // ============ LAUNCH: both hands just released simultaneously ============","    if (prevLeft && prevRight && !nowLeft && !nowRight) {","        var lVh = (controllers.left && controllers.left._velHistory) || [];","        var rVh = (controllers.right && controllers.right._velHistory) || [];","        var ls = beh._getLaunchScale ? Number(beh._getLaunchScale()) : 2;","        var launchNow = performance.now();","        function _weightedAvgVel(vh) { return gdjs._webxrThrowVelFromHistory ? gdjs._webxrThrowVelFromHistory(vh, performance.now(), 200) : {x:0,y:0,z:0}; }","        var lAvg = _weightedAvgVel(lVh);","        var rAvg = _weightedAvgVel(rVh);","        var launchX = ((lAvg.x + rAvg.x) / 2) * ls;","        var launchY = ((lAvg.y + rAvg.y) / 2) * ls;","        var launchZ = ((lAvg.z + rAvg.z) / 2) * ls;","        // Clamp to max plausible speed (2000 units/s = 20 m/s at worldScale 100)","        var launchSpd = Math.sqrt(launchX*launchX + launchY*launchY + launchZ*launchZ);","        if (launchSpd > 2000) { var lsc = 2000/launchSpd; launchX*=lsc; launchY*=lsc; launchZ*=lsc; }","        // Mantle boost: player Z is above climbable top - add horizontal impulse over the ledge","        var climbableTopZ = _aabb.maxZ;","        var mantleBoost = beh._getMantleBoost ? Number(beh._getMantleBoost()) : 300;","        if (mantleBoost > 0 && playerObj.getZ() >= climbableTopZ) {","            // Direction from climbable center to player in GDevelop XY plane","            var _aabbCx = (_aabb.minX + _aabb.maxX) * 0.5;","            var _aabbCy = (_aabb.minY + _aabb.maxY) * 0.5;","            var mdx = playerObj.getX() - _aabbCx;","            var mdy = playerObj.getY() - _aabbCy;","            var mLen = Math.sqrt(mdx*mdx + mdy*mdy);","            if (mLen > 1e-6) { mdx /= mLen; mdy /= mLen; } else {","                var pRad = playerObj.getAngle ? playerObj.getAngle() * Math.PI / 180 : 0;","                mdx = Math.cos(pRad); mdy = Math.sin(pRad);","            }","            launchX += mdx * mantleBoost;","            launchY += mdy * mantleBoost;","        }","        // Store in GDevelop coords for expression accessors","        beh._launchVelX = launchX;","        beh._launchVelY = launchY;","        beh._launchVelZ = launchZ;","        beh._isLaunching = true;","        var playerPhysL = null;","        try { playerPhysL = playerObj.getBehavior('Physics3D'); } catch(e) {}","        if (playerPhysL && playerPhysL._body && typeof Jolt !== 'undefined') {","            gdjs._webxrDbgFn('launch',","                'LNC l=' + lAvg.x.toFixed(0) + ',' + lAvg.y.toFixed(0) + ',' + lAvg.z.toFixed(0) +","                ' r=' + rAvg.x.toFixed(0) + ',' + rAvg.y.toFixed(0) + ',' + rAvg.z.toFixed(0) +","                ' out=' + launchX.toFixed(0) + ',' + launchY.toFixed(0) + ',' + launchZ.toFixed(0));","            var _lBi = playerPhysL._sharedData.bodyInterface;","            var _lId = playerPhysL._body.GetID();","            var _lInv = playerPhysL._sharedData.worldInvScale;","            _lBi.SetLinearVelocity(_lId, playerPhysL.getVec3(launchX * _lInv, launchY * _lInv, launchZ * _lInv));","            _lBi.ActivateBody(_lId);","            try {","                var _rvL = playerPhysL._body.GetLinearVelocity();","                var _lWsc = playerPhysL._sharedData.worldScale;","                gdjs._webxrDbgFn('launch.rb', 'LRB set=' + launchX.toFixed(0) + ',' + launchY.toFixed(0) + ',' + launchZ.toFixed(0) + ' got=' + (_rvL.GetX()*_lWsc).toFixed(0) + ',' + (_rvL.GetY()*_lWsc).toFixed(0) + ',' + (_rvL.GetZ()*_lWsc).toFixed(0));","            } catch(e) { gdjs._webxrDbgFn('launch.rb', 'LRB err'); }","        }","        continue; // skip the movement+velocity-zero block","    }","","    if (!nowLeft && !nowRight) continue; // nothing anchored, fall normally","","    // Compute movement from anchored hands","    var moveX = 0, moveY = 0, moveZ = 0, moveCount = 0;","    var anchorsToUpdate = [];","    for (var hi2 = 0; hi2 < hands.length; hi2++) {","        var hand2 = hands[hi2];","        var aSlot = (hand2 === 'left') ? '_leftAnchor' : '_rightAnchor';","        if (!beh[aSlot]) continue;","        var cp2 = _ctrlPosClimb(hand2);","        if (!cp2) continue;","        moveX += beh[aSlot].x - cp2.x;","        moveY += beh[aSlot].y - cp2.y;","        moveZ += beh[aSlot].z - cp2.z;","        moveCount++;","        anchorsToUpdate.push({slot: aSlot, x: cp2.x, y: cp2.y, z: cp2.z});","    }","    if (moveCount > 0) { moveX /= moveCount; moveY /= moveCount; moveZ /= moveCount; }","    for (var ai = 0; ai < anchorsToUpdate.length; ai++) {","        var au = anchorsToUpdate[ai];","        beh[au.slot] = {x: au.x + moveX, y: au.y + moveY, z: au.z + moveZ};","    }","","    // Apply movement to player via Bullet body teleport","    var newX = playerObj.getX() + moveX + platDX;","    var newY = playerObj.getY() + moveY + platDY;","    var newZ = playerObj.getZ() + moveZ + platDZ;","    playerObj.setX(newX); playerObj.setY(newY); playerObj.setZ(newZ);","    var playerPhys = null;","    try { playerPhys = playerObj.getBehavior('Physics3D'); } catch(e) {}","    if (playerPhys && playerPhys._body && typeof Jolt !== 'undefined') {","        var _pBi = playerPhys._sharedData.bodyInterface;","        var _pId = playerPhys._body.GetID();","        var _pInv = playerPhys._sharedData.worldInvScale;","        var _pCurQ = playerPhys._body.GetRotation();","        var _pRvec = playerPhys.getRVec3(newX * _pInv, newY * _pInv, newZ * _pInv);","        var _pQuat = playerPhys.getQuat(_pCurQ.GetX(), _pCurQ.GetY(), _pCurQ.GetZ(), _pCurQ.GetW());","        _pBi.SetPositionAndRotation(_pId, _pRvec, _pQuat, Jolt.EActivation_Activate);","        _pBi.SetLinearVelocity(_pId, playerPhys.getVec3(0, 0, 0));","        _pBi.SetAngularVelocity(_pId, playerPhys.getVec3(0, 0, 0));","    }","}"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrClimbable","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"doStepPostEvents","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":"","parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrClimbable","type":"behavior"}],"objectGroups":[]},{"description":"Check if the player is currently climbing this object (at least one hand anchored)","fullName":"Is climbing","functionType":"Condition","group":"State","name":"IsClimbing","sentence":"Player is climbing _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && (beh._leftAnchor || beh._rightAnchor));"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrClimbable","type":"behavior"}],"objectGroups":[]},{"description":"Check if the left hand is currently anchored to this surface","fullName":"Left hand anchored","functionType":"Condition","group":"State","name":"IsLeftHandAnchored","sentence":"Left hand is anchored to _PARAM0_","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var objs = eventsFunctionContext.getObjects(\"Object\");","var behaviorName = eventsFunctionContext.getBehaviorName(\"Behavior\");","var beh = objs.length > 0 ? objs[0].getBehavior(behaviorName) : null;","eventsFunctionContext.returnValue = !!(beh && beh._leftAnchor);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"WebXR::VrClimbable","type":"behavior"}],"objectGroups":[]},{"description":"Check if the right hand is currently anchored to this surface","fullName":"Right hand anchored","functi