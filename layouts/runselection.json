      },
      "comment": "Saved runs: one line per run (newest first) is created when the scene starts. NEW RUN goes to the character selection."
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": {
            "value": "SceneJustBegins"
          },
          "parameters": [
            ""
          ]
        }
      ],
      "actions": [
        {
          "type": {
            "value": "PlayerInput::MenuSelect"
          },
          "parameters": [
            "",
            "\"runs\"",
            "0",
            ""
          ]
        },
        {
          "type": {
            "value": "SetStringVariable"
          },
          "parameters": [
            "GameMode",
            "=",
            "\"run\""
          ]
        }
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const G = gdjs.amazeUpg;",
            "const runs = G ? G.sortedRuns() : [];",
            "const n = runs.length;",
            "const sp = Math.max(30, Math.min(60, 380 / (n + 1)));   // many runs: the lines get closer together",
            "const size = Math.round(sp * 0.62);",
            "runs.forEach((r, i) => {",
            "    const o = runtimeScene.createObject('RunSlotText');",
            "    if (!o) return;",
            "    o.setLayer('UI');",
            "    o.setPosition(74, 254 + sp * i);",
            "    o.setText(G.runField(r.id, 'title'));",
            "    o.setCharacterSize(size);",
            "    o.getVariables().get('Index').setNumber(i + 1);",
            "    o.getVariables().get('RunId').setString(r.id);",
            "});",
            "const back = runtimeScene.getObjects('BackText')[0];",
            "if (back) back.setY(254 + sp * n + 20);"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ]
    },
