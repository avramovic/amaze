    {
      "type": "BuiltinCommonInstructions::JsCode",
      "inlineCode": [
        "//const o = eventsFunctionContext.getObjects(\"Object\")[0];",
        "const o = objects[0];",
        "  if (!o) return;",
        "",
        "  const norm = (s) => String(s).replace(/[^A-Za-z0-9]/g, '');                                                                                                                                                                           ",
        "  const target = norm(\"Pistol\"); // ime noda pistolja u modelu",
        "",
        "  // Model se učitava asinhrono, pa se čvor traži dok ne postoji",
        "  let gun = o.__gunNode;",
        "  const root = o.get3DRendererObject();",
        "  const attached = (n) => { for (let p = n; p; p = p.parent) if (p === root) return true; return false; };",
        "  if (!gun || !attached(gun)) {",
        "    gun = null;",
        "    if (root && root.traverse) root.traverse((n) => { if (!gun && norm(n.name) === target) gun = n; });",
        "    o.__gunNode = gun;",
        "  }",
        "  if (gun && gun.visible) gun.visible = false;"
      ],
      "parameterObjects": "Astronaut_Fernando_The_Flamingo",
      "useStrict": true,
      "eventsSheetExpanded": false
    }
