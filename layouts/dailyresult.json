      "comment": "Result of the daily challenge. The time goes to the leaderboard when DailyLeaderboardId is set; the best time and the attempts stay on this machine."
    },
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [
        {
          "type": {
            "value": "SceneJustBegins"
          },
          "parameters": [
            ""
          ]
        }
      ],
      "actions": [
        {
          "type": {
            "value": "PlayerInput::MenuSelect"
          },
          "parameters": [
            "",
            "\"daily\"",
            "1",
            ""
          ]
        }
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const G = gdjs.amazeUpg;",
            "const game = runtimeScene.getGame();",
            "const gv = game.getVariables();",
            "const date = G.dailyDate(game);",
            "const time = gv.get('DailyTime').getAsNumber();",
            "const id = String(gv.get('DailyLeaderboardId').getAsString() || '');",
            "const name = G.playerName();",
            "const best = G.dailyBestOf(date);",
            "const set = (n, t) => runtimeScene.getObjects(n).forEach((o) => o.setText(t));",
            "set('DateText', date + '  (UTC)');",
            "set('TimeText', 'TIME  ' + G.formatTime(time));",
            "set('BestText', 'BEST  ' + G.formatTime(best) + (time > 0 && Math.abs(time - best) < 1e-6 ? '   NEW BEST!' : ''));",
            "set('AttemptsText', 'ATTEMPTS  ' + G.dailyAttemptsOf(date));",
            "runtimeScene.getObjects('LeaderboardText').forEach((o) => o.getVariables().get('Enabled').setNumber(id ? 1 : 0));",
            "const L = gdjs.evtTools && gdjs.evtTools.leaderboards;",
            "if (!id) set('StatusText', 'LEADERBOARD NOT SET UP');",
            "else if (!L || !(time > 0)) set('StatusText', '');",
            "else {",
            "    try { L.savePlayerScore(runtimeScene, id, time, name); set('StatusText', 'SCORE SENT AS ' + name); }",
            "    catch (e) { console.warn('[Daily] leaderboard', e); set('StatusText', 'COULD NOT SEND THE SCORE'); }",
            "}"
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": false
        }
      ]
    },
