          "inlineCode": [
            "const id = String(runtimeScene.getGame().getVariables().get('DailyLeaderboardId').getAsString() || '');",
            "const L = gdjs.evtTools && gdjs.evtTools.leaderboards;",
            "let ok = false;",
            "try { if (L && id) { L.displayLeaderboard(runtimeScene, id, true); ok = true; } } catch (e) { console.warn('[Daily] leaderboard', e); }",
            "if (!ok) runtimeScene.getVariables().get('BoardOpen').setBoolean(false);"
          ],
